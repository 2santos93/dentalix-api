DATABASE_URL="postgresql://dentalix_app:changeme@localhost:5442/dentalix?schema=public"
DIRECT_URL="postgresql://dentalix:changeme@localhost:5442/dentalix?schema=public"
# Secretos JWT: OBLIGATORIOS, de 32+ caracteres y DISTINTOS entre sí. La API no
# arranca si faltan, son cortos, coinciden o son valores de ejemplo
# (change-me...). Genera cada uno con:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"
EXCHANGE_APP_ID=""
EXCHANGE_BASE_URL="https://openexchangerates.org/api"
# CORS (opcional en desarrollo; defaults: localhost:3001 + subdominios de
# dentalix.local). En PRODUCCIÓN (NODE_ENV=production) CORS_ROOT_DOMAIN,
# TENANT_BASE_DOMAINS y FILES_PUBLIC_BASE_URL son obligatorios, sin dominios
# locales y con https; y las contraseñas de DATABASE_URL/DIRECT_URL no pueden
# ser las de ejemplo (changeme, dentalix, dentalix_app...).
CORS_ORIGINS="http://localhost:3001"
CORS_ROOT_DOMAIN="dentalix.local"
TENANT_BASE_DOMAINS="dentalix.app,localhost"
# Proxy de confianza. Solo el valor exacto "true" lo activa; cualquier otro
# ("1", "yes", "TRUE"...) equivale a "false". Con "true" se usan
# X-Forwarded-Host (tenant) y X-Forwarded-For (IP real para el rate limiting).
# En PRODUCCIÓN detrás de un balanceador/proxy inverso DEBE ser "true" con
# TRUST_PROXY_HOPS correcto: con "false" todos los clientes comparten la IP del
# balanceador y el rate limiting bloquearía a todos a la vez. Sin proxy delante
# (o en local) dejar "false": así X-Forwarded-For no se puede falsear.
TRUST_PROXY="false"
# Nº de proxies de confianza delante de la API (solo si TRUST_PROXY="true";
# default 1). Ej.: CDN + balanceador = 2. Confiar de más permite falsear la IP.
# OJO con la web (DX-062): el navegador llama a la API por `/api/v1` del host
# de la clínica. Si ese tramo pasa por el rewrite de Next (y no por el ingress),
# Next pone X-Forwarded-Host = host de la clínica (sobrescribe el del cliente),
# pero NO añade su salto a X-Forwarded-For: reenvía tal cual el que recibe. Por
# eso Next NO cuenta como salto, y delante de Next tiene que haber un proxy que
# AÑADA (o sobrescriba) X-Forwarded-For con la IP del cliente. Con
# balanceador -> Next -> API: TRUST_PROXY_HOPS="1". Con Next expuesto sin nada
# delante, el cliente elige su IP (X-Forwarded-For falso) o, sin cabecera, todas
# las clínicas comparten la IP de Next en el rate limiting: no desplegar así.
TRUST_PROXY_HOPS="1"
# Rate limiting (opcional; estos son los defaults). LIMIT = peticiones por
# ventana, TTL_MS = ventana en ms. Al superarlo: 429 + cabecera Retry-After.
# El límite se cuenta POR RUTA: las rutas que comparten política tienen cada
# una su propio balde (p. ej. 20/min en login y otros 20/min en register).
# global: cada ruta, por IP (salvo /health y /health/ready). Holgado: una clínica sale por una IP.
RATE_LIMIT_GLOBAL_LIMIT="1000"
RATE_LIMIT_GLOBAL_TTL_MS="60000"
# auth: register y register/verify, cada una por IP.
RATE_LIMIT_AUTH_LIMIT="20"
RATE_LIMIT_AUTH_TTL_MS="60000"
# refresh: renovar sesión, por IP. Holgado: la web renueva en cada carga de
# página (DX-062) y una clínica entera sale por una IP.
RATE_LIMIT_REFRESH_LIMIT="120"
RATE_LIMIT_REFRESH_TTL_MS="60000"
# login-burst (DX-048): login, por IP. Solo frena avalanchas (cada intento
# paga argon2) y cuenta también los aciertos, así que es holgado para una
# clínica entera tras NAT. La fuerza bruta la corta el bloqueo por fallos de
# abajo. Sustituye a RATE_LIMIT_LOGIN_* y RATE_LIMIT_LOGIN_ACCOUNT_*, que ya no
# se leen.
RATE_LIMIT_LOGIN_BURST_LIMIT="60"
RATE_LIMIT_LOGIN_BURST_TTL_MS="60000"
# Bloqueo del login por FALLOS (DX-048), en la BD (vale entre réplicas). Los
# logins correctos no cuentan y uno correcto reinicia la cuenta.
# Por cuenta (hash del email): sin espera hasta LOGIN_LOCKOUT_FREE_FAILURES
# fallos; después BASE, 2·BASE, 4·BASE… hasta MAX (1, 2, 4, 8, 15 min). Los
# fallos se olvidan tras LOGIN_LOCKOUT_RESET_MS sin fallar (> MAX). Un ADMIN
# lo quita con POST /staff/:userId/login-unlock.
LOGIN_LOCKOUT_FREE_FAILURES="5"
LOGIN_LOCKOUT_BASE_DELAY_MS="60000"
LOGIN_LOCKOUT_MAX_DELAY_MS="900000"
LOGIN_LOCKOUT_RESET_MS="3600000"
# Por IP (hash): fallos por ventana fija; al llegar, la IP espera a que acabe.
# Holgado porque una clínica sale por una IP; frena el "spraying".
LOGIN_IP_FAILURE_LIMIT="100"
LOGIN_IP_FAILURE_WINDOW_MS="900000"
# invitation: ver y aceptar invitación por token, cada una por IP.
RATE_LIMIT_INVITATION_LIMIT="10"
RATE_LIMIT_INVITATION_TTL_MS="60000"
# password: POST /me/password, por IP + usuario (sub del token).
RATE_LIMIT_PASSWORD_LIMIT="5"
RATE_LIMIT_PASSWORD_TTL_MS="900000"
# confirmation: ver y responder el enlace público de confirmación de cita, por IP.
RATE_LIMIT_CONFIRMATION_LIMIT="20"
RATE_LIMIT_CONFIRMATION_TTL_MS="60000"
# invitation-email: invitar y reenviar invitación (DX-088), por clínica +
# usuario (cada una manda un email). Los topes que valen entre réplicas son
# los MAIL_*_LIMIT de abajo (en la BD).
RATE_LIMIT_INVITATION_EMAIL_LIMIT="10"
RATE_LIMIT_INVITATION_EMAIL_TTL_MS="60000"
# Recuperar la contraseña (DX-010): pedir el enlace, comprobarlo y
# restablecer; por IP, un balde por ruta. 10 cada 15 min.
RATE_LIMIT_PASSWORD_RESET_LIMIT="10"
RATE_LIMIT_PASSWORD_RESET_TTL_MS="900000"
# Protocolo de los enlaces públicos que genera la API (confirmación de cita,
# DX-005). Vacío = https en producción, http en el resto.
PUBLIC_WEB_PROTOCOL=""
# almacenamiento local de archivos; en prod se cambia por un bucket
STORAGE_DIR="./storage"
FILES_PUBLIC_BASE_URL="https://api.dentalix.app/api/v1/files"
# Log (DX-023). Una línea por evento con request id; nunca cuerpos, query,
# cabeceras de credenciales ni datos del paciente.
# LOG_LEVEL: silent | error | warn | info | debug. Vacío = info (silent en
# los tests de jest, NODE_ENV=test, para no ensuciar su salida).
LOG_LEVEL=""
# LOG_FORMAT: json (una línea JSON, lo que leen los recolectores; default y lo
# que va en producción) | pretty (legible, para desarrollo).
LOG_FORMAT=""
# Email transaccional (DX-088). Fuera de producción, por defecto, los emails
# NO se envían: el ConsoleMailer escribe una línea de log con el destinatario
# enmascarado (sin cuerpo ni enlaces). En PRODUCCIÓN la API no arranca sin
# MAIL_TRANSPORT="smtp", SMTP_URL, MAIL_FROM y MAIL_ENCRYPTION_KEY.
# MAIL_TRANSPORT: console | smtp | file. Vacío = console. `file` (solo
# desarrollo y e2e; prohibido en producción) deja cada email completo, con
# sus enlaces, como JSON en MAIL_FILE_DIR: así se abre el enlace de
# «Restablecer contraseña» (DX-010) en local y en Playwright.
MAIL_TRANSPORT=""
MAIL_FILE_DIR=""
# Proveedor SMTP (SES, Resend, Postmark, Mailgun...): smtp:// o smtps://.
# Lleva la contraseña: nunca se escribe en el log. TLS obligatorio (smtps://
# o STARTTLS en smtp://, TLS ≥ 1.2, certificado verificado); la query (?...)
# se ignora y en producción se rechaza.
SMTP_URL=""
# Remitente: "no-reply@dominio" o "Nombre <no-reply@dominio>".
MAIL_FROM=""
# Cifra (AES-256-GCM) los emails pendientes en email_outbox: llevan enlaces con
# token. 32 bytes en hex o base64: `openssl rand -hex 32`. Vacía fuera de
# producción = una clave efímera por arranque (los pendientes de un arranque
# anterior quedan FAILED). Cambiarla deja FAILED los pendientes del momento.
MAIL_ENCRYPTION_KEY=""
# Barrido del despachador en ms (reintentos y lo que quedó pendiente). Vacío =
# 30000 (0 con NODE_ENV=test). 0 lo apaga.
MAIL_DISPATCH_INTERVAL_MS=""
# Base del backoff entre reintentos en ms (1.º reintento tras la base, el 2.º
# tras el doble). Vacío = 60000. 3 intentos en total; luego FAILED.
MAIL_RETRY_BASE_MS=""
# En PRODUCCIÓN el barrido no puede bajar de 5000 ms ni apagarse.
# Topes anti-abuso contados en la BD (valen con varias réplicas); al pasarlos
# la API responde 429 en español. Vacío = defaults.
# Emails de una clínica en 24 h (default 50).
MAIL_TENANT_DAILY_LIMIT=""
# Emails al mismo destinatario de una clínica en 24 h (default 5).
MAIL_RECIPIENT_DAILY_LIMIT=""
# Segundos mínimos entre dos emails al mismo destinatario (default 60).
MAIL_RECIPIENT_COOLDOWN_SECONDS=""
# DX-029: invitaciones NUEVAS que una clínica puede crear en 24 h (default 30;
# frena el uso de invitaciones para sondear emails). Al pasarlo: 429 en español.
INVITATION_TENANT_DAILY_LIMIT=""

# --- Auditoría: particiones y retención de audit_events (DX-102) ---
# Meses que se conserva el registro de auditoría. Vacío = 180 (15 años: la
# conservación mínima de la historia clínica, Res. 1995/1999 modificada por la
# Res. 839/2017; el registro es la evidencia de quién accedió a ella, Ley
# 1581/2012). No se admite menos de 180 (la API no arranca y la BD lo
# rechaza). Solo lo usa `npm run audit:purge` (con DIRECT_URL, el owner).
AUDIT_RETENTION_MONTHS=""
# Particiones mensuales aseguradas por delante del mes actual (1..36). Vacío = 12.
# La migración ya deja 24; la API las reasegura al arrancar y periódicamente.
AUDIT_PARTITIONS_MONTHS_AHEAD=""
# Cada cuánto reasegura la API el horizonte de particiones, en ms. Vacío =
# 86400000 (un día; 0 con NODE_ENV=test). 0 = solo al arrancar.
AUDIT_PARTITIONS_INTERVAL_MS=""

# --- Trabajos en segundo plano (DX-085) ---
# Papel del proceso (misma imagen, mismo dist/main.js):
#   api    (default) servidor HTTP; encola trabajos pero no los ejecuta.
#   worker sin HTTP; ejecuta la cola y las tareas programadas (npm run start:worker).
#   all    las dos cosas en un proceso (desarrollo: npm run start:dev:all).
APP_ROLE=""
# Cada cuánto busca trabajo el worker, en ms (100..60000). Vacío = 2000.
JOBS_POLL_INTERVAL_MS=""
# Trabajos a la vez por proceso worker (1..32). Vacío = 4.
JOBS_CONCURRENCY=""
# Arriendo de un trabajo reclamado, en s (10..3600): si el worker muere, otro
# lo retoma al vencer. Vacío = 300.
JOBS_LEASE_SECONDS=""
# Intentos por defecto antes de quedar FAILED (1..25; cada handler puede
# fijar los suyos). Vacío = 5.
JOBS_MAX_ATTEMPTS=""
# Base del backoff exponencial entre reintentos, en ms. Vacío = 30000.
JOBS_RETRY_BASE_MS=""
# Cuánto espera el apagado (SIGTERM) a los trabajos en curso, en ms. Vacío =
# 20000. Tiene que ser MENOR que JOBS_LEASE_SECONDS (en ms), y el periodo de
# gracia del orquestador (Kubernetes: 30 s por defecto) mayor que esto.
JOBS_SHUTDOWN_GRACE_MS=""
# Días que se conservan los trabajos terminados (1..365). Vacío = 14.
JOBS_RETENTION_DAYS=""
# Días que se conservan en email_outbox los envíos SENT/FAILED (7..3650). Vacío = 90.
MAIL_OUTBOX_RETENTION_DAYS=""
