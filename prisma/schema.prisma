  tokenHash     String           @unique
  expiresAt     DateTime
  /// Se usó (un solo uso).
  usedAt        DateTime?
  /// Lo dejó sin efecto otro posterior del mismo propósito o el propio uso.
  invalidatedAt DateTime?
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("user_tokens")
}

// DX-039: retención legal extendida de la historia clínica.
//   NONE      -> 15 años desde la última atención (Res. 839/2017).
//   DOUBLE    -> 30 años (casos especiales que doblan el plazo).
//   PERMANENT -> nunca se libera (p. ej. víctimas de violaciones de DD. HH./DIH).
enum RetentionExtension {
  NONE
  DOUBLE
  PERMANENT
}

enum PatientRetentionActionKind {
  EXTENSION_CHANGED
  PARTIAL_SUPPRESSION
}

/// DX-039: rastro APPEND-ONLY de los cambios de retención y de las supresiones
/// parciales de un paciente, con el MOTIVO (texto libre, por eso no va en
/// audit_events) y su autor. Trigger: ni UPDATE ni DELETE para la app;
/// `createdAt` lo fija el servidor de BD. RLS forzada por tenant.
model PatientRetentionAction {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  patientId         String                     @db.Uuid
  kind              PatientRetentionActionKind
  previousExtension RetentionExtension?
  newExtension      RetentionExtension?
  reason            String
  actorId           String                     @db.Uuid
  createdAt         DateTime                   @default(now())

  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([tenantId, patientId, createdAt], map: "patient_retention_actions_patient_created_idx")
  @@map("patient_retention_actions")
}

/// DX-029: alta de clínica pendiente de verificar el email. Tabla GLOBAL (aún
/// no hay clínica): sin tenantId ni RLS. Nada se crea en `tenants`/`users`
/// hasta que llega el enlace del email, así el registro no revela si el email
/// ya tenía cuenta ni permite apropiarse de uno ajeno. Nunca guarda el token
/// en claro (`tokenHash` = SHA-256 hex) ni la contraseña (`passwordHash`).
model PendingRegistration {
  id                    String         @id @default(uuid()) @db.Uuid
  email                 String         @unique
  clinicName            String
  subdomain             String
  fullName              String
  passwordHash          String
  tokenHash             String         @unique
  expiresAt             DateTime
  createdAt             DateTime       @default(now())
  // GLOBAL-G1: país, moneda, zona y locale de la primera sede. NULL en los
  // pendientes creados por una réplica o una web antiguas (forma legada; la
  // fase 2 los hace obligatorios). DX-312: el país es ISO 3166-1 alfa-2 de
  // `countries` (columna "locationCountryCode").
  locationCountry       String?        @map("locationCountryCode") @db.Char(2)
  locationCountryRef    Country?       @relation(fields: [locationCountry], references: [code], onDelete: Restrict, map: "pending_registrations_location_country_code_fkey")
  /// Excepción G5.3 (DX-334): columna anterior a DX-312, solo para las réplicas
  /// anteriores. La mantiene el trigger; el cliente no la lee ni la escribe.
  legacyLocationCountry ClinicCountry? @map("locationCountry") @ignore
  locationCurrency      String?        @db.Char(3)
  locationTimeZone      String?
  locationLocale        String?
  // G1-B (DX-350): reloj de la primera sede. NULL en los pendientes creados
  // por una web o una réplica anteriores a G1-B.
  locationHourCycle     String?

  @@index([expiresAt])
  @@map("pending_registrations")
}

/// DX-085: estado de un trabajo de la cola en segundo plano.
enum JobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// DX-085: cola de trabajos sobre Postgres (tabla de PLATAFORMA, sin RLS a
/// propósito: un worker reclama trabajos de todas las clínicas). Se reclama
/// con SQL crudo y `FOR UPDATE SKIP LOCKED` (PrismaJobRepository); se encola
/// dentro de la transacción de negocio (outbox). `payload` lleva SOLO ids.
/// Ver la migración 20261017200000_dx085_jobs.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `modulo.trabajo`: el handler registrado en JobRegistry.
  name           String
  /// Clínica bajo la que corre el handler (runWithTenant); NULL = plataforma.
  tenantId       String?   @db.Uuid
  payload        Json      @default("{}")
  state          JobState  @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  /// PENDING: cuándo puede empezar. RUNNING: cuándo vence el arriendo.
  runAt          DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  /// Única por (tenantId, idempotencyKey): ver el índice parcial abajo.
  idempotencyKey String?
  lockedBy       String?
  /// Tipo y código del error; nunca su mensaje.
  lastError      String?
  createdAt      DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  updatedAt      DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  finishedAt     DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([state, runAt])
  @@index([state, finishedAt])
  // PARCIALES, no declarables en Prisma:
  //   jobs_tenantId_idempotencyKey_key UNIQUE ("tenantId", "idempotencyKey")
  //     NULLS NOT DISTINCT WHERE "idempotencyKey" IS NOT NULL -> idempotencia
  //     por clínica (ON CONFLICT en PrismaJobRepository.insert).
  //   jobs_tenantId_idx ("tenantId") WHERE "tenantId" IS NOT NULL -> lado
  //     hijo de la FK a tenants.
  //   jobs_active_name_idx ("name") WHERE "state" IN ('PENDING', 'RUNNING')
  //     -> DX-380: ¿sigue en curso el tick anterior de una tarea singleton?
  @@map("jobs")
}

/// DX-085: próximo tick de cada tarea programada (cron, UTC). Un solo worker
/// la bloquea por tick (SKIP LOCKED) y encola su trabajo.
model JobSchedule {
  name          String    @id
  cron          String
  nextRunAt     DateTime
  lastRunAt     DateTime?
  updatedAt     DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  /// DX-380 (OPS-046): ticks que una tarea `singleton` saltó porque el
  /// trabajo del anterior seguía en PENDING o RUNNING, y el último saltado.
  skippedCount  Int       @default(0)
  lastSkippedAt DateTime?

  @@map("job_schedules")
}

/// DX-220 (OPS-029): latido de cada proceso worker (APP_ROLE worker|all). Lo
/// actualiza en cada vuelta del bucle; `GET /platform/jobs/stats` cuenta como
/// vivo el que latió hace menos de 60 s. Tabla de PLATAFORMA sin tenant ni
/// RLS: solo ids técnicos, versión y fechas. La purga diaria de la cola borra
/// los que llevan más de 7 días sin latir.
model JobWorker {
  /// `JobsConfig.workerId` (host:pid:aleatorio), el mismo de `jobs.lockedBy`.
  id         String   @id
  role       String
  /// APP_VERSION del proceso (p. ej. el SHA de la imagen), si se fija.
  version    String?
  startedAt  DateTime @default(dbgenerated("timezone('utc'::text, now())"))
  lastBeatAt DateTime @default(dbgenerated("timezone('utc'::text, now())"))

  @@index([lastBeatAt])
  @@map("job_workers")
}

/// DX-220: acciones de un superadmin sobre la PLATAFORMA (no sobre una
/// clínica, que van a audit_events): hoy reencolar un trabajo FAILED.
/// Append-only (trigger) y sin tenant ni RLS; nunca el payload del trabajo.
model PlatformAuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String   @db.Uuid
  /// `JOB_RETRIED`; DX-359: `MFA_ENROLLMENT_STARTED`, `MFA_ENABLED`,
  /// `PASSWORD_CHANGE` (CHECK en la migración).
  action       String
  /// `JOB`; DX-359: `USER` (el propio superadmin) (CHECK en la migración).
  resourceType String
  resourceId   String?  @db.Uuid
  requestId    String?
  ip           String?
  userAgent    String?
  /// Solo ids y valores técnicos (nombre del trabajo, intentos, error).
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(dbgenerated("timezone('utc'::text, now())"))

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("platform_audit_events")
}

/// DX-085: canal de un mensaje saliente al paciente.
enum OutboundChannel {
  EMAIL
  WHATSAPP_LINK
