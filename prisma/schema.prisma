  createdById        String   @db.Uuid
  createdAt          DateTime @default(dbgenerated("timezone('UTC'::text, now())"))

  location     Location              @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "cancellation_policy_versions_location_fkey")
  currencyRef  Currency?             @relation(fields: [currency], references: [code], onDelete: Restrict, map: "cancellation_policy_versions_currency_fkey")
  createdBy    User                  @relation(fields: [createdById], references: [id], onDelete: Restrict, map: "cancellation_policy_versions_created_by_fkey")
  appointments Appointment[]
  reminders    AppointmentReminder[]
