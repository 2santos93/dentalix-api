  tenantId   String    @db.Uuid
  locationId String    @db.Uuid
  date       DateTime  @db.Date
  name       String
  recurring  Boolean   @default(false)
  /// La pone el servidor de BD (trigger), en UTC.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Retirada en blando (no-hard-delete.ts): toda lectura filtra deletedAt null.
  deletedAt  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "location_holidays_location_fkey")

  @@index([tenantId, locationId, date])
  @@map("location_holidays")
}

/// Pago de un gasto (DX-274). Con `cashSessionId` es una SALIDA DE CAJA
