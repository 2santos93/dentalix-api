// Canal de contacto y baja de recordatorios (DX-128)
// ---------------------------------------------------------------------------

/// DX-128: canal de los avisos automáticos del paciente. NONE = ninguno.
enum ContactChannel {
  EMAIL
  WHATSAPP
  NONE
}

/// DX-128: dónde aceptó el paciente que la clínica le escriba por WhatsApp.
enum WhatsappOptInSource {
  IN_PERSON
  LINK
  MESSAGE
}

/// DX-128: cómo se dio de baja de los recordatorios: con el enlace del email,
/// respondiendo «BAJA» al mensaje, o lo anotó recepción a petición suya.
enum ReminderOptOutSource {
  LINK
  MESSAGE
  STAFF
}

/// DX-128: enlace de baja de los recordatorios que viaja en cada email. El
/// token en claro solo va en el email; aquí su SHA-256. No caduca: darse de
/// baja tiene que funcionar siempre. `usedAt`: la primera vez que se usó.
model ReminderOptOutLink {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  patientId String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK COMPUESTA (SEC-004): el paciente tiene que ser del MISMO tenant.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("reminder_opt_out_links")
}

// DX-191: tipo de componente implantado.
enum PatientImplantKind {
  IMPLANT
  ABUTMENT
  GRAFT
  MEMBRANE
  OTHER
}

/// DX-191: un implante (o pilar, injerto, membrana…) colocado a un paciente:
/// ficha de la Res. 4816/2008 (CO) y datos de la tarjeta de implante del
/// RD 192/2023 (ES). INALTERABLE en la BD (trigger
/// `dx_patient_implants_immutable`): solo se anula una vez (motivo, autor y
/// fecha) o se marca su tarjeta como entregada una vez. RLS forzada.
/// Búsqueda por lote / REF (DX-225): columnas GENERADAS "lotKey" y
/// "referenceKey" (upper(btrim(...))), ignoradas por Prisma, con los índices
/// que Prisma no declara sobre campos ignorados (20261020100000):
///   patient_implants_tenant_lot_key_idx       ("tenantId", "lotKey")
///   patient_implants_tenant_reference_key_idx ("tenantId", "referenceKey")
/// FK (tenantId, treatmentPlanItemId) -> treatment_plan_items(tenantId, id)
/// solo en SQL (20261017235400): Prisma no la modela sin relación inversa.
model PatientImplant {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  locationId           String             @db.Uuid
  patientId            String             @db.Uuid
  // Quien lo coloca: sale del token, nunca del cuerpo.
  professionalId       String             @db.Uuid
  // Día civil de la colocación (zona de la sede); la intervención de la tarjeta.
  placedOn             DateTime           @db.Date
  toothNumber          String
  treatmentPlanItemId  String?            @db.Uuid
  kind                 PatientImplantKind
  manufacturer         String
  system               String?
  reference            String
  lot                  String
  udi                  String?
  diameterMm           Decimal?           @db.Decimal(4, 2)
  lengthMm             Decimal?           @db.Decimal(4, 2)
  // Registro sanitario INVIMA (CO) o marcado CE (ES).
  sanitaryRegistration String?
  notes                String?
  createdAt            DateTime           @default(now())
  voidedAt             DateTime?
  voidedById           String?            @db.Uuid
  voidReason           String?
  cardDeliveredAt      DateTime?
  cardDeliveredById    String?            @db.Uuid
  lotKey               String?            @default(dbgenerated("upper(btrim(lot))")) @ignore
  referenceKey         String?            @default(dbgenerated("upper(btrim(reference))")) @ignore

  // FK COMPUESTAS (SEC-004): paciente y sede del MISMO tenant.
  patient       Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  location      Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  professional  User     @relation("PatientImplantProfessional", fields: [professionalId], references: [id], onDelete: Restrict)
  voidedBy      User?    @relation("PatientImplantVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  cardDelivered User?    @relation("PatientImplantCardDeliveredBy", fields: [cardDeliveredById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "patient_implants_tenant_id_key")
  @@index([tenantId, patientId, placedOn(sort: Desc), createdAt], map: "patient_implants_patient_placed_idx")
  @@index([tenantId, manufacturer, system], map: "patient_implants_tenant_manufacturer_system_idx")
  @@index([tenantId, locationId])
  @@index([tenantId, treatmentPlanItemId])
  @@index([professionalId])
  @@index([voidedById])
  @@index([cardDeliveredById])
  @@map("patient_implants")
}

// DX-151: categoría de un documento del paciente.
enum PatientDocumentCategory {
  XRAY
  PHOTO
  REFERRAL
  SIGNED_CONSENT
  REPORT
  OTHER
}

/// DX-151: un fichero adjunto a la ficha del paciente (radiografía, foto,
/// remisión, consentimiento firmado escaneado, informe…). El contenido vive en
/// el bucket (`storageKey`); aquí van sus metadatos y su huella `sha256`.
/// INALTERABLE en la BD (trigger `dx_patient_documents_immutable`): solo se
/// anula una vez (motivo, autor y fecha); DELETE/TRUNCATE solo un
/// superusuario. `uploadedAt` y `createdAt` los pone el servidor en UTC
/// (trigger BEFORE INSERT). RLS forzada.
/// En SQL y no en Prisma (20261020200100):
///   patient_documents_active_sha256_key  UNIQUE ("tenantId", "patientId", "sha256")
///                                        WHERE "voidedAt" IS NULL
///   CHECK de dientes: cada elemento FDI y como mucho 8.
model PatientDocument {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @db.Uuid
  patientId    String                  @db.Uuid
  // Sede activa al subirlo.
  locationId   String                  @db.Uuid
  category     PatientDocumentCategory
  // Nombre del fichero tal como lo subió el usuario (solo para mostrar).
  originalName String
  mimeType     String
  sizeBytes    Int
  // SHA-256 del contenido en hex minúsculas.
  sha256       String
  storageKey   String                  @unique
  // Fecha clínica del documento (p. ej. el día de la radiografía), si se sabe.
  clinicalDate DateTime?               @db.Date
  // Dientes FDI a los que se refiere (0..8).
  toothNumbers String[]                @default([])
  notes        String?
  // Quien lo sube: sale del token, nunca del cuerpo.
  uploadedById String                  @db.Uuid
  uploadedAt   DateTime                @default(now())
  voidedAt     DateTime?
  voidedById   String?                 @db.Uuid
  voidReason   String?
  createdAt    DateTime                @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // FK COMPUESTAS (SEC-004): paciente y sede del MISMO tenant.
  patient    Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict)
  location   Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  uploadedBy User     @relation("PatientDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  voidedBy   User?    @relation("PatientDocumentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, id], map: "patient_documents_tenant_id_key")
  @@index([tenantId, patientId, uploadedAt(sort: Desc)], map: "patient_documents_patient_uploaded_idx")
  @@index([tenantId, patientId, category], map: "patient_documents_patient_category_idx")
  @@index([toothNumbers], type: Gin, map: "patient_documents_tooth_numbers_idx")
  @@index([tenantId, locationId])
  @@index([uploadedById])
  @@index([voidedById])
  @@map("patient_documents")
}

// ---------------------------------------------------------------------------
// Cobranza (DX-150): gestiones de cobro y compromisos de pago del paciente.
// APPEND-ONLY en la BD (triggers de 20261017235600_dx150_collections): una nota
// no se edita ni se borra (una corrección es otra nota) y un compromiso solo
// pasa de OPEN a KEPT o BROKEN una vez. RLS FORCE y FK compuestas por tenant.
// ---------------------------------------------------------------------------

enum CollectionChannel {
  CALL
  WHATSAPP_LINK
  EMAIL
  IN_PERSON
}

enum CollectionOutcome {
  NO_ANSWER
  PROMISED_PAYMENT
  WILL_PAY_AT_APPOINTMENT
  DISPUTE
  WRONG_NUMBER
}

enum PaymentPromiseStatus {
  OPEN
  KEPT
  BROKEN
}

/// Una gestión de cobro (llamada, WhatsApp, email, en persona) y su resultado.
/// `text` (<= 280) es una nota administrativa: nunca sale en logs ni auditoría.
model CollectionNote {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  patientId  String            @db.Uuid
  /// Sede activa al registrarla; NULL = vista consolidada.
  locationId String?           @db.Uuid
  channel    CollectionChannel
  outcome    CollectionOutcome
  text       String?
  /// Puntero suave a User, como `Payment.createdById`.
  authorId   String            @db.Uuid
  /// La pone el servidor de BD (trigger).
  createdAt  DateTime          @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient  Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "collection_notes_patient_fkey")
  location Location? @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "collection_notes_location_fkey")

  @@index([tenantId, patientId, createdAt(sort: Desc), id(sort: Desc)], map: "collection_notes_tenant_patient_created_idx")
  @@map("collection_notes")
}

/// Compromiso de pago: importe, moneda y fecha (día civil de la sede). Lo
/// cierra el barrido de cobranza (KEPT al cubrirse con abonos registrados
/// desde el compromiso y fechados hasta ese día; BROKEN al día siguiente) o el
/// propio abono que lo cubre.
model PaymentPromise {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  patientId   String               @db.Uuid
  /// Sede cuya zona decide los días del compromiso.
  locationId  String               @db.Uuid
  amount      Decimal              @db.Decimal(14, 2)
  currency    String
  dueDate     DateTime             @db.Date
  status      PaymentPromiseStatus @default(OPEN)
  createdById String               @db.Uuid
  /// La pone el servidor de BD (trigger).
  createdAt   DateTime             @default(now())
  settledAt   DateTime?
  /// DX-215: última vez que se reabrió (KEPT -> OPEN | BROKEN al anular el
  /// abono que lo cumplía). La pone el servidor de BD en UTC (trigger).
  reopenedAt  DateTime?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "payment_promises_patient_fkey")
  location    Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "payment_promises_location_fkey")
  currencyRef Currency @relation(fields: [currency], references: [code])

  @@index([tenantId, patientId, createdAt(sort: Desc), id(sort: Desc)], map: "payment_promises_tenant_patient_created_idx")
  @@index([tenantId, locationId], map: "payment_promises_tenant_location_idx")
  @@map("payment_promises")
}

/// SEC-008: cada acceso break-glass de un superadmin a una clínica en la que
/// no es miembro. Append-only (un trigger rechaza UPDATE/DELETE/TRUNCATE) y
/// con RLS forzada por tenant: el ADMIN de la clínica lee solo los suyos.
model PlatformAccessAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  reason    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  /// Caducidad del token emitido (createdAt + BREAK_GLASS_TTL_MINUTES).
  expiresAt DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt])
  @@map("platform_access_audit")
}

// DX-203: parentesco del responsable con el paciente.
enum ResponsibleRelationship {
  MOTHER
  FATHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  SPOUSE
  CHILD
  OTHER
}

// DX-203: destinatario de un mensaje saliente.
enum OutboundRecipientKind {
  PATIENT
  RESPONSIBLE
}

/// DX-203: responsable de pago y/o de los avisos de un paciente (el acudiente
/// de un menor, la madre que paga a sus hijos). Es OTRO paciente de la clínica
/// (`responsiblePatientId`) o un contacto sin ficha (nombre, documento, email
/// y teléfono): CHECK en la BD, una de las dos formas. Datos de un tercero
/// tratados bajo la autorización del paciente (finalidad «gestión de cobro y
/// avisos»): no crea usuario ni da acceso al portal.
/// Como mucho UN pagador principal vivo por paciente y el mismo paciente
/// responsable una sola vez (índices únicos PARCIALES, solo en SQL). Se quita
/// en blando (`deletedAt`). RLS FORCE y FK COMPUESTAS por tenant.
model PatientResponsibleParty {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @db.Uuid
  patientId            String                  @db.Uuid
  /// El responsable es otro paciente de la clínica (sus datos, de su ficha).
  responsiblePatientId String?                 @db.Uuid
  /// Contacto sin ficha: NULL los cinco si es un paciente.
  fullName             String?
  docType              DocType?
  docNumber            String?
  email                String?
  phone                String?
  relationship         ResponsibleRelationship
  isPayer              Boolean                 @default(false)
  receivesNotices      Boolean                 @default(true)
  /// Copiado de `patients.guardianName/guardianDocNumber` por la migración.
  migratedFromGuardian Boolean                 @default(false)
  /// Puntero suave a User, como `Payment.createdById`.
  createdById          String?                 @db.Uuid
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient            Patient  @relation("PatientResponsibleParties", fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "patient_responsible_parties_patient_fkey")
  responsiblePatient Patient? @relation("ResponsiblePatient", fields: [tenantId, responsiblePatientId], references: [tenantId, id], onDelete: Restrict, map: "patient_responsible_parties_responsible_fkey")

  @@index([tenantId, patientId, createdAt], map: "patient_responsible_parties_tenant_patient_idx")
  // PARCIALES (no declarables en Prisma, no generan drift):
  //   patient_responsible_parties_one_payer_key   UNIQUE ("tenantId", "patientId") WHERE "isPayer" AND "deletedAt" IS NULL
  //   patient_responsible_parties_patient_link_key UNIQUE ("tenantId", "patientId", "responsiblePatientId") WHERE "deletedAt" IS NULL AND "responsiblePatientId" IS NOT NULL
  //   patient_responsible_parties_migrated_key    UNIQUE ("tenantId", "patientId") WHERE "migratedFromGuardian"
  //   patient_responsible_parties_responsible_idx ("tenantId", "responsiblePatientId") WHERE "responsiblePatientId" IS NOT NULL
  @@map("patient_responsible_parties")
}

// ---------------------------------------------------------------------------
// Pagadores y coberturas del paciente (DX-153)
// ---------------------------------------------------------------------------

enum PayerType {
  MUTUA_ES
  PREPAGADA_CO
  EPS_CO
  EMPRESA
  /// «Otro / sin clasificar»: el que crea el relleno de `insurerEps`.
  OTRO
}

/// DX-153: pagador de la clínica (mutua, prepagada, EPS, empresa). Catálogo
/// POR CLÍNICA. Se retira en blando (`deletedAt` + `active = false`); desactivar
/// solo lo oculta de los selectores. RLS FORCE.
/// CHECK `payers_type_country_check` en la BD: MUTUA_ES exige ES; PREPAGADA_CO y
/// EPS_CO exigen CO; EMPRESA y OTRO admiten CO, ES o nulo.
model Payer {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  type        PayerType
  country     ClinicCountry?
  active      Boolean        @default(true)
  /// Punteros suaves a User, como `Payment.createdById`.
  createdById String?        @db.Uuid
  updatedById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  coverages  PatientCoverage[]
  // DX-105: convenios con este pagador.
  agreements Agreement[]

  // Destino de la FK compuesta de `patient_coverages`.
  @@unique([tenantId, id], map: "payers_tenant_id_key")
  // PARCIAL: en la BD es UNIQUE ("tenantId", "name") WHERE "deletedAt" IS NULL
  // (un nombre por clínica entre los vivos). Prisma no expresa el WHERE: NO
  // aceptar un diff de `migrate dev` que lo recree sin el WHERE.
  @@unique([tenantId, name], map: "payers_tenant_name_key")
  @@map("payers")
}

/// DX-153: cobertura de un paciente con un pagador (plan, nº de afiliado,
/// titular, vigencia en días civiles sin zona). `memberNumber` es un DATO
/// PERSONAL: nunca en logs, auditoría ni CSV. `policyHolderName` es el titular
/// cuando no es el paciente: dato de un tercero tratado bajo la autorización
/// del paciente (finalidad «gestión de cobro»). Se retira en blando
/// (`deletedAt`). RLS FORCE y FK COMPUESTAS por tenant.
/// PARCIALES (no declarables en Prisma, no generan drift):
///   patient_coverages_one_primary_key    UNIQUE ("tenantId", "patientId") WHERE "isPrimary" AND "deletedAt" IS NULL
///   patient_coverages_migrated_key       UNIQUE ("tenantId", "patientId") WHERE "migratedFromInsurerEps"
///   patient_coverages_tenant_payer_live_idx ("tenantId", "payerId", "patientId") WHERE "deletedAt" IS NULL
/// CHECK patient_coverages_valid_range_check: "validTo" >= "validFrom" si ambos existen.
model PatientCoverage {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  patientId              String    @db.Uuid
  payerId                String    @db.Uuid
  planName               String?
  memberNumber           String?
  policyHolderName       String?
  validFrom              DateTime? @db.Date
  validTo                DateTime? @db.Date
  isPrimary              Boolean   @default(false)
  notes                  String?
  /// Copiado de `patients.insurerEps` por la migración.
  migratedFromInsurerEps Boolean   @default(false)
  /// Punteros suaves a User, como `Payment.createdById`.
  createdById            String?   @db.Uuid
  updatedById            String?   @db.Uuid
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient    Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "patient_coverages_patient_fkey")
  payer      Payer              @relation(fields: [tenantId, payerId], references: [tenantId, id], onDelete: Restrict, map: "patient_coverages_payer_fkey")
  // DX-105: asignaciones de convenio que vinculan esta cobertura.
  agreements PatientAgreement[]

  // Destino de la FK compuesta de `patient_agreements` (DX-105).
  @@unique([tenantId, id], map: "patient_coverages_tenant_id_key")
  @@index([tenantId, patientId, createdAt], map: "patient_coverages_tenant_patient_idx")
  @@map("patient_coverages")
}

// ---------------------------------------------------------------------------
// Convenios y listas de precios (DX-105)
// ---------------------------------------------------------------------------

enum AgreementKind {
  PERCENT_DISCOUNT
  PRICE_LIST
}

/// De dónde salió el precio sellado en un ítem de plan.
enum PriceSource {
  CATALOG
  PRICE_LIST
  AGREEMENT_PERCENT
  AGREEMENT_PRICE_LIST
}

/// DX-105: lista de precios de la clínica (toda la clínica o una sede). Se
/// retira en blando (`deletedAt`). RLS FORCE y FK COMPUESTAS por tenant.
/// PARCIALES (no declarables en Prisma, no generan drift):
///   price_lists_tenant_name_key            UNIQUE ("tenantId", "name") WHERE "deletedAt" IS NULL
///   price_lists_tenant_location_active_key UNIQUE ("tenantId", "locationId")
///     WHERE "active" AND "deletedAt" IS NULL AND "locationId" IS NOT NULL
///     (a lo sumo una lista activa por sede)
/// CHECK price_lists_name_length_check (2..120) y price_lists_currency_format.
model PriceList {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  currency    String
  /// NULL = toda la clínica.
  locationId  String?   @db.Uuid
  active      Boolean   @default(true)
  /// Punteros suaves a User, como `Payer.createdById`.
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  currencyRef Currency        @relation(fields: [currency], references: [code], map: "price_lists_currency_fkey")
  location    Location?       @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "price_lists_location_fkey")
  items       PriceListItem[]
  agreements  Agreement[]

  // Destino de las FK compuestas de `price_list_items` y `agreements`.
  @@unique([tenantId, id], map: "price_lists_tenant_id_key")
  // PARCIAL: en la BD es UNIQUE ("tenantId", "name") WHERE "deletedAt" IS NULL.
  // Prisma no expresa el WHERE: NO aceptar un diff de `migrate dev` que lo
  // recree sin el WHERE.
  @@unique([tenantId, name], map: "price_lists_tenant_name_key")
  @@index([tenantId, locationId], map: "price_lists_tenant_location_idx")
  @@map("price_lists")
}

/// DX-105: precio de un procedimiento en una lista. Sin borrado blando: quitar
/// el precio = borrar la fila. CHECK price_list_items_price_nonneg (>= 0).
model PriceListItem {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  priceListId   String   @db.Uuid
  catalogItemId String   @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  priceList   PriceList         @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Restrict, map: "price_list_items_price_list_fkey")
  catalogItem DentalCatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict, map: "price_list_items_catalog_item_fkey")

  @@unique([tenantId, priceListId, catalogItemId], map: "price_list_items_tenant_list_item_key")
  @@index([tenantId, catalogItemId], map: "price_list_items_tenant_catalog_item_idx")
  @@map("price_list_items")
}

/// DX-105: convenio con un pagador. `PERCENT_DISCOUNT` usa `percent` (global) y
/// opcionalmente `percentByCategory` (`{ "<categoría>": <0–100> }`, la categoría
/// se compara normalizada con `DentalCatalogItem.category`); `PRICE_LIST` usa
/// `priceListId`. Se retira en blando (`deletedAt`). RLS FORCE y FK COMPUESTAS.
/// PARCIAL (no declarable en Prisma):
///   agreements_tenant_name_key UNIQUE ("tenantId", "name") WHERE "deletedAt" IS NULL
/// CHECK agreements_kind_check, agreements_percent_check (0..100),
/// agreements_percent_by_category_check (jsonb_typeof = 'object'),
/// agreements_valid_range_check, agreements_name_length_check (2..120).
model Agreement {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  name              String
  payerId           String        @db.Uuid
  kind              AgreementKind
  percent           Decimal?      @db.Decimal(5, 2)
  percentByCategory Json?
  priceListId       String?       @db.Uuid
  /// NULL = toda la clínica.
  locationId        String?       @db.Uuid
  validFrom         DateTime?     @db.Date
  validTo           DateTime?     @db.Date
  active            Boolean       @default(true)
  /// Punteros suaves a User, como `Payer.createdById`.
  createdById       String?       @db.Uuid
  updatedById       String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payer       Payer               @relation(fields: [tenantId, payerId], references: [tenantId, id], onDelete: Restrict, map: "agreements_payer_fkey")
  priceList   PriceList?          @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Restrict, map: "agreements_price_list_fkey")
  location    Location?           @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "agreements_location_fkey")
  assignments PatientAgreement[]
  planItems   TreatmentPlanItem[]

  // Destino de las FK compuestas de `patient_agreements` y `treatment_plan_items`.
  @@unique([tenantId, id], map: "agreements_tenant_id_key")
  // PARCIAL: en la BD es UNIQUE ("tenantId", "name") WHERE "deletedAt" IS NULL.
  // NO aceptar un diff de `migrate dev` que lo recree sin el WHERE.
  @@unique([tenantId, name], map: "agreements_tenant_name_key")
  @@index([tenantId, payerId], map: "agreements_tenant_payer_idx")
  @@index([tenantId, priceListId], map: "agreements_tenant_price_list_idx")
  @@index([tenantId, locationId], map: "agreements_tenant_location_idx")
  @@map("agreements")
}

/// DX-105: convenio asignado a un paciente. `coverageId` vincula el nº de
/// afiliado sin duplicarlo (ruling R2). Se retira en blando; las filas retiradas
/// son el historial. RLS FORCE y FK COMPUESTAS.
/// PARCIAL (no declarable en Prisma, no genera drift):
///   patient_agreements_one_live_key UNIQUE ("tenantId", "patientId") WHERE "deletedAt" IS NULL
///   (una asignación viva por paciente)
/// CHECK patient_agreements_valid_range_check y patient_agreements_notes_length_check (<= 500).
model PatientAgreement {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  patientId   String    @db.Uuid
  agreementId String    @db.Uuid
  coverageId  String?   @db.Uuid
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  notes       String?
  /// Punteros suaves a User, como `Payer.createdById`.
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient   Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "patient_agreements_patient_fkey")
  agreement Agreement        @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Restrict, map: "patient_agreements_agreement_fkey")
  coverage  PatientCoverage? @relation(fields: [tenantId, coverageId], references: [tenantId, id], onDelete: Restrict, map: "patient_agreements_coverage_fkey")

  @@index([tenantId, patientId, createdAt], map: "patient_agreements_tenant_patient_idx")
  @@index([tenantId, agreementId], map: "patient_agreements_tenant_agreement_idx")
  @@index([tenantId, coverageId], map: "patient_agreements_tenant_coverage_idx")
  @@map("patient_agreements")
}

// ---------------------------------------------------------------------------
// Caja por turno (DX-027)
// ---------------------------------------------------------------------------

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// VOID: anulación de un abono de una caja ya cerrada (resta). LATE_PAYMENT:
/// abono con fecha de un día cuya caja ya se cerró (suma). CORRECTION: una
/// corrección del ADMIN sobre un cierre, con motivo.
enum CashAdjustmentKind {
  VOID
  LATE_PAYMENT
  CORRECTION
}

/// Turno de caja de UN usuario en UNA sede. Una sola abierta por (sede,
/// usuario) — índice único parcial `cash_sessions_open_key` (WHERE status =
/// 'OPEN', solo en SQL). La apertura no se edita; el cierre deja una fila en
/// `cash_session_closings` y solo un ADMIN la reabre (`cash_session_reopenings`).
/// Triggers en la migración 20261018140200_dx027_cash_sessions.
model CashSession {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  locationId  String            @db.Uuid
  /// Puntero suave a User, como `Payment.createdById`.
  openedById  String            @db.Uuid
  /// La pone el servidor de BD (trigger).
  openedAt    DateTime          @default(now())
  notes       String?
  status      CashSessionStatus @default(OPEN)
  /// La pone el servidor de BD (trigger) al cerrar.
  closedAt    DateTime?
  closedById  String?           @db.Uuid
  reopenCount Int               @default(0)

  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location              Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "cash_sessions_location_fkey")
  floats                CashSessionFloat[]
  closings              CashSessionClosing[]
  reopenings            CashSessionReopening[]
  payments              Payment[]
  adjustments           CashSessionAdjustment[] @relation("CashAdjustmentSession")
  originatedAdjustments CashSessionAdjustment[] @relation("CashAdjustmentOriginal")

  @@unique([tenantId, id], map: "cash_sessions_tenant_id_key")
  @@index([tenantId, locationId, openedAt(sort: Desc), id(sort: Desc)], map: "cash_sessions_tenant_location_opened_idx")
  @@index([tenantId, openedAt(sort: Desc), id(sort: Desc)], map: "cash_sessions_tenant_opened_idx")
  @@index([tenantId, openedById, openedAt(sort: Desc), id(sort: Desc)], map: "cash_sessions_tenant_user_opened_idx")
  @@map("cash_sessions")
}

/// Fondo inicial de la caja por moneda (>= 0). Solo en la apertura.
model CashSessionFloat {
  tenantId  String  @db.Uuid
  sessionId String  @db.Uuid
  currency  String
  amount    Decimal @db.Decimal(14, 2)

  session     CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_floats_session_fkey")
  currencyRef Currency    @relation(fields: [currency], references: [code], map: "cash_session_floats_currency_fkey")

  @@id([sessionId, currency])
  @@index([tenantId, sessionId], map: "cash_session_floats_tenant_session_idx")
  @@map("cash_session_floats")
}

/// Un cierre de la caja (1 el primero; 2, 3... tras cada reapertura).
/// Inalterable. `suggestedLockDate`: el día civil del cierre en la sede, que
/// DX-091 podrá usar como fecha de bloqueo contable.
model CashSessionClosing {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  sessionId         String   @db.Uuid
  sequence          Int
  closedById        String   @db.Uuid
  /// La pone el servidor de BD (trigger).
  closedAt          DateTime @default(now())
  blind             Boolean
  hasDifference     Boolean
  differenceReason  String?
  notes             String?
  suggestedLockDate DateTime @db.Date

  session    CashSession              @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_closings_session_fkey")
  lines      CashSessionClosingLine[]
  reopenings CashSessionReopening[]

  @@unique([tenantId, id], map: "cash_session_closings_tenant_id_key")
  @@unique([tenantId, sessionId, sequence], map: "cash_session_closings_session_sequence_key")
  @@map("cash_session_closings")
}

/// Arqueo por (moneda, método) de un cierre: fondo, esperado, contado y
/// diferencia (= contado - esperado, CHECK). Inalterable.
model CashSessionClosingLine {
  tenantId   String        @db.Uuid
  closingId  String        @db.Uuid
  currency   String
  method     PaymentMethod
  opening    Decimal       @db.Decimal(14, 2)
  expected   Decimal       @db.Decimal(14, 2)
  counted    Decimal       @db.Decimal(14, 2)
  difference Decimal       @db.Decimal(14, 2)

  closing     CashSessionClosing @relation(fields: [tenantId, closingId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_closing_lines_closing_fkey")
  currencyRef Currency           @relation(fields: [currency], references: [code], map: "cash_session_closing_lines_currency_fkey")

  @@id([closingId, currency, method])
  @@index([tenantId, closingId], map: "cash_session_closing_lines_tenant_closing_idx")
  @@map("cash_session_closing_lines")
}

/// Lo que llega después de cerrar una caja y no puede tocarla. Va a la caja
/// abierta de quien lo hace en la sede (`sessionId`) o queda pendiente (NULL)
/// hasta la siguiente que se abra en la sede. `originalSessionId`: la caja
/// cerrada de la que viene.
model CashSessionAdjustment {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  locationId        String             @db.Uuid
  sessionId         String?            @db.Uuid
  kind              CashAdjustmentKind
  paymentId         String?            @db.Uuid
  originalSessionId String?            @db.Uuid
  currency          String
  method            PaymentMethod
  amount            Decimal            @db.Decimal(14, 2)
  reason            String?
  /// Puntero suave a User, como `Payment.createdById`.
  createdById       String             @db.Uuid
  /// La pone el servidor de BD (trigger).
  createdAt         DateTime           @default(now())

  location        Location     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_adjustments_location_fkey")
  session         CashSession? @relation("CashAdjustmentSession", fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_adjustments_session_fkey")
  originalSession CashSession? @relation("CashAdjustmentOriginal", fields: [tenantId, originalSessionId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_adjustments_original_fkey")
  payment         Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "cash_session_adjustments_payment_fkey")
  currencyRef     Currency     @relation(fields: [currency], references: [code], map: "cash_session_adjustments_currency_fkey")

  @@index([tenantId, locationId, createdAt], map: "cash_session_adjustments_tenant_location_idx")
  @@map("cash_session_adjustments")
}

/// Reapertura de un cierre por un ADMIN, con motivo. Append-only.
model CashSessionReopening {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  sessionId    String   @db.Uuid
  sequence     Int
  closingId    String   @db.Uuid
  reason       String
  reopenedById String   @db.Uuid
  /// La pone el servidor de BD (trigger).
  reopenedAt   DateTime @default(now())

  session CashSession        @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_reopenings_session_fkey")
  closing CashSessionClosing @relation(fields: [tenantId, closingId], references: [tenantId, id], onDelete: Restrict, map: "cash_session_reopenings_closing_fkey")

  @@unique([tenantId, sessionId, sequence], map: "cash_session_reopenings_session_sequence_key")
  @@index([tenantId, closingId], map: "cash_session_reopenings_tenant_closing_idx")
  @@map("cash_session_reopenings")
}

// ---------------------------------------------------------------------------
// Indicaciones postoperatorias (DX-222)
// ---------------------------------------------------------------------------

/// Por dónde se entregó: impresa en la consulta, por email (enlace) o enlace
/// para WhatsApp (el mensaje no lleva datos clínicos, solo el enlace).
enum PostOpDeliveryChannel {
  PRINT
  EMAIL
  WHATSAPP_LINK
}

/// Plantilla de indicaciones de la clínica (p. ej. «POI-EXO», exodoncia
/// simple). Se edita en el sitio: un cambio de título o texto sube `version`;
/// las entregas ya hechas guardan su copia. `active = false` la quita del
/// selector. Topes y formato del código en CHECK (migración).
model PostOpInstructionTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  /// 2–20 letras mayúsculas, números o guiones; único por clínica; no se edita.
  code        String
  title       String
  /// Texto con variables `{{paciente}}`, `{{clinica}}`, `{{telefono_sede}}`…
  body        String
  version     Int      @default(1)
  active      Boolean  @default(true)
  /// Punteros suaves a User, como en las plantillas de evolución.
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  links      PostOpInstructionTemplateLink[]
  deliveries PostOpInstructionDelivery[]

  // Destino de las FK compuestas de los vínculos y de las entregas.
  @@unique([tenantId, id], map: "post_op_instruction_templates_tenant_id_key")
  @@unique([tenantId, code], map: "post_op_instruction_templates_tenant_code_key")
  @@index([tenantId, active], map: "post_op_instruction_templates_tenant_active_idx")
  @@map("post_op_instruction_templates")
}

/// Cuándo sugerir una plantilla: por un procedimiento del catálogo o por un
/// tipo de cita (exactamente uno de los dos, CHECK). Se reemplazan completos
/// al editar la plantilla y se borran con ella (CASCADE).
model PostOpInstructionTemplateLink {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  templateId        String   @db.Uuid
  /// Puntero suave a dental_catalog_items (sin FK, como tooth_records: el
  /// catálogo no tiene único (tenantId, id) y se retira en blando).
  catalogItemId     String?  @db.Uuid
  appointmentTypeId String?  @db.Uuid
  createdAt         DateTime @default(now())

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  template        PostOpInstructionTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade, map: "post_op_instruction_template_links_template_fkey")
  appointmentType AppointmentType?          @relation(fields: [tenantId, appointmentTypeId], references: [tenantId, id], onDelete: Restrict, map: "post_op_instruction_template_links_appointment_type_fkey")

  @@index([tenantId, templateId], map: "post_op_instruction_template_links_template_idx")
  // PARCIALES (no declarables en Prisma, no generan drift):
  //   post_op_instruction_template_links_catalog_key  UNIQUE ("tenantId", "templateId", "catalogItemId") WHERE "catalogItemId" IS NOT NULL
  //   post_op_instruction_template_links_type_key     UNIQUE ("tenantId", "templateId", "appointmentTypeId") WHERE "appointmentTypeId" IS NOT NULL
  //   post_op_instruction_template_links_catalog_idx  ("tenantId", "catalogItemId") WHERE "catalogItemId" IS NOT NULL
  //   post_op_instruction_template_links_type_idx     ("tenantId", "appointmentTypeId") WHERE "appointmentTypeId" IS NOT NULL
  @@map("post_op_instruction_template_links")
}

/// Entrega de unas indicaciones a un paciente por una cita. INALTERABLE
/// (trigger post_op_deliveries_immutable): guarda la copia exacta del texto
/// entregado y la versión de la plantilla; lo único que cambia es
/// `firstOpenedAt`, de NULL a la primera apertura del enlace público. No se
/// borra (salvo purga sin `app.current_tenant`). `deliveredAt` y `createdAt`
/// los pone el servidor de BD en UTC. El enlace guarda solo el hash del token.
model PostOpInstructionDelivery {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  patientId         String                @db.Uuid
  appointmentId     String                @db.Uuid
  locationId        String                @db.Uuid
  templateId        String                @db.Uuid
  /// Copia de la plantilla en el momento de la entrega.
  templateCode      String
  templateTitle     String
  templateVersion   Int
  channel           PostOpDeliveryChannel
  /// Texto con las variables ya sustituidas, tal como lo recibió el paciente.
  renderedText      String
  deliveredById     String                @db.Uuid
  deliveredByName   String
  /// La pone el servidor de BD (trigger).
  deliveredAt       DateTime              @default(now())
  /// Destinatario enmascarado (email o los 4 últimos dígitos del móvil).
  recipientMasked   String?
  /// El email fue al responsable del paciente (DX-203), no al paciente.
  sentToResponsible Boolean               @default(false)
  /// SHA-256 en hex del token del enlace público; nunca el token.
  tokenHash         String?               @unique
  tokenExpiresAt    DateTime?
  firstOpenedAt     DateTime?
  /// La pone el servidor de BD (trigger).
  createdAt         DateTime              @default(now())

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient     Patient                   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "post_op_instruction_deliveries_patient_fkey")
  appointment Appointment               @relation(fields: [tenantId, patientId, appointmentId], references: [tenantId, patientId, id], onDelete: Restrict, map: "post_op_instruction_deliveries_appointment_fkey")
  location    Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "post_op_instruction_deliveries_location_fkey")
  template    PostOpInstructionTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict, map: "post_op_instruction_deliveries_template_fkey")
  deliveredBy User                      @relation(fields: [deliveredById], references: [id], onDelete: Restrict, map: "post_op_instruction_deliveries_delivered_by_fkey")

  @@index([tenantId, patientId, deliveredAt(sort: Desc)], map: "post_op_instruction_deliveries_tenant_patient_idx")
  @@index([tenantId, appointmentId], map: "post_op_instruction_deliveries_tenant_appointment_idx")
  @@index([tenantId, templateId], map: "post_op_instruction_deliveries_template_idx")
  @@index([tenantId, locationId], map: "post_op_instruction_deliveries_location_idx")
  @@index([deliveredById], map: "post_op_instruction_deliveries_delivered_by_idx")
  @@map("post_op_instruction_deliveries")
}

// ---------------------------------------------------------------------------
// Importación de pacientes desde CSV/XLSX (DX-107)
// ---------------------------------------------------------------------------

/// Estado de un lote: VALIDATED (dry-run hecho, sin escribir pacientes) →
/// QUEUED (confirmado, en la cola) → RUNNING → COMPLETED | FAILED; UNDONE tras
/// «Deshacer lote»; EXPIRED si nadie lo confirmó a tiempo (o se subió otro).
enum PatientImportStatus {
  VALIDATED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  UNDONE
  EXPIRED
}

/// Qué hacer con un paciente que ya existe (mismo tipo y nº de documento).
enum PatientImportDuplicateMode {
  /// No tocarlo.
  SKIP
  /// Rellenar SOLO los campos que tiene vacíos; nunca pisa un dato.
  FILL_EMPTY
}

enum PatientImportFileFormat {
  CSV
  XLSX
}

/// Resultado de una fila preparada del lote.
enum PatientImportRowOutcome {
  PENDING
  CREATED
  FILLED
  SKIPPED
  FAILED
}

/// Un fichero subido por un ADMIN y su resultado. NO guarda el fichero: su
/// nombre, tamaño y SHA-256, el mapeo de columnas, los totales y los errores
/// por fila (lo que necesita el informe). RLS FORCE por tenant.
model PatientImportBatch {
  id             String                      @id @default(uuid()) @db.Uuid
  tenantId       String                      @db.Uuid
  /// Puntero suave a User (quién subió el fichero), como `createdById` de Patient.
  createdById    String                      @db.Uuid
  /// Sede por defecto del lote: la activa al subirlo (o la de escritura). Da
  /// el indicativo del país para normalizar los teléfonos y la usarán las
  /// citas futuras importadas (DX-263). El paciente no es de ninguna sede.
  locationId     String                      @db.Uuid
  fileName       String
  /// SHA-256 en hex del fichero tal como llegó.
  fileSha256     String                      @db.Char(64)
  fileFormat     PatientImportFileFormat
  fileSizeBytes  Int
  status         PatientImportStatus         @default(VALIDATED)
  /// Se elige al confirmar.
  duplicateMode  PatientImportDuplicateMode?
  /// Campo de Dentalix → cabecera del fichero, y el tipo de documento por defecto.
  columnMapping  Json
  totalRows      Int
  /// Filas nuevas que se pueden crear.
  validRows      Int
  /// Ya existen en la clínica (BD) o se repiten en el propio fichero.
  duplicateRows  Int
  errorRows      Int
  /// Filas que el trabajo procesará: las válidas y las duplicadas contra la BD.
  preparedRows   Int
  /// Filas preparadas (válidas + duplicadas contra la BD) ya procesadas por el trabajo.
  processedRows  Int                         @default(0)
  createdCount   Int                         @default(0)
  updatedCount   Int                         @default(0)
  skippedCount   Int                         @default(0)
  failedCount    Int                         @default(0)
  /// Errores y duplicados por fila: [{ row, column, kind, message, value }].
  issues         Json                        @default("[]")
  confirmedById  String?                     @db.Uuid
  confirmedAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  undoneById     String?                     @db.Uuid
  undoneAt       DateTime?
  /// Cuántos pacientes retiró y cuántos rellenados revirtió el deshacer.
  undoneCreated  Int?
  undoneFilled   Int?
  /// Cuándo se vaciaron los errores por fila (caducado o 90 días después de
  /// terminar o deshacer): el informe ya no está disponible.
  issuesPurgedAt DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  // DX-262: hoja de saldos («Saldo migrado») del lote, opcional. Se sube con
  // el lote VALIDATED (dry-run propio) y se importa al confirmar, después de
  // los pacientes. El fichero tampoco se guarda: nombre, hash y totales.
  balanceFileName       String?
  balanceFileSha256     String?                  @db.Char(64)
  balanceFileFormat     PatientImportFileFormat?
  balanceFileSizeBytes  Int?
  balanceTotalRows      Int                      @default(0)
  /// Filas con error (importe, moneda, fecha, documento inexistente…).
  balanceErrorRows      Int                      @default(0)
  /// Filas sumadas a otra del mismo paciente y moneda.
  balanceMergedRows     Int                      @default(0)
  /// Saldos a crear (uno por paciente y moneda).
  balancePreparedRows   Int                      @default(0)
  balanceProcessedRows  Int                      @default(0)
  balanceCreatedCount   Int                      @default(0)
  /// Saldos no creados al importar (su paciente no llegó a existir).
  balanceSkippedCount   Int                      @default(0)
  /// [{ currency, rows, cents }]: todas las filas con importe y moneda legibles.
  balanceFileTotals     Json                     @default("[]")
  /// [{ currency, rows, cents }]: lo que se importa.
  balanceValidTotals    Json                     @default("[]")
  /// Errores y avisos por fila de la hoja (mismo formato que `issues`).
  balanceIssues         Json                     @default("[]")
  /// Saldos migrados que retiró el deshacer.
  balanceUndoneCount    Int?
  /// [{ currency, rows, cents }] de los saldos que retiró de verdad el deshacer.
  balanceUndoneTotals   Json                     @default("[]")
  /// Saldos no creados porque su documento era de varios pacientes vivos.
  balanceAmbiguousCount Int                      @default(0)
  /// «Añadir aunque ya tenga saldo migrado» (QA D1): sin marcar, un paciente con
  /// un saldo migrado vivo de otro lote en esa moneda no recibe otro.
  balanceAddToExisting  Boolean                  @default(false)
  /// Saldos no creados al importar porque el paciente ya tenía uno vivo (QA D1).
  balanceExistingCount  Int                      @default(0)

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location        Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "patient_import_batches_location_fkey")
  rows            PatientImportRow[]
  patients        Patient[]
  balanceRows     PatientImportBalanceRow[]
  openingBalances OpeningBalance[]

  @@unique([tenantId, id], map: "patient_import_batches_tenant_id_key")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "patient_import_batches_tenant_created_idx")
  @@index([tenantId, locationId], map: "patient_import_batches_tenant_location_idx")
  // Índice único PARCIAL que Prisma no expresa (no se declara):
  //   patient_import_batches_one_active_key ("tenantId")
  //     WHERE status IN ('QUEUED', 'RUNNING')
  //     -> una importación en marcha por clínica.
  @@map("patient_import_batches")
}

/// Fila preparada del lote: lo que el trabajo va a crear o rellenar. `data`
/// (los valores normalizados) se vacía al procesarla o al caducar el lote;
/// `filledValues` guarda solo lo que rellenó en un paciente existente, para
/// poder revertirlo al deshacer.
model PatientImportRow {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @db.Uuid
  batchId      String                  @db.Uuid
  /// Fila del fichero tal como la numera la hoja (1..1.048.576).
  rowNumber    Int
  data         Json?
  outcome      PatientImportRowOutcome @default(PENDING)
  patientId    String?                 @db.Uuid
  filledValues Json?
  processedAt  DateTime?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch   PatientImportBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict, map: "patient_import_rows_batch_fkey")
  patient Patient?           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "patient_import_rows_patient_fkey")

  @@unique([tenantId, batchId, rowNumber], map: "patient_import_rows_tenant_batch_row_key")
  @@index([tenantId, patientId], map: "patient_import_rows_tenant_patient_idx")
  @@map("patient_import_rows")
}

/// DX-262: saldo de la hoja de saldos preparado por el dry-run (uno por
/// paciente y moneda, ya sumadas las filas repetidas). El trabajo lo convierte
/// en un `OpeningBalance` al importar, buscando al paciente por `docKey`.
model PatientImportBalanceRow {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  batchId     String                  @db.Uuid
  /// Primera fila del fichero que lo forma.
  rowNumber   Int
  /// Clave del documento del paciente (`docKey`: mayúsculas, solo letras y dígitos).
  docKey      String
  currency    String
  amount      Decimal                 @db.Decimal(14, 2)
  /// NULL: el fichero no traía fecha; se usará el día de la importación.
  asOfDate    DateTime?               @db.Date
  concept     String?
  sourceRows  Int                     @default(1)
  outcome     PatientImportRowOutcome @default(PENDING)
  patientId   String?                 @db.Uuid
  processedAt DateTime?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch   PatientImportBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict, map: "patient_import_balance_rows_batch_fkey")
  patient Patient?           @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "patient_import_balance_rows_patient_fkey")

  @@unique([tenantId, batchId, docKey, currency], map: "patient_import_balance_rows_tenant_batch_doc_key")
  @@index([tenantId, batchId, outcome, rowNumber], map: "patient_import_balance_rows_tenant_batch_outcome_idx")
  @@index([tenantId, patientId], map: "patient_import_balance_rows_tenant_patient_idx")
  @@map("patient_import_balance_rows")
}

/// DX-262: saldo inicial «Saldo migrado» de un paciente en una moneda, traído
/// de su programa anterior con un lote de importación. Entra en el estado de
/// cuenta (DX-011) y en la cartera por antigüedad (DX-145) desde `asOfDate`.
/// Inmutable salvo su retirada (`voidedAt`, al deshacer el lote): trigger
/// `opening_balances_guard`. Hoy ningún abono se le imputa (DX-051).
model OpeningBalance {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  /// Sede del lote (la activa al subirlo): sede de la deuda si el paciente no
  /// tiene citas atendidas, abonos ni planes presentados.
  locationId          String    @db.Uuid
  patientId           String    @db.Uuid
  importBatchId       String    @db.Uuid
  currency            String
  amount              Decimal   @db.Decimal(14, 2)
  /// Día civil desde el que cuenta la deuda (fecha de corte).
  asOfDate            DateTime  @db.Date
  /// `asOfDate` es el día de la importación: el fichero no traía fecha.
  asOfDateApproximate Boolean   @default(false)
  concept             String
  /// Filas del fichero sumadas en este saldo.
  sourceRows          Int       @default(1)
  /// Puntero suave a User (quién confirmó el lote).
  createdById         String    @db.Uuid
  createdAt           DateTime  @default(now())
  voidedAt            DateTime?
  voidedById          String?   @db.Uuid

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location    Location           @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "opening_balances_location_fkey")
  patient     Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "opening_balances_patient_fkey")
  batch       PatientImportBatch @relation(fields: [tenantId, importBatchId], references: [tenantId, id], onDelete: Restrict, map: "opening_balances_batch_fkey")
  currencyRef Currency           @relation(fields: [currency], references: [code], onDelete: Restrict, map: "opening_balances_currency_fkey")
  /// Abonos registrados contra este saldo (vivos: `deletedAt` NULL).
  payments    Payment[]

  @@unique([tenantId, id], map: "opening_balances_tenant_id_key")
  @@unique([tenantId, id, patientId], map: "opening_balances_tenant_id_patient_key")
  @@unique([tenantId, importBatchId, patientId, currency], map: "opening_balances_tenant_batch_patient_currency_key")
  @@index([tenantId, patientId], map: "opening_balances_tenant_patient_idx")
  @@index([tenantId, locationId], map: "opening_balances_tenant_location_idx")
  @@map("opening_balances")
}

// DX-256: historial de ítems agendados; active se mantiene con triggers.
model AppointmentPlanItem {
  deletedAt     DateTime?
  tenantId      String            @db.Uuid
  patientId     String            @db.Uuid
  appointmentId String            @db.Uuid
  planItemId    String            @db.Uuid
  active        Boolean           @default(false)
  createdAt     DateTime          @default(now())
  appointment   Appointment       @relation(fields: [tenantId, patientId, appointmentId], references: [tenantId, patientId, id], onDelete: Cascade)
  planItem      TreatmentPlanItem @relation(fields: [tenantId, patientId, planItemId], references: [tenantId, patientId, id], onDelete: Restrict)

  @@id([tenantId, appointmentId, planItemId])
  @@index([tenantId, planItemId, appointmentId])
  @@map("appointment_plan_items")
}

// DX-273: cada salida de una cita de COMPLETED (a agendada, cancelada…), con
// el motivo que escribió ADMIN/DENTIST. El `audit_event` COMPLETED_EXIT
// apunta aquí por id (`params.reversalId`): la auditoría no guarda texto libre.
// Solo SELECT/INSERT para la app (evidencia); RLS FORCE por tenant.
model AppointmentStatusReversal {
  id            String            @id @default(uuid(7)) @db.Uuid
  tenantId      String            @db.Uuid
  patientId     String            @db.Uuid
  appointmentId String            @db.Uuid
  fromStatus    AppointmentStatus
  toStatus      AppointmentStatus
  reason        String            @db.VarChar(500)
  actorUserId   String            @db.Uuid
  createdAt     DateTime          @default(dbgenerated("timezone('UTC'::text, now())"))
  appointment   Appointment       @relation(fields: [tenantId, patientId, appointmentId], references: [tenantId, patientId, id], onDelete: Cascade, map: "appointment_status_reversals_appointment_fkey")
  actor         User              @relation("AppointmentStatusReversalActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "appointment_status_reversals_actor_fkey")

  @@index([tenantId, appointmentId, createdAt], map: "appointment_status_reversals_appointment_idx")
  @@index([actorUserId], map: "appointment_status_reversals_actor_idx")
  @@map("appointment_status_reversals")
}
