  /// Destino de la FK de `expense_payments`: su sede y su moneda son las del gasto.
  @@unique([tenantId, id, locationId, currency], map: "expenses_tenant_id_location_currency_key")
  @@index([tenantId, locationId, invoiceDate(sort: Desc), id(sort: Desc)], map: "expenses_tenant_location_invoice_idx")
  @@map("expenses")
}

/// DX-316 (G1.5): días hábiles de la sede para los plazos en días hábiles.
/// 1:1 con Location (R2); la crea el trigger de alta de sede
/// (`locations_default_working_calendar`) con
/// `dx_location_default_working_weekdays()`, el único sitio con el valor por
/// defecto. No es el horario de atención (LocationSchedule), que decide cuándo
/// se puede citar (R4). RLS FORCE por tenant.
///
/// Solo SQL: CHECK de `workingWeekdays` (una dimensión, 1 a 7 días entre 0 y
/// 6, sin NULL) y trigger `location_working_calendars_server_created_at`
/// (hora UTC de la BD). ON DELETE CASCADE con la sede: la app nunca la borra
/// en duro; solo las limpiezas de test.
model LocationWorkingCalendar {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  locationId      String   @db.Uuid
  /// 0 = domingo … 6 = sábado (civilWeekday), ordenados y sin repetidos; 1–7 días.
  workingWeekdays Int[]    @db.SmallInt
  /// La pone el servidor de BD (trigger), en UTC.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade, map: "location_working_calendars_location_fkey")

  @@unique([tenantId, locationId], map: "location_working_calendars_tenant_location_key")
  @@map("location_working_calendars")
}

/// DX-316 (G1.5): festivo de la sede. Puntual (esa fecha) o recurrente (cada
/// año ese mes y día, R6). RLS FORCE por tenant.
