  /// siga siéndolo.
  currency        String
  /// El `paidOn` con que se convirtió.
  rateDate        DateTime @db.Date
  manual          Boolean  @default(false)
  /// La pone el servidor de BD (trigger), en UTC.
  createdAt       DateTime @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment     Payment             @relation(fields: [tenantId, paymentId, treatmentPlanId], references: [tenantId, id, treatmentPlanId], onDelete: Restrict, onUpdate: Restrict, map: "payment_plan_amounts_payment_fkey")
  currencyRef Currency            @relation(fields: [currency], references: [code], map: "payment_plan_amounts_currency_fkey")
  allocations PaymentAllocation[]

  /// Destino de la FK de `payment_allocations`.
  @@unique([tenantId, paymentId], map: "payment_plan_amounts_tenant_payment_key")
  @@index([tenantId, treatmentPlanId], map: "payment_plan_amounts_tenant_plan_idx")
  @@index([currency], map: "payment_plan_amounts_currency_idx")
  @@map("payment_plan_amounts")
}

/// Imputación VIVA de un abono a un ítem de su plan (DX-051), en la moneda del
/// plan. Anular, reasignar o liberar borra o reduce filas; el historial queda
/// en `payment_allocation_movements`. RLS FORCE por tenant.
///
/// Solo SQL: CHECK `amount > 0` (payment_allocations_amount_check), triggers
/// `payment_allocations_guard` (un UPDATE solo cambia `amount`; Σ de un ítem <=
/// su facturable, Σ de un abono <= su base, abono vivo, moneda vigente del
/// plan; pone `updatedAt` en UTC), `payment_allocations_movements` y
/// `payment_allocations_server_created_at`; GRANT UPDATE solo de `amount` y
/// `updatedAt`. Lo liberan los triggers `treatment_plan_items_allocations` y
/// `treatment_plans_allocations` (función `dx_release_item_allocations`).
model PaymentAllocation {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  tenantId            String                  @db.Uuid
  paymentId           String                  @db.Uuid
  treatmentPlanId     String                  @db.Uuid
  treatmentPlanItemId String                  @db.Uuid
  amount              Decimal                 @db.Decimal(14, 2)
  source              PaymentAllocationSource
  /// Puntero suave a User: autor del abono o quien dispara el reparto (null en
  /// el backfill y en el barrido); el ADMIN en MANUAL.
  createdById         String?                 @db.Uuid
  /// La pone el servidor de BD (trigger), en UTC.
  createdAt           DateTime                @default(now())
  /// La pone el guard de la BD en cada UPDATE, en UTC (sin @updatedAt).
  updatedAt           DateTime                @default(now())

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  base    PaymentPlanAmount @relation(fields: [tenantId, paymentId], references: [tenantId, paymentId], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocations_base_fkey")
  payment Payment           @relation(fields: [tenantId, paymentId, treatmentPlanId], references: [tenantId, id, treatmentPlanId], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocations_payment_fkey")
  item    TreatmentPlanItem @relation(fields: [tenantId, treatmentPlanItemId, treatmentPlanId], references: [tenantId, id, planId], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocations_item_fkey")
  plan    TreatmentPlan     @relation(fields: [tenantId, treatmentPlanId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocations_plan_fkey")

  @@unique([tenantId, paymentId, treatmentPlanItemId], map: "payment_allocations_tenant_payment_item_key")
  @@index([tenantId, treatmentPlanItemId], map: "payment_allocations_tenant_item_idx")
  @@index([tenantId, treatmentPlanId], map: "payment_allocations_tenant_plan_idx")
  @@map("payment_allocations")
}

/// Plan con reparto de sobrantes pendiente (DX-051). Cola de SOLO-INSERCIÓN:
/// `INSERT` simple, sin ON CONFLICT; varias filas por plan son normales. El
/// reparto borra solo los ids que leyó. Cae con su plan (ON DELETE CASCADE).
/// RLS FORCE por tenant. Solo SQL: trigger
/// `plan_allocation_rebalance_requests_server_created_at` (UTC).
model PlanAllocationRebalanceRequest {
  id              BigInt   @id @default(autoincrement())
  tenantId        String   @db.Uuid
  treatmentPlanId String   @db.Uuid
  /// La pone el servidor de BD (trigger), en UTC.
  requestedAt     DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   TreatmentPlan @relation(fields: [tenantId, treatmentPlanId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict, map: "plan_allocation_rebalance_requests_plan_fkey")

  @@index([tenantId, treatmentPlanId], map: "plan_allocation_rebalance_requests_tenant_plan_idx")
  @@map("plan_allocation_rebalance_requests")
}

/// Historial de la imputación (DX-051), de SOLO-INSERCIÓN: cada cambio de una
/// fila de `payment_allocations` deja su delta en céntimos y su causa (`AUTO`,
/// `MANUAL`, `RELEASE`, `VOID`; GUC local `app.allocation_cause`). Lo escribe
/// el trigger `payment_allocations_movements`. Permite reconstruir lo imputado
/// a un ítem en cualquier fecha (DX-018). RLS FORCE por tenant.
///
/// Solo SQL: CHECK `deltaCents <> 0` y de `cause`; id por defecto
/// `dx051_uuid_v7()`; triggers `payment_allocation_movements_append_only`
/// (DELETE solo superusuario) y `payment_allocation_movements_server_created_at`.
model PaymentAllocationMovement {
  id                  String   @id @default(dbgenerated("dx051_uuid_v7()")) @db.Uuid
  tenantId            String   @db.Uuid
  paymentId           String   @db.Uuid
  treatmentPlanId     String   @db.Uuid
  treatmentPlanItemId String   @db.Uuid
  deltaCents          BigInt
  /// AUTO | MANUAL | RELEASE | VOID (CHECK).
  cause               String
  /// La pone el servidor de BD (trigger), en UTC.
  at                  DateTime @default(now())

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment Payment           @relation(fields: [tenantId, paymentId, treatmentPlanId], references: [tenantId, id, treatmentPlanId], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocation_movements_payment_fkey")
  item    TreatmentPlanItem @relation(fields: [tenantId, treatmentPlanItemId, treatmentPlanId], references: [tenantId, id, planId], onDelete: Restrict, onUpdate: Restrict, map: "payment_allocation_movements_item_fkey")

  @@index([tenantId, paymentId, treatmentPlanId], map: "payment_allocation_movements_tenant_payment_idx")
  @@index([tenantId, treatmentPlanItemId, treatmentPlanId, at], map: "payment_allocation_movements_tenant_item_at_idx")
  @@map("payment_allocation_movements")
}
