/// Gasto de una sede (DX-274): factura o cuenta por pagar con su soporte. El
/// estado (PENDING, PARTIAL, PAID, VOIDED) NO se guarda: sale de `voidedAt` y
/// de la suma de sus pagos vivos. Anular = no borrar (sin DELETE en la BD).
/// El soporte (`attachment*`) se fija una sola vez (trigger). RLS FORCE.
///
/// Solo SQL (Prisma no expresa los CHECK ni los triggers): importes > 0,
/// `dueDate >= invoiceDate`, soporte completo o vacío, anulación completa o
/// vacía; triggers `expenses_guard` (sin DELETE, soporte y anulación una vez)
/// y `expenses_server_created_at` (hora UTC de la BD).
model Expense {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
