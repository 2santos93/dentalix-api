generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                        String                          @id @default(uuid()) @db.Uuid
  name                      String
  subdomain                 String                          @unique
  primaryColor              String                          @default("#0F5E9C")
  logoUrl                   String?
  // DX-128: canal de los avisos automáticos con el que nace cada paciente.
  defaultContactChannel     ContactChannel                  @default(EMAIL)
  // DX-027: ajustes de caja de la clínica. Por defecto, el comportamiento de
  // antes de la caja por turno: se cobra en efectivo sin caja abierta y el
  // cierre enseña el esperado mientras se cuenta.
  cashRequireOpenSession    Boolean                         @default(false)
  cashBlindClose            Boolean                         @default(false)
  // DX-233: cita fuera del horario del profesional. false (defecto) = se
  // agenda con el aviso PROVIDER_OFF_SCHEDULE; true = 409.
  providerScheduleStrict    Boolean                         @default(false)
  // DX-247: meses que vale una anamnesis (o su última confirmación «Sin
  // cambios hoy») antes de salir «Anamnesis caducada». CHECK 1..60 en la BD.
  anamnesisValidityMonths   Int                             @default(12)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  deletedAt                 DateTime?
  memberships               ClinicMembership[]
  domains                   TenantDomain[]
  invitations               ClinicInvitation[]
  appointmentConfirmations  AppointmentConfirmation[]
  privacyPolicyVersions     PrivacyPolicyVersion[]
  dataProcessingConsents    DataProcessingConsent[]
  consentTemplates          ConsentTemplate[]
  prescriptionTemplates     PrescriptionTemplate[]
  emailOutbox               EmailOutbox[]
  clinicalEntryAddenda      ClinicalEntryAddendum[]
  // DX-212: diagnósticos CIE-10 de las evoluciones.
  clinicalEntryDiagnoses    ClinicalEntryDiagnosis[]
  dentitionEvents           PatientDentitionEvent[]
  appointmentTypes          AppointmentType[]
  jobs                      Job[]
  outboundMessages          OutboundMessage[]
  scheduleBlocks            ScheduleBlock[]
  waitlistEntries           AppointmentWaitlistEntry[]
  // DX-210: ofertas de huecos libres a candidatos.
  waitlistOffers            WaitlistOffer[]
  reminderSettings          LocationReminderSettings[]
  appointmentReminders      AppointmentReminder[]
  paymentReceipts           PaymentReceipt[]
  paymentReceiptCounters    PaymentReceiptCounter[]
  reminderOptOutLinks       ReminderOptOutLink[]
  clinicalNoteTemplates     ClinicalNoteTemplate[]
  // DX-150: cobranza (notas y compromisos de pago).
  collectionNotes           CollectionNote[]
  // DX-203: responsables de pago y avisos de los pacientes.
  patientResponsibleParties PatientResponsibleParty[]
  // DX-153: pagadores de la clínica y coberturas de sus pacientes.
  payers                    Payer[]
  patientCoverages          PatientCoverage[]
  // DX-105: listas de precios, convenios y su asignación a pacientes.
  priceLists                PriceList[]
  priceListItems            PriceListItem[]
  agreements                Agreement[]
  patientAgreements         PatientAgreement[]
  paymentPromises           PaymentPromise[]
  platformAccesses          PlatformAccessAudit[]
  // DX-204: topes de descuento por rol (una fila; sin ella, los de por defecto).
  discountPolicy            DiscountPolicy?
  // DX-027: cajas por turno.
  cashSessions              CashSession[]
  // DX-222: indicaciones postoperatorias (plantillas, vínculos y entregas).
  postOpTemplates           PostOpInstructionTemplate[]
  postOpTemplateLinks       PostOpInstructionTemplateLink[]
  postOpDeliveries          PostOpInstructionDelivery[]
  // DX-151: documentos de los pacientes.
  patientDocuments          PatientDocument[]
  // DX-233: horario de cada profesional por sede y sus excepciones por fecha.
  providerSchedules         ProviderSchedule[]
  providerScheduleOverrides ProviderScheduleOverride[]
  // DX-247: confirmaciones «Sin cambios hoy» de la anamnesis.
  medicalHistoryReviews     MedicalHistoryReview[]
  // DX-107: lotes de importación de pacientes y sus filas.
  patientImportBatches      PatientImportBatch[]
  patientImportRows         PatientImportRow[]
  // DX-262: hoja de saldos del importador y saldos migrados.
  patientImportBalanceRows  PatientImportBalanceRow[]
  openingBalances           OpeningBalance[]

  @@map("tenants")
}

model User {
  id                      String             @id @default(uuid()) @db.Uuid
  email                   String             @unique
  passwordHash            String
  fullName                String
  // DX-084: CLAVE del fichero en el almacén (`avatars/<id>.<ext>`), nunca
  // una URL; la URL pública se calcula al responder. La columna conserva su
  // nombre de antes (`avatarUrl`) para que la migración sea aditiva.
  avatarKey               String?            @map("avatarUrl")
  emailVerifiedAt         DateTime?
  // Superadmin de PLATAFORMA: transversal a todos los tenants (por eso no es
  // un ClinicRole, que siempre es por-clínica vía ClinicMembership). Se otorga
  // SOLO por migración; ningún endpoint lo concede.
  isPlatformAdmin         Boolean            @default(false)
  // Versión de sesión: viaja en el claim `tv` de cada token y /auth/refresh
  // exige que coincida. Incrementarla invalida TODOS los refresh tokens del
  // usuario a la vez (lo hace el cambio de contraseña). Los tokens anteriores
  // a esta columna no traen `tv` y cuentan como 0.
  tokenVersion            Int                @default(0)
  // SEC-008: MFA (TOTP) del superadmin, exigido para el acceso break-glass a
  // una clínica sin membresía. Los secretos van cifrados (AES-256-GCM con
  // MFA_ENCRYPTION_KEY y el id del usuario como AAD); nunca en claro.
  // `mfaTotpPendingSecretEnc`: alta pedida y aún sin confirmar con un código.
  // `mfaLastUsedStep`: último paso TOTP aceptado (anti-reutilización).
  mfaTotpSecretEnc        String?
  mfaTotpPendingSecretEnc String?
  mfaEnabledAt            DateTime?
  mfaLastUsedStep         Int?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?
  memberships             ClinicMembership[]

  privacyPoliciesPublished   PrivacyPolicyVersion[]
  dataConsentsRecorded       DataProcessingConsent[]
  perioExamsPerformed        PerioExam[]
  prescriptionsIssued        Prescription[]              @relation("PrescriptionProfessional")
  prescriptionsVoided        Prescription[]              @relation("PrescriptionVoidedBy")
  // DX-191: implantes colocados, anulados y tarjetas entregadas.
  implantsPlaced             PatientImplant[]            @relation("PatientImplantProfessional")
  implantsVoided             PatientImplant[]            @relation("PatientImplantVoidedBy")
  implantCardsDelivered      PatientImplant[]            @relation("PatientImplantCardDeliveredBy")
  // DX-151: documentos del paciente subidos y anulados.
  uploadedPatientDocuments   PatientDocument[]           @relation("PatientDocumentUploadedBy")
  voidedPatientDocuments     PatientDocument[]           @relation("PatientDocumentVoidedBy")
  planAcceptancesRecorded    TreatmentPlanAcceptance[]
  tokens                     UserToken[]
  clinicalEntryAddenda       ClinicalEntryAddendum[]
  dentitionEventsRecorded    PatientDentitionEvent[]
  retentionActions           PatientRetentionAction[]
  platformAccesses           PlatformAccessAudit[]
  // DX-204: descuentos dados en ítems de plan y cambios de la política.
  planItemDiscounts          TreatmentPlanItem[]         @relation("TreatmentPlanItemDiscountBy")
  discountPoliciesUpdated    DiscountPolicy[]
  // DX-220: acciones de plataforma del superadmin (reencolar un trabajo).
  platformAuditEvents        PlatformAuditEvent[]
  // DX-222: indicaciones postoperatorias entregadas.
  postOpDeliveries           PostOpInstructionDelivery[]
  // DX-273: salidas de citas de COMPLETED (con motivo).
  appointmentStatusReversals AppointmentStatusReversal[] @relation("AppointmentStatusReversalActor")

  @@map("users")
}

enum ClinicRole {
  DENTIST
  ASSISTANT
  RECEPTION
  ADMIN
}

/// Sede/sucursal física de una clínica. La sede es una dimensión de filtrado
/// DENTRO del tenant, no un nivel de aislamiento: el RLS por tenant sigue
/// siendo la frontera dura. Pacientes, historia y catálogo NO llevan sede —
/// la ficha del paciente es de la clínica (ver docs/plans/2026-08-01-multi-sede.md).
/// País donde opera una sede (DX-013). Decide los campos legales obligatorios
/// de la receta: CO (Dec. 780/2016 art. 2.5.3.10.16) o ES (RD 1718/2010 art. 3).
enum ClinicCountry {
  CO
  ES
}

model Location {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @db.Uuid
  name                 String
  address              String?
  // País de la sede (DX-013): la receta se emite con las reglas del país donde
  // se atiende. Por defecto CO, que es lo que eran todas las sedes hasta hoy.
  country              ClinicCountry @default(CO)
  // Serie de los recibos de caja de la sede (DX-136), p. ej. "NOR". Si no
  // viene al crearla, el trigger `locations_default_receipt_prefix` la deriva
  // del nombre (3 letras, con número si ya la usa otra sede de la clínica).
  // Única por clínica, también entre sedes retiradas: nunca se reutiliza.
  // DX-226: con recibos o contador ya no cambia (trigger
  // `locations_receipt_prefix_guard`, check_violation) y ninguna sede toma
  // una serie que ya numeró recibos en la clínica.
  receiptPrefix        String?
  // DX-212: código de habilitación REPS de la sede (12 dígitos, CHECK
  // locations_reps_habilitation_code_format). Lo pide el RDA (Res. 1888/2025)
  // en las sedes de Colombia; solo lo edita ADMIN.
  repsHabilitationCode String?
  // DX-222: teléfono de la sede para las indicaciones postoperatorias
  // («llama a la clínica al …»). Hasta 40 caracteres (CHECK
  // locations_phone_length_check).
  phone                String?
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  clinicalEntries           ClinicalEntry[]
  appointments              Appointment[]
  payments                  Payment[]
  inventoryItems            InventoryItem[]
  inventoryMovements        InventoryMovement[]
  prescriptions             Prescription[]
  // DX-191: implantes colocados en la sede.
  patientImplants           PatientImplant[]
  // DX-151: documentos del paciente subidos en la sede.
  patientDocuments          PatientDocument[]
  // DX-107: lotes de importación de pacientes con esta sede por defecto.
  patientImportBatches      PatientImportBatch[]
  // DX-262: saldos migrados registrados en la sede.
  openingBalances           OpeningBalance[]
  planAcceptances           TreatmentPlanAcceptance[]
  presentedPlans            TreatmentPlan[]
  // DX-122: bloqueos de agenda y pendientes por agendar de la sede.
  scheduleBlocks            ScheduleBlock[]
  waitlistEntries           AppointmentWaitlistEntry[]
  waitlistOffers            WaitlistOffer[]
  reminderSettings          LocationReminderSettings[]
  paymentReceipts           PaymentReceipt[]
  collectionNotes           CollectionNote[]
  paymentPromises           PaymentPromise[]
  // DX-204: sede donde se dio el descuento de un ítem de plan.
  planItemDiscounts         TreatmentPlanItem[]         @relation("TreatmentPlanItemDiscountLocation")
  // DX-105: ítems de plan cuyo precio se resolvió con esta sede.
  planItemPricings          TreatmentPlanItem[]         @relation("TreatmentPlanItemPricingLocation")
  // DX-027: cajas por turno de la sede y sus ajustes.
  cashSessions              CashSession[]
  cashAdjustments           CashSessionAdjustment[]
  // DX-089: miembros restringidos a la sede.
  membershipLocations       MembershipLocation[]
  // DX-222: indicaciones postoperatorias entregadas en la sede.
  postOpDeliveries          PostOpInstructionDelivery[]
  // DX-105: listas y convenios de la sede.
  priceLists                PriceList[]
  agreements                Agreement[]
  // DX-233: horario de los profesionales en la sede y sus excepciones.
  providerSchedules         ProviderSchedule[]
  providerScheduleOverrides ProviderScheduleOverride[]

  // Destino de las FK compuestas (tenantId, locationId) de citas, pagos e
  // inventario: la sede tiene que ser del MISMO tenant (SEC-004).
  @@unique([tenantId, id], map: "locations_tenant_id_key")
  @@unique([tenantId, receiptPrefix], map: "locations_tenant_receipt_prefix_key")
  // DX-043 (DB-017): sin @@index([tenantId]); era prefijo exacto de
  // locations_tenant_id_key (tenantId, id) y se retiró en 20261017114000_patient_search_and_list_indexes.
  @@map("locations")
}

model ClinicMembership {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  userId              String               @db.Uuid
  role                ClinicRole
  // Registro profesional (CO: RETHUS / tarjeta profesional) o nº de colegiado
  // (ES) del miembro EN ESTA CLÍNICA (DX-013). Lo exige la receta.
  professionalLicense String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  // DX-089: sedes a las que se restringe el miembro (sin filas = todas).
  locations           MembershipLocation[]

  // PARTIAL unique (WHERE "deletedAt" IS NULL) — a soft-deleted membership must
  // NOT block re-adding the same user. The predicate lives in migration
  // 20260731163000_clinic_membership_partial_unique (Prisma can't express it);
  // the name/columns here keep migrate-status drift-free. Same pattern as
  // users_email_key. Do NOT accept a migrate-dev diff that makes this full again.
  @@unique([tenantId, userId])
  // Destino de la FK compuesta (tenantId, membershipId) de membership_locations
  // (SEC-004): la membresía tiene que ser del MISMO tenant.
  @@unique([tenantId, id], map: "clinic_memberships_tenant_id_key")
  @@index([tenantId])
  @@map("clinic_memberships")
}

/// DX-089: sede a la que se restringe un miembro de la clínica. Sin filas, el
/// miembro trabaja en todas las sedes; con filas, solo en esas. Borrar la
/// membresía borra sus filas (CASCADE); la sede no se borra mientras tenga
/// filas (RESTRICT). FK compuestas por tenant (SEC-004) y RLS FORCE.
model MembershipLocation {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  membershipId String           @db.Uuid
  locationId   String           @db.Uuid
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  membership   ClinicMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  location     Location         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, membershipId, locationId], map: "membership_locations_member_location_key")
  @@index([tenantId, locationId])
  @@map("membership_locations")
}

model ClinicInvitation {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  email       String
  fullName    String
  role        ClinicRole
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Único PARCIAL (solo pendientes) — el WHERE vive en la migración
  // 20260801120000_add_clinic_invitations; Prisma no lo expresa. Declarado
  // aquí con el mismo nombre/columnas para que migrate status no vea drift.
  // NO aceptar un diff de migrate dev que lo recree sin el WHERE.
  @@unique([tenantId, email], map: "clinic_invitations_pending_key")
  @@index([tenantId])
  @@index([tokenHash])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("clinic_invitations")
}

enum DocType {
  CC
  TI
  CE
  PASSPORT
  OTHER
}

enum Sex {
  M
  F
  OTHER
  UNSPECIFIED
}

model Patient {
  id                           String                @id @default(uuid()) @db.Uuid
  tenantId                     String                @db.Uuid
  firstName                    String
  lastName                     String
  docType                      DocType               @default(CC)
  docNumber                    String?
  birthDate                    DateTime?
  sex                          Sex                   @default(UNSPECIFIED)
  phone                        String?
  email                        String?
  address                      String?
  countryCode                  String?
  cityId                       Int?
  notes                        String?
  // DEPRECADO (DX-037): resumen DERIVADO de la última fila GENERAL de
  // `data_processing_consents`, que es la prueba de la autorización Ley 1581.
  // Se sigue escribiendo (en la misma transacción que la fila) solo para no
  // romper a los clientes que lo leen; nunca es la fuente de verdad.
  dataConsentAccepted          Boolean               @default(false)
  dataConsentAt                DateTime?
  dataConsentPolicyVersion     String?
  // Identificación ampliada.
  maritalStatus                String?
  occupation                   String?
  // DEPRECADO (DX-153): solo lectura; el pagador vive en patient_coverages
  // (la migración 20261020210200 copió cada valor a un pagador y una
  // cobertura principal con `migratedFromInsurerEps`).
  insurerEps                   String?
  physicianName                String?
  physicianPhone               String?
  // Contacto de emergencia / acudiente.
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  // DEPRECADO (DX-203): solo lectura. El acudiente vive ahora en
  // `patient_responsible_parties` (la migración 20261018150100 copió cada
  // valor a un contacto responsable con `migratedFromGuardian`). La API ya no
  // los escribe; se conservan para no perder el dato ni romper a quien los lee.
  guardianName                 String?
  guardianDocNumber            String?
  createdById                  String?               @db.Uuid
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt
  deletedAt                    DateTime?
  // DX-043: columna GENERADA (STORED) para la búsqueda: nombre, apellido y
  // documento sin tildes, en minúsculas y con espacios colapsados
  // (dx_search_normalize). La calcula Postgres; la app nunca la escribe ni la
  // lee (@ignore): se consulta solo desde dx_patient_search_ids/_count. Ver
  // docs/adr/0001-busqueda-pacientes-rls.md.
  // DX-039: retención legal de la HC (Res. 839/2017). `lastAttentionAt` lo
  // mantienen triggers de BD (evolución insertada / cita COMPLETED) y nunca
  // retrocede; la app solo lo lee. `retentionExtended` lo cambia solo ADMIN
  // (rastro en patient_retention_actions + audit_events).
  lastAttentionAt              DateTime?             @map("last_attention_at")
  retentionExtended            RetentionExtension    @default(NONE) @map("retention_extended")
  partiallySuppressedAt        DateTime?             @map("partially_suppressed_at")
  // DX-128: canal OPERATIVO de los avisos automáticos (recordatorios), no el
  // consentimiento de marketing (DX-037). Nace con el de la clínica
  // (Tenant.defaultContactChannel). El opt-in de WhatsApp guarda cuándo, por
  // dónde y quién lo registró (NULL si lo dio el propio paciente por enlace o
  // mensaje). `reminderOptOutAt`: baja de los recordatorios; con ella no sale
  // ningún envío automático. CHECK en la BD: fecha y origen van juntos.
  contactChannel               ContactChannel        @default(EMAIL)
  whatsappOptInAt              DateTime?
  whatsappOptInSource          WhatsappOptInSource?
  whatsappOptInById            String?               @db.Uuid
  reminderOptOutAt             DateTime?
  reminderOptOutSource         ReminderOptOutSource?
  searchText                   String?               @default(dbgenerated("dx_search_normalize(((((\"firstName\" || ' '::text) || \"lastName\") || ' '::text) || COALESCE(\"docNumber\", ''::text)))")) @map("search_text") @ignore
  // DX-225: últimos 8 dígitos del teléfono (dx_phone_tail). Lo mantiene el
  // trigger `patients_phone_tail`; la app solo lo lee en SQL (BAJA por móvil).
  phoneTail                    String?               @ignore
  // DX-107: lote de importación que CREÓ al paciente (NULL si se dio de alta a
  // mano). «Deshacer lote» retira en blando solo los de su lote. FK compuesta
  // por tenant (patients_import_batch_fkey).
  importBatchId                String?               @map("import_batch_id") @db.Uuid

  importBatch            PatientImportBatch?         @relation(fields: [tenantId, importBatchId], references: [tenantId, id], onDelete: Restrict, map: "patients_import_batch_fkey")
  // DX-107: filas de importación que lo crearon o le rellenaron campos vacíos.
  importRows             PatientImportRow[]
  // DX-262: saldos migrados y su hoja de saldos.
  importBalanceRows      PatientImportBalanceRow[]
  openingBalances        OpeningBalance[]
  medicalHistoryVersions MedicalHistoryVersion[]
  // DX-247: confirmaciones «Sin cambios hoy» de su anamnesis.
  medicalHistoryReviews  MedicalHistoryReview[]
  clinicalEntries        ClinicalEntry[]
  clinicalEntryAddenda   ClinicalEntryAddendum[]
  dentitionEvents        PatientDentitionEvent[]
  toothRecords           ToothRecord[]
  appointments           Appointment[]
  treatmentPlans         TreatmentPlan[]
  dataProcessingConsents DataProcessingConsent[]
  consents               PatientConsent[]
  perioExams             PerioExam[]
  prescriptions          Prescription[]
  // DX-191: implantes y demás componentes colocados.
  implants               PatientImplant[]
  // DX-151: radiografías, fotos, remisiones, consentimientos firmados…
  documents              PatientDocument[]
  retentionActions       PatientRetentionAction[]
  // DX-122: pendientes por agendar del paciente.
  waitlistEntries        AppointmentWaitlistEntry[]
  // DX-210: huecos que se le ofrecieron.
  waitlistOffers         WaitlistOffer[]
  // DX-155: entradas de su cartera, mantenidas por la BD.
  ledger                 PatientLedger?
  collectionNotes        CollectionNote[]
  paymentPromises        PaymentPromise[]
  // DX-128: enlaces de baja de los recordatorios enviados al paciente.
  reminderOptOutLinks    ReminderOptOutLink[]
  // DX-203: sus responsables (de pago y avisos) y de quién es responsable.
  responsibleParties     PatientResponsibleParty[]   @relation("PatientResponsibleParties")
  responsibleFor         PatientResponsibleParty[]   @relation("ResponsiblePatient")
  // DX-153: sus coberturas (pagador, plan, afiliado, vigencia).
  coverages              PatientCoverage[]
  // DX-105: asignaciones de convenio (una viva; las retiradas son el historial).
  agreements             PatientAgreement[]
  // DX-222: indicaciones postoperatorias que se le entregaron.
  postOpDeliveries       PostOpInstructionDelivery[]
  country                Country?                    @relation(fields: [countryCode], references: [code])
  city                   City?                       @relation(fields: [cityId], references: [id])

  @@unique([tenantId, docNumber], map: "patients_tenant_doc_key")
  // Requisito de las FK COMPUESTAS de Appointment, TreatmentPlan,
  // MedicalHistoryVersion, ClinicalEntry y ToothRecord: permite referenciar un
  // paciente exigiendo que el tenant coincida, cerrando el cross-tenant a
  // nivel DB (las FK de Postgres se chequean saltando la RLS, así que una FK
  // a `id` sola no basta). Ver 20261015130000_tenant_composite_fks (SEC-004).
  @@unique([tenantId, id], map: "patients_tenant_id_key")
  // DX-043 (DB-017): sin @@index([tenantId]); era prefijo exacto de
  // patients_tenant_id_key y se retiró en 20261017114000.
  // Índices PARCIALES (WHERE "deletedAt" IS NULL) de DX-043 que Prisma no
  // expresa ni introspecciona, así que no se declaran (no generan drift):
  //   patients_tenant_created_live_idx ("tenantId", "createdAt" DESC, id DESC)
  //     -> página del listado sin Sort.
  //   patients_search_text_trgm_live_idx GIN (search_text gin_trgm_ops)
  //     -> búsqueda (dx_patient_search_ids/_count).
  //   patients_tenant_last_attention_live_idx ("tenantId", last_attention_at)
  //     -> historias que salen de retención (DX-039).
  //   patients_tenant_phone_tail_idx ("tenantId", "phoneTail")
  //     WHERE "deletedAt" IS NULL AND "phoneTail" IS NOT NULL
  //     -> pacientes de un móvil que respondió «BAJA» (DX-128, DX-225).
  //   patients_tenant_import_batch_idx ("tenantId", import_batch_id)
  //     WHERE import_batch_id IS NOT NULL
  //     -> pacientes de un lote (deshacer, DX-107) y lado hijo de su FK.
  @@map("patients")
}

model MedicalHistoryVersion {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  version          Int
  // Listas/objetos estructurados (snapshot inmutable por versión).
  allergies        Json?
  conditions       Json?
  medications      Json?
  habits           Json?
  dentalHistory    Json?
  surgeries        Json?
  vitalSigns       Json?
  familyHistory    String?
  notes            String?
  // Banderas denormalizadas — calculadas en el dominio (deriveSafetyFlags).
  safetyFlags      Json?
  hasCriticalAlert Boolean   @default(false)
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient Patient                @relation(fields: [tenantId, patientId], references: [tenantId, id])
  // DX-247: confirmaciones «Sin cambios hoy» sobre esta versión.
  reviews MedicalHistoryReview[]

  @@unique([tenantId, patientId, version], map: "mhv_tenant_patient_version_key")
  // DX-247: destino de la FK compuesta de medical_history_reviews (misma
  // clínica y mismo paciente que la versión confirmada).
  @@unique([tenantId, patientId, id], map: "mhv_tenant_patient_id_key")
  @@index([tenantId, patientId])
  @@index([tenantId, hasCriticalAlert])
  @@map("medical_history_versions")
}

/// DX-247: confirmación «Sin cambios hoy» de la anamnesis: el paciente dice
/// que su salud y su medicación no cambiaron desde la versión vigente. No crea
/// una versión nueva (no hay datos nuevos): deja quién, cuándo y en qué sede lo
/// confirmó, y reinicia la vigencia. APPEND-ONLY: la app nunca la cambia.
model MedicalHistoryReview {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  patientId               String   @db.Uuid
  /// La versión vigente que se confirmó (misma clínica y mismo paciente).
  medicalHistoryVersionId String   @db.Uuid
  /// Puntero suave a User, como `MedicalHistoryVersion.createdById`.
  reviewedById            String   @db.Uuid
  /// Sede del request (o la de escritura de la sesión); sin FK, es contexto.
  locationId              String?  @db.Uuid
  reviewedAt              DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "medical_history_reviews_patient_fkey")
  version MedicalHistoryVersion @relation(fields: [tenantId, patientId, medicalHistoryVersionId], references: [tenantId, patientId, id], onDelete: Restrict, map: "medical_history_reviews_version_fkey")

  @@index([tenantId, patientId, reviewedAt(sort: Desc)], map: "medical_history_reviews_tenant_patient_idx")
  @@index([tenantId, medicalHistoryVersionId], map: "medical_history_reviews_tenant_version_idx")
  @@map("medical_history_reviews")
}

model ClinicalEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  patientId     String    @db.Uuid
  entryDate     DateTime
  reason        String?
  notes         String
  performedById String?   @db.Uuid
  // DX-170: la cita en la que se documentó (NULL = evolución suelta, como todas
  // las anteriores) y la plantilla con la que se redactó. El texto compuesto
  // vive en `notes`: cambiar o desactivar la plantilla no toca la evolución.
  appointmentId String?   @db.Uuid
  // DX-232: sede de la atención; null solo para registros legacy.
  locationId    String?   @db.Uuid
  templateId    String?   @db.Uuid
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient     Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  addenda     ClinicalEntryAddendum[]
  // DX-212: diagnósticos CIE-10, creados en la misma transacción que la
  // evolución e inalterables como ella.
  diagnoses   ClinicalEntryDiagnosis[]
  // DX-170: FK COMPUESTA con el paciente: la cita tiene que ser de la MISMA
  // clínica Y del MISMO paciente. RESTRICT en las dos acciones: la evolución
  // es inalterable (DX-038) y nada puede reescribirla en cascada.
  appointment Appointment?             @relation(fields: [tenantId, patientId, appointmentId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  location    Location?                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  template    ClinicalNoteTemplate?    @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // DX-038: INALTERABLE en la BD (trigger: ni UPDATE ni DELETE para el rol de
  // la app), `createdAt` lo fija el servidor de BD en el INSERT y
  // `performedById` es obligatorio en lo nuevo (CHECK NOT VALID). Corregir =
  // añadir una ClinicalEntryAddendum.
  // Destino de la FK compuesta de las adendas (misma clínica y paciente).
  @@unique([tenantId, patientId, id], map: "clinical_entries_tenantId_patientId_id_key")
  @@index([tenantId, patientId, entryDate])
  // PARCIALES (WHERE ... IS NOT NULL), no declarables en Prisma (DX-170):
  //   clinical_entries_tenant_patient_appointment_idx
  //     ("tenantId", "patientId", "appointmentId") -> lado hijo de la FK a la cita.
  //   clinical_entries_tenant_template_idx ("tenantId", "templateId")
  //     -> lado hijo de la FK a la plantilla.
  @@map("clinical_entries")
}

// DX-170: tipo de pregunta de una plantilla de evolución: opción única, opción
// múltiple o texto libre.
enum ClinicalNotePromptType {
  ONE
  MULTI
  TEXT
}

/// Plantilla de evolución de la clínica (DX-170): texto fijo con marcadores
/// `{{Etiqueta}}` que se rellenan con las respuestas a sus preguntas. No lleva
/// datos de pacientes. Nunca se borra: `active = false` la quita del selector.
/// Editarla o desactivarla no cambia ninguna evolución ya guardada.
model ClinicalNoteTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  // Carpeta del selector (p. ej. «Operatoria»); NULL = sin carpeta.
  category    String?
  body        String
  active      Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant                       @relation(fields: [tenantId], references: [id])
  prompts ClinicalNoteTemplatePrompt[]
  entries ClinicalEntry[]

  // Destino de las FK compuestas de las preguntas y de clinical_entries.
  @@unique([tenantId, id], map: "clinical_note_templates_tenant_id_key")
  @@unique([tenantId, name], map: "clinical_note_templates_tenant_name_key")
  @@index([tenantId, category, name], map: "clinical_note_templates_tenant_category_name_idx")
  @@map("clinical_note_templates")
}

/// Pregunta de una plantilla de evolución (DX-170). Su etiqueta es el marcador
/// del cuerpo (`{{Superficie}}`). ONE/MULTI llevan opciones; TEXT, ninguna.
model ClinicalNoteTemplatePrompt {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @db.Uuid
  templateId   String                 @db.Uuid
  label        String
  type         ClinicalNotePromptType
  options      String[]               @default([])
  defaultValue String?
  position     Int

  template ClinicalNoteTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, templateId, position], map: "clinical_note_template_prompts_position_key")
  @@map("clinical_note_template_prompts")
}

/// Adenda (nota aclaratoria) de una evolución — DX-038, Res. 1995/1999 art. 18.
/// Corrige sin tocar el original: texto + motivo, autor (del JWT) y fecha del
/// servidor de BD. APPEND-ONLY en la BD (trigger) y RLS forzada por tenant.
/// FK compuestas: la evolución debe ser de la misma clínica y del mismo paciente.
model ClinicalEntryAddendum {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  patientId       String   @db.Uuid
  clinicalEntryId String   @db.Uuid
  reason          String
  text            String
  authorId        String   @db.Uuid
  createdAt       DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient Patient       @relation(fields: [tenantId, patientId], references: [tenantId, id])
  entry   ClinicalEntry @relation(fields: [tenantId, patientId, clinicalEntryId], references: [tenantId, patientId, id])
  author  User          @relation(fields: [authorId], references: [id])

  @@index([tenantId, patientId, clinicalEntryId, createdAt], map: "clinical_entry_addenda_entry_created_idx")
  @@map("clinical_entry_addenda")
}

// DX-212: tipo de diagnóstico del RIPS/RDA: uno principal y hasta 3 relacionados.
enum ClinicalDiagnosisKind {
  PRINCIPAL
  RELACIONADO
}

/// Diagnóstico CIE-10 de una evolución (DX-212). Se inserta SOLO en la misma
/// transacción que su evolución (trigger) y es INALTERABLE como ella (DX-038):
/// una corrección es una adenda y un diagnóstico nuevo en otra evolución.
/// Posición 0 = PRINCIPAL; 1..3 = relacionados (CHECK + único por evolución).
/// Dato de salud sensible (Ley 1581): RLS forzada por tenant y FK compuesta a
/// la evolución (misma clínica y mismo paciente).
model ClinicalEntryDiagnosis {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  patientId       String                @db.Uuid
  clinicalEntryId String                @db.Uuid
  icd10Code       String
  // DX-236: snapshot autoritativo del trigger BEFORE INSERT, nunca del cliente.
  labelEs         String                @default(dbgenerated())
  kind            ClinicalDiagnosisKind
  // Diente FDI opcional (mismo patrón que el odontograma).
  toothFdi        String?
  position        Int                   @db.SmallInt
  createdAt       DateTime              @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  entry  ClinicalEntry @relation(fields: [tenantId, patientId, clinicalEntryId], references: [tenantId, patientId, id], onDelete: Restrict, onUpdate: Restrict)
  icd10  Icd10Code     @relation(fields: [icd10Code], references: [code], onDelete: Restrict, onUpdate: Restrict)

  // Lado hijo de la FK a la evolución y lectura de los diagnósticos de una
  // evolución en orden; además, como mucho una fila por posición.
  @@unique([tenantId, patientId, clinicalEntryId, position], map: "clinical_entry_diagnoses_entry_position_key")
  @@index([icd10Code])
  @@map("clinical_entry_diagnoses")
}

/// CIE-10 (DX-212): tabla de REFERENCIA global, sin tenant ni RLS (como
/// currencies/countries/cities). Solo el capítulo oral (K00–K14) y Z01.2; la
/// siembra `prisma db seed` (upsert por código). `search_text` es una columna
/// GENERADA (código con y sin punto + texto, sin tildes ni mayúsculas, con
/// dx_search_normalize) con índice trigram: la app nunca la escribe (@ignore).
model Icd10Code {
  code       String                   @id
  labelEs    String                   @map("label_es")
  searchText String?                  @default(dbgenerated("dx_search_normalize((((code || ' '::text) || replace(code, '.'::text, ''::text)) || ' '::text) || label_es)")) @map("search_text") @ignore
  diagnoses  ClinicalEntryDiagnosis[]

  // PARCIAL/de EXPRESIÓN no declarable: icd10_codes_search_text_trgm_idx GIN
  // (search_text gin_trgm_ops) -> búsqueda por código o texto.
  @@map("icd10_codes")
}

enum CatalogKind {
  DIAGNOSIS
  PROCEDURE
}

model DentalCatalogItem {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  code          String
  category      String?
  kind          CatalogKind
  labelEs       String
  labelEn       String?
  labelPt       String?
  color         String
  defaultPrice  Decimal?    @db.Decimal(12, 2)
  // DX-212: código CUPS del procedimiento (6 caracteres alfanuméricos, CHECK
  // dental_catalog_items_cups_code_format). Lo piden el RDA y el RIPS.
  cupsCode      String?
  // DX-105: false = el procedimiento no recibe convenio ni descuento porcentual.
  allowDiscount Boolean     @default(true)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  // DX-105: precios de este procedimiento en las listas.
  priceListItems PriceListItem[]

  @@unique([tenantId, code], map: "catalog_tenant_code_key")
  // DX-105: destino de la FK compuesta de `price_list_items`.
  @@unique([tenantId, id], map: "dental_catalog_items_tenant_id_key")
  @@index([tenantId])
  @@map("dental_catalog_items")
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  VESTIBULAR
  LINGUAL
}

enum ToothRecordStatus {
  PLANNED
  COMPLETED
}

// DX-120: quién hizo lo que registra el diente. Lo hecho en esta clínica, lo
// que el paciente ya traía o lo que hizo otro profesional se pintan distinto.
enum ToothRecordOrigin {
  THIS_CLINIC
  PRE_EXISTING
  OTHER_PROVIDER
}

// DX-120: dentición de una POSICIÓN de la boca (nombrada por su código FDI
// permanente). MIXED = conviven el temporal y el permanente en esa posición.
enum DentitionType {
  PERMANENT
  PRIMARY
  MIXED
}

// DX-120: por qué cambió la dentición de una posición.
enum DentitionEventReason {
  MANUAL
  ERUPTION
  EXFOLIATION
}

model ToothRecord {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  patientId        String            @db.Uuid
  toothNumber      String
  surfaces         ToothSurface[]
  kind             CatalogKind
  catalogItemId    String?           @db.Uuid
  status           ToothRecordStatus @default(COMPLETED)
  notes            String?
  clinicalEntryId  String?           @db.Uuid
  performedById    String?           @db.Uuid
  // Set when this record was auto-created because a TreatmentPlanItem was
  // marked DONE (Pieza B). Soft pointer (no FK/relation): used to dedupe so a
  // given plan item mirrors into the odontogram at most once. Null for records
  // created directly in the odontogram.
  sourcePlanItemId String?           @db.Uuid
  recordedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?
  // DX-120: origen de lo registrado (hecho aquí, ya presente, otro profesional).
  origin           ToothRecordOrigin @default(THIS_CLINIC)
  // DX-120: una ANULACIÓN es otro registro (append-only) que apunta al anulado
  // y guarda el motivo. FK compuesta (tenantId, patientId, voidsRecordId) ->
  // tooth_records(tenantId, patientId, id) solo en SQL
  // (20261017180300_tooth_records_voids_record_fk): Prisma no la modela sin
  // una relación 1:1 que exigiría otro índice único.
  voidsRecordId    String?           @db.Uuid
  voidReason       String?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  // PARCIAL (WHERE "sourcePlanItemId" IS NOT NULL AND "deletedAt" IS NULL): un
  // ítem de plan se espeja como mucho una vez (DX-042). El WHERE vive en
  // 20261016130000_domain_checks; aquí mismo nombre y columnas.
  @@unique([tenantId, sourcePlanItemId], map: "tooth_records_source_plan_item_key")
  // DX-120: destino de la FK de anulación (mismo paciente y misma clínica).
  @@unique([tenantId, patientId, id], map: "tooth_records_tenantId_patientId_id_key")
  // DX-120, PARCIAL (WHERE "voidsRecordId" IS NOT NULL): un registro se anula
  // una sola vez. El WHERE vive en 20261017180200_tooth_records_void_once_key.
  @@unique([tenantId, voidsRecordId], map: "tooth_records_void_once_key")
  // DX-043 (DB-017): sin @@index([tenantId, patientId]); era prefijo exacto
  // de este y se retiró en 20261017114000_patient_search_and_list_indexes.
  @@index([tenantId, patientId, toothNumber])
  @@index([tenantId, sourcePlanItemId])
  @@map("tooth_records")
}

/// DX-120: cambios de dentición por posición (erupción, exfoliación o cambio
/// manual). APPEND-ONLY en la BD (trigger) y con RLS forzada; el estado actual
/// de una posición es su último evento o, sin eventos, el que toca por la edad.
model PatientDentitionEvent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  patientId     String               @db.Uuid
  /// Código FDI PERMANENTE de la posición (11-18, 21-28, 31-38, 41-48).
  position      String
  dentition     DentitionType
  reason        DentitionEventReason
  recordedAt    DateTime             @default(now())
  performedById String               @db.Uuid
  createdAt     DateTime             @default(now())

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  patient     Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])
  performedBy User    @relation(fields: [performedById], references: [id])

  @@index([tenantId, patientId, recordedAt, id], map: "patient_dentition_events_patient_recorded_idx")
  @@map("patient_dentition_events")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  // DX-200: el paciente en la clínica. Cuentan como «en curso» (nunca como
  // no-show): llegó (sala de espera), en el sillón y listo para cobrar.
  ARRIVED
  IN_CHAIR
  READY_FOR_CHECKOUT
}

model Appointment {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  locationId          String             @db.Uuid
  patientId           String             @db.Uuid
  providerId          String             @db.Uuid
  start               DateTime
  end                 DateTime
  status              AppointmentStatus  @default(SCHEDULED)
  reason              String?
  notes               String?
  createdById         String?            @db.Uuid
  // DX-121: tipo de cita (duración y color). Opcional: las citas anteriores no
  // tienen tipo y siguen siendo válidas.
  appointmentTypeId   String?            @db.Uuid
  // DX-005: cuándo recepción generó el último enlace de confirmación vigente
  // (null = nunca, o se invalidó al reagendar/cambiar el estado a mano).
  confirmationSentAt  DateTime?
  // DX-005: el paciente pulsó "Quiero que me llamen" en el enlace. Se limpia
  // cuando recepción reagenda o cambia el estado de la cita.
  callbackRequestedAt DateTime?
  // DX-210: «Adelantar si hay hueco». La cita es candidata para ocupar un
  // hueco libre anterior; al moverla a uno se apaga.
  wantsEarlier        Boolean            @default(false)
  // DX-200: horas del flujo en la clínica (UTC, reloj del servidor). null en
  // las citas anteriores y mientras no se marca el paso. CHECK en la
  // migración: cada estado del flujo lleva su hora y en orden.
  arrivedAt           DateTime?
  seatedAt            DateTime?
  readyForCheckoutAt  DateTime?
  // DX-200: el estado (SCHEDULED o CONFIRMED) al que vuelve «Deshacer
  // llegada». Solo con la cita en ARRIVED.
  preArrivalStatus    AppointmentStatus?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?

  planItems        AppointmentPlanItem[]
  // DX-273: salidas de COMPLETED, con su motivo.
  statusReversals  AppointmentStatusReversal[]
  confirmations    AppointmentConfirmation[]
  // DX-210: ofertas de hueco hechas a esta cita para adelantarla.
  waitlistOffers   WaitlistOffer[]
  outboundMessages OutboundMessage[]
  // DX-122: la entrada de «Pendientes por agendar» que creó su cancelación o
  // no-show, y la que se resolvió agendando esta cita.
  waitlistSourced  AppointmentWaitlistEntry[]  @relation("WaitlistSource")
  waitlistResolved AppointmentWaitlistEntry[]  @relation("WaitlistResolved")
  reminders        AppointmentReminder[]
  // DX-170: evoluciones documentadas en esta cita.
  clinicalEntries  ClinicalEntry[]
  // DX-222: indicaciones postoperatorias entregadas por esta cita.
  postOpDeliveries PostOpInstructionDelivery[]

  // FK COMPUESTA a propósito: exige que el paciente sea del MISMO tenant.
  // Antes era `[patientId] -> [id]`, que solo garantizaba "el paciente existe
  // en algún tenant" (las FK saltan la RLS), así que se podía agendar contra
  // un paciente de otra clínica.
  patient         Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  location        Location         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  // FK COMPUESTA (DX-121): el tipo tiene que ser del MISMO tenant.
  appointmentType AppointmentType? @relation(fields: [tenantId, appointmentTypeId], references: [tenantId, id], onDelete: Restrict)

  // Destino de la FK compuesta (tenantId, appointmentId) de
  // appointment_confirmations (DX-005): la cita tiene que ser del MISMO tenant.
  @@unique([tenantId, id], map: "appointments_tenant_id_key")
  // DX-170: destino de la FK compuesta de clinical_entries: la cita de una
  // evolución es de la misma clínica y del mismo paciente.
  @@unique([tenantId, patientId, id], map: "appointments_tenant_patient_id_key")
  @@index([tenantId, providerId, start])
  @@index([tenantId, patientId])
  // DX-121: lado hijo de la FK compuesta al tipo de cita.
  @@index([tenantId, appointmentTypeId])
  // DX-043 (DB-006): agenda por sede y semana. NO es parcial a propósito:
  // también es el lado hijo de la FK compuesta (tenantId, locationId), que
  // tiene que ver las citas retiradas; sustituye a (tenantId, locationId),
  // que era su prefijo exacto.
  @@index([tenantId, locationId, start], map: "appointments_tenant_location_start_idx")
  // PARCIAL (WHERE "deletedAt" IS NULL), no declarable en Prisma:
  //   appointments_tenant_start_live_idx ("tenantId", start)
  //     -> agenda consolidada y «próximas citas» del dashboard.
  //   appointments_tenant_patient_completed_idx ("tenantId", "patientId",
  //     start DESC, id DESC) INCLUDE ("locationId") WHERE status = 'COMPLETED'
  //     -> DX-145: sede de la deuda = la de la última cita atendida.
  //   appointments_tenant_location_wants_earlier_idx ("tenantId",
  //     "locationId", start) WHERE "wantsEarlier" AND "deletedAt" IS NULL
  //     AND status IN ('SCHEDULED', 'CONFIRMED')
  //     -> DX-210: citas candidatas a adelantarse a un hueco de la sede.
  //   appointments_tenant_location_in_clinic_idx ("tenantId", "locationId",
  //     start) WHERE status IN ('ARRIVED', 'IN_CHAIR', 'READY_FOR_CHECKOUT')
  //     AND "deletedAt" IS NULL
  //     -> DX-200: panel «En clínica» de la sede.
  @@map("appointments")
}

// DX-005: respuesta del paciente en el enlace público de confirmación.
// DX-121: tipo de cita de la clínica (p. ej. «Endodoncia», 90 min, morado).
// Fija la duración por defecto al agendar y colorea la tarjeta en la agenda.
// Nunca se borra físicamente: `active = false` lo quita del selector y
// `deletedAt` lo retira de la gestión; las citas existentes no cambian.
model AppointmentType {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  name            String
  // Múltiplo de 5 entre 5 y 480 (CHECK en la migración).
  durationMinutes Int
  // `#RRGGBB` (CHECK en la migración): nunca CSS libre.
  color           String
  active          Boolean   @default(true)
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant              Tenant                          @relation(fields: [tenantId], references: [id])
  appointments        Appointment[]
  waitlistEntries     AppointmentWaitlistEntry[]
  // DX-222: plantillas de indicaciones sugeridas para este tipo de cita.
  postOpTemplateLinks PostOpInstructionTemplateLink[]

  // Destino de la FK compuesta de appointments.appointmentTypeId.
  @@unique([tenantId, id], map: "appointment_types_tenant_id_key")
  // Único PARCIAL (solo vivos): el WHERE vive en la migración; Prisma no lo
  // expresa. NO aceptar un diff de migrate dev que lo recree sin el WHERE.
  @@unique([tenantId, name], map: "appointment_types_tenant_name_key")
  @@map("appointment_types")
}

// DX-122: bloqueo de agenda. `providerId` NULL = toda la sede (`locationId`
// obligatorio); con profesional y sin sede, el bloqueo es suyo en TODAS las
// sedes (vacaciones, congreso); con profesional y sede, solo en esa sede.
// `allowsBooking = false` impide agendar encima (409); `true` deja agendar con
// aviso (p. ej. el almuerzo). Nunca se borra físicamente: `deletedAt` lo retira.
enum ScheduleBlockKind {
  VACATION
  MEETING
  LUNCH
  OTHER
}

model ScheduleBlock {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @db.Uuid
  // NULL = el profesional en todas las sedes (CHECK: sede o profesional).
  locationId    String?           @db.Uuid
  // Usuario del personal (como `Appointment.providerId`, sin FK: la membresía
  // solo tiene un único PARCIAL). NULL = toda la sede.
  providerId    String?           @db.Uuid
  // [start, end) medio abierto, como las citas. CHECK end > start.
  start         DateTime
  end           DateTime
  kind          ScheduleBlockKind
  allowsBooking Boolean           @default(false)
  // Hasta 200 caracteres (CHECK); la API rechaza antes con 400.
  note          String?
  createdById   String?           @db.Uuid
  updatedById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  // FK COMPUESTA: la sede tiene que ser del MISMO tenant (SEC-004).
  location Location? @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // Rango por sede (también lado hijo de la FK compuesta, por eso NO es
  // parcial) y por profesional. `end` va en el índice: una consulta de rango
  // pide `end > desde AND start < hasta`, y lo que ya terminó queda fuera.
  @@index([tenantId, locationId, end], map: "schedule_blocks_tenant_location_end_idx")
  @@index([tenantId, providerId, end], map: "schedule_blocks_tenant_provider_end_idx")
  @@map("schedule_blocks")
}

// DX-122: «Pendientes por agendar». Una cita CANCELLED o NO_SHOW crea su entrada
// OPEN en la MISMA transacción (una sola por cita: único parcial por
// `sourceAppointmentId`); recepción también las da de alta a mano. Se cierra
// agendando (SCHEDULED, con la cita nueva) o descartando con motivo
// (DISMISSED). Datos personales y de salud: RLS FORCE por tenant.
enum WaitlistPriority {
  NORMAL
  URGENT
}

enum WaitlistStatus {
  OPEN
  SCHEDULED
  DISMISSED
}

model AppointmentWaitlistEntry {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  locationId            String           @db.Uuid
  patientId             String           @db.Uuid
  sourceAppointmentId   String?          @db.Uuid
  providerId            String?          @db.Uuid
  appointmentTypeId     String?          @db.Uuid
  // Duración de la cita a buscar (múltiplo de 5 entre 5 y 480, CHECK).
  durationMinutes       Int              @default(30)
  priority              WaitlistPriority @default(NORMAL)
  // «Mañanas», «después de las 17:00»… hasta 80 caracteres (CHECK).
  preferredWindow       String?
  note                  String?
  status                WaitlistStatus   @default(OPEN)
  resolvedAppointmentId String?          @db.Uuid
  dismissReason         String?
  createdById           String?          @db.Uuid
  resolvedById          String?          @db.Uuid
  resolvedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  // FK COMPUESTAS: todo lo referenciado es del MISMO tenant (SEC-004). CASCADE
  // en paciente y citas: la entrada es dato derivado, y el producto nunca
  // borra en duro (no-hard-delete); solo afecta a la limpieza administrativa.
  location            Location         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  patient             Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  sourceAppointment   Appointment?     @relation("WaitlistSource", fields: [tenantId, sourceAppointmentId], references: [tenantId, id], onDelete: Cascade)
  resolvedAppointment Appointment?     @relation("WaitlistResolved", fields: [tenantId, resolvedAppointmentId], references: [tenantId, id], onDelete: Cascade)
  appointmentType     AppointmentType? @relation(fields: [tenantId, appointmentTypeId], references: [tenantId, id], onDelete: Restrict)
  // DX-210: huecos ofrecidos a esta entrada.
  offers              WaitlistOffer[]

  @@unique([tenantId, id], map: "appointment_waitlist_tenant_id_key")
  // Único PARCIAL (WHERE "sourceAppointmentId" IS NOT NULL): el WHERE vive en
  // la migración. Es la idempotencia de «cancelar dos veces = una entrada».
  @@unique([tenantId, sourceAppointmentId], map: "appointment_waitlist_tenant_source_key")
  // El panel: OPEN de una sede, por antigüedad. También lado hijo de la FK a la sede.
  @@index([tenantId, locationId, status, createdAt], map: "appointment_waitlist_tenant_location_status_idx")
  @@index([tenantId, patientId])
  @@index([tenantId, resolvedAppointmentId])
  @@index([tenantId, appointmentTypeId])
  @@map("appointment_waitlist")
}

// DX-210: oferta de un hueco libre de la agenda a un candidato (un pendiente
// de la lista o una cita marcada «Adelantar si hay hueco»), por WhatsApp
// (enlace wa.me que abre recepción) o por teléfono. `offerDay` es el día civil
// de la oferta en la zona de la sede: el tope de ofertas por paciente y día se
// cuenta con él. Datos personales: RLS FORCE por tenant y FK compuestas.
enum WaitlistOfferChannel {
  WA_ME
  PHONE
}

enum WaitlistOfferOutcome {
  PENDING
  ACCEPTED
  DECLINED
  NO_ANSWER
}

model WaitlistOffer {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  locationId      String               @db.Uuid
  // El hueco ofrecido, [slotStart, slotEnd) (CHECK slotEnd > slotStart).
  slotStart       DateTime
  slotEnd         DateTime
  // Profesional del hueco (usuario del personal, sin FK como las citas).
  providerId      String               @db.Uuid
  patientId       String               @db.Uuid
  // A lo sumo uno de los dos (CHECK): el pendiente o la cita a adelantar.
  waitlistEntryId String?              @db.Uuid
  appointmentId   String?              @db.Uuid
  channel         WaitlistOfferChannel
  outcome         WaitlistOfferOutcome @default(PENDING)
  offerDay        DateTime             @db.Date
  createdById     String               @db.Uuid
  outcomeById     String?              @db.Uuid
  outcomeAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id])
  // FK COMPUESTAS (SEC-004): todo lo referenciado es del MISMO tenant.
  location      Location                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  patient       Patient                   @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  waitlistEntry AppointmentWaitlistEntry? @relation(fields: [tenantId, waitlistEntryId], references: [tenantId, id], onDelete: Cascade)
  appointment   Appointment?              @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  // Tope por paciente y día; también lado hijo de la FK al paciente.
  @@index([tenantId, patientId, offerDay], map: "waitlist_offers_tenant_patient_day_idx")
  // «Aviso enviado» de un hueco; también lado hijo de la FK a la sede.
  @@index([tenantId, locationId, slotStart], map: "waitlist_offers_tenant_location_slot_idx")
  @@index([tenantId, waitlistEntryId], map: "waitlist_offers_tenant_entry_idx")
  @@index([tenantId, appointmentId], map: "waitlist_offers_tenant_appointment_idx")
  @@map("waitlist_offers")
}

enum AppointmentConfirmationResponse {
  CONFIRM
  CANCEL
  CALL_ME
}

// DX-005: enlace firmado de un solo uso para que el paciente confirme, cancele
// o pida que lo llamen. Solo se guarda el HASH del token (sha256); el texto
// plano viaja únicamente en el enlace. `appointmentStart`/`appointmentStatus`
// son la foto de la cita al emitirlo: si la cita se reagenda o cambia de
// estado, el enlace deja de valer.
model AppointmentConfirmation {
  id                String                           @id @default(uuid()) @db.Uuid
  tenantId          String                           @db.Uuid
  appointmentId     String                           @db.Uuid
  tokenHash         String
  expiresAt         DateTime
  appointmentStart  DateTime
  appointmentStatus AppointmentStatus
  respondedAt       DateTime?
  response          AppointmentConfirmationResponse?
  revokedAt         DateTime?
  createdById       String?                          @db.Uuid
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  // FK COMPUESTA (SEC-004): la cita tiene que ser del MISMO tenant. CASCADE:
  // el enlace es dato derivado de la cita, que en el producto nunca se borra
  // en duro (no-hard-delete); solo afecta a la limpieza administrativa.
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId, appointmentId])
  @@map("appointment_confirmations")
}

// DX-037: autorización de tratamiento de datos (Ley 1581 / Dec. 1377).
// GENERAL = datos personales; SENSITIVE_HEALTH = datos sensibles de salud
// (exige consentimiento expreso y separado); MARKETING = finalidades
// comerciales (recordatorios comerciales, campañas), siempre opcional.
enum DataConsentScope {
  GENERAL
  SENSITIVE_HEALTH
  MARKETING
}

// IN_PERSON = registrado por el personal en la clínica con el texto vigente a
// la vista. LEGACY = sin prueba suficiente: migrado del antiguo booleano
// `Patient.dataConsentAccepted` o enviado por un cliente con ese campo
// deprecado.
enum DataConsentChannel {
  IN_PERSON
  LEGACY
}

// DX-037: versión publicada de la política de tratamiento de datos de UNA
// clínica. Inmutable una vez publicada: no hay endpoint de edición y un
// trigger de BD rechaza todo UPDATE (ver 20261016170000_data_processing_consents).
// Una versión nueva es una fila nueva con `version` + 1.
model PrivacyPolicyVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  version             Int
  // Texto completo de la política (aviso de privacidad).
  policyText          String
  // Texto de cada casilla: lo que el titular autoriza, scope a scope.
  generalText         String
  sensitiveHealthText String
  marketingText       String
  // sha256 de los cuatro textos: identifica el contenido exacto aceptado.
  contentHash         String
  publishedAt         DateTime @default(now())
  publishedById       String   @db.Uuid

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  publishedBy User                    @relation(fields: [publishedById], references: [id])
  consents    DataProcessingConsent[]

  @@unique([tenantId, version], map: "privacy_policy_versions_tenant_version_key")
  // Destino de la FK compuesta de data_processing_consents (SEC-004).
  @@unique([tenantId, id], map: "privacy_policy_versions_tenant_id_key")
  @@map("privacy_policy_versions")
}

// DX-037: prueba de la autorización de datos. APPEND-ONLY: una revocación es
// una fila nueva con `granted = false`; el estado vigente de cada scope es su
// última fila (por `recordedAt`). `recordedAt` lo pone el servidor. Un trigger
// de BD rechaza todo UPDATE (y todo DELETE salvo de un superusuario).
model DataProcessingConsent {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  patientId           String             @db.Uuid
  // NULL solo en filas LEGACY (CHECK en la migración): el booleano antiguo
  // no guardaba el texto aceptado.
  policyVersionId     String?            @db.Uuid
  // Etiqueta de versión que traía el booleano antiguo (p. ej. "v1"). Solo LEGACY.
  legacyPolicyVersion String?
  scope               DataConsentScope
  granted             Boolean
  channel             DataConsentChannel
  // NULL solo en filas LEGACY migradas (CHECK en la migración).
  recordedById        String?            @db.Uuid
  recordedAt          DateTime           @default(now())
  ipAddress           String?
  userAgent           String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  // FK COMPUESTAS (SEC-004): paciente y versión de política del MISMO tenant.
  patient       Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id])
  policyVersion PrivacyPolicyVersion? @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  recordedBy    User?                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, scope, recordedAt])
  @@index([tenantId, policyVersionId])
  @@map("data_processing_consents")
}

// Máquina de estados en el dominio (DX-040, `domain/plan-status-machine.ts`):
// DRAFT → PRESENTED → ACCEPTED | REJECTED; DRAFT → ACCEPTED; ACCEPTED →
// COMPLETED; cualquiera salvo COMPLETED → CANCELLED.
enum TreatmentPlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// Por qué el paciente no aceptó un plan presentado (DX-040). El personal elige
// cualquiera salvo OTHER_OPTION_ACCEPTED, que lo pone el sistema al aceptar
// otra opción del mismo grupo. OTHER exige una nota.
enum TreatmentPlanRejectionReason {
  PRICE
  FEAR
  SECOND_OPINION
  OTHER_OPTION_ACCEPTED
  OTHER
}

enum TreatmentPlanItemStatus {
  PROPOSED
  ACCEPTED
  DONE
}

model TreatmentPlan {
  visitIntervals     Json                @default("{}")
  acceptedAt         DateTime?
  acceptedLocationId String?             @db.Uuid
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  patientId          String              @db.Uuid
  status             TreatmentPlanStatus @default(DRAFT)
  // Moneda del plan: monto a pagar/saldo se calculan en esta moneda; un abono
  // en otra moneda se convierte por su fecha (ver Payment/ConvertAmountUseCase).
  currency           String              @default("USD")
  notes              String?
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  // Alternativas A/B (DX-040). `optionGroupId` es el id del plan que abrió el
  // grupo (ese plan apunta a sí mismo); null = plan suelto. `optionLabel`
  // ("Opción A: implante") distingue las opciones ante el paciente.
  optionGroupId       String?                       @db.Uuid
  optionLabel         String?
  // Presentado al paciente: cuándo y en qué sede (la del request o la
  // principal). La lista de presupuestos por seguir filtra por esa sede.
  presentedAt         DateTime?
  presentedLocationId String?                       @db.Uuid
  // Rechazado: cuándo, por qué (catálogo) y la nota (obligatoria con OTHER).
  rejectedAt          DateTime?
  rejectionReason     TreatmentPlanRejectionReason?
  rejectionNote       String?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient            Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  // FK COMPUESTA al plan raíz del grupo (DX-040): las opciones de un grupo
  // son del MISMO tenant y del MISMO paciente. NO ACTION (no RESTRICT): un
  // DELETE que se lleva el grupo entero de una vez (limpieza de tests) pasa.
  optionGroupRoot    TreatmentPlan?           @relation("TreatmentPlanOptionGroup", fields: [tenantId, optionGroupId, patientId], references: [tenantId, id, patientId], onDelete: NoAction, onUpdate: NoAction, map: "treatment_plans_option_group_fkey")
  optionGroupMembers TreatmentPlan[]          @relation("TreatmentPlanOptionGroup")
  // Sede donde se presentó, del MISMO tenant.
  presentedLocation  Location?                @relation(fields: [tenantId, presentedLocationId], references: [tenantId, id], onDelete: Restrict, map: "treatment_plans_presented_location_fkey")
  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef        Currency                 @relation(fields: [currency], references: [code])
  items              TreatmentPlanItem[]
  payments           Payment[]
  paymentPlans       PaymentPlan[]
  consents           PatientConsent[]
  // Aceptación firmada del presupuesto (DX-012): como mucho una por plan.
  acceptance         TreatmentPlanAcceptance?

  // Destinos de FK compuestas (SEC-004): (tenantId, id) para los ítems del
  // plan; (tenantId, id, patientId) para pagos y planes de pago, que además
  // garantiza que su `patientId` denormalizado sea el del plan.
  @@unique([tenantId, id], map: "treatment_plans_tenant_id_key")
  @@unique([tenantId, id, patientId], map: "treatment_plans_tenant_id_patient_key")
  @@index([tenantId, patientId])
  // Opciones de un grupo (lado hijo de la FK al plan raíz).
  @@index([tenantId, optionGroupId, patientId])
  // Presupuestos por seguir: PRESENTED por antigüedad de la presentación.
  @@index([tenantId, status, presentedAt])
  // Lado hijo de la FK a la sede de presentación (filtro por sede).
  @@index([tenantId, presentedLocationId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  visit             Int                     @default(1)
  visitLabel        String?                 @db.VarChar(60)
  patientId         String                  @default(dbgenerated()) @db.Uuid
  appointmentLinks  AppointmentPlanItem[]
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  planId            String                  @db.Uuid
  toothNumber       String
  surfaces          ToothSurface[]
  catalogItemId     String                  @db.Uuid
  // Precio de REFERENCIA del ítem al darlo de alta (NULL = ítem libre: sin
  // precio de catálogo). DX-105 (ruling R1) lo resuelve en orden convenio →
  // lista de precios → catálogo; `basePrice` guarda siempre el de catálogo. Un
  // precio por debajo cuenta como descuento (rebaja = catalogPrice − price) y se
  // firma como él, así que `effectiveDiscount`, el informe de descuentos y su
  // índice parcial miden solo lo que baja del precio pactado. CHECK
  // treatment_plan_items_catalog_price_nonneg (>= 0).
  catalogPrice      Decimal?                @db.Decimal(12, 2)
  // DX-105: foto del precio al dar de alta el ítem. NULL = «sin convenio»
  // (ítems anteriores, sin backfill). CHECK treatment_plan_items_base_price_nonneg.
  basePrice         Decimal?                @db.Decimal(12, 2)
  priceSource       PriceSource?
  agreementId       String?                 @db.Uuid
  agreementName     String?
  // Sede con la que se resolvió el precio.
  pricingLocationId String?                 @db.Uuid
  price             Decimal                 @db.Decimal(12, 2)
  // Descuento del ítem en la moneda del plan (DX-012). CHECK 0 <= discount <= price
  // (treatment_plan_items_discount_nonneg / _subtotal_nonneg).
  discount          Decimal                 @default(0) @db.Decimal(12, 2)
  status            TreatmentPlanItemStatus @default(PROPOSED)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  // DX-204: quién dio el descuento vigente, cuándo (hora del servidor), en qué
  // sede (la del request o la principal) y por qué. NULL en los ítems sin
  // descuento y en los anteriores a DX-204. CHECK
  // treatment_plan_items_discount_reason_check: nota de 1..200, solo con
  // motivo, obligatoria con OTHER.
  discountReason     DiscountReason?
  discountReasonNote String?
  discountById       String?         @db.Uuid
  discountAt         DateTime?
  discountLocationId String?         @db.Uuid

  plan             TreatmentPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)
  discountBy       User?         @relation("TreatmentPlanItemDiscountBy", fields: [discountById], references: [id], onDelete: Restrict, map: "treatment_plan_items_discount_by_fkey")
  // FK COMPUESTA (SEC-004): la sede del descuento es de la MISMA clínica.
  discountLocation Location?     @relation("TreatmentPlanItemDiscountLocation", fields: [tenantId, discountLocationId], references: [tenantId, id], onDelete: Restrict, map: "treatment_plan_items_discount_location_fkey")
  // FK COMPUESTA (SEC-004, DX-105): el convenio aplicado es de la MISMA clínica.
  agreement        Agreement?    @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Restrict, map: "treatment_plan_items_agreement_fkey")
  // FK COMPUESTA (SEC-004, DX-105): la sede con la que se resolvió el precio.
  pricingLocation  Location?     @relation("TreatmentPlanItemPricingLocation", fields: [tenantId, pricingLocationId], references: [tenantId, id], onDelete: Restrict, map: "treatment_plan_items_pricing_location_fkey")

  @@unique([tenantId, patientId, id], map: "treatment_plan_items_tenant_patient_id_key")
  @@index([tenantId, planId])
  @@index([tenantId, agreementId], map: "treatment_plan_items_tenant_agreement_idx")
  @@index([tenantId, pricingLocationId], map: "treatment_plan_items_tenant_pricing_location_idx")
  @@index([tenantId, discountLocationId])
  @@index([discountById])
  // PARCIAL (WHERE "deletedAt" IS NULL), no declarable en Prisma:
  //   treatment_plan_items_tenant_plan_billable_idx ("tenantId", "planId")
  //     INCLUDE (price, discount, status)
  //     -> DX-145: facturable de todos los planes de la clínica (cartera).
  // PARCIAL y de EXPRESIÓN, no declarable en Prisma:
  //   treatment_plan_items_tenant_effective_discount_at_idx
  //     ("tenantId", COALESCE("discountAt", "createdAt"))
  //     WHERE ("discount" > 0 OR "price" < "catalogPrice") AND "deletedAt" IS NULL
  //     -> DX-204/SEC-041: informe de descuentos por periodo (descuento o
  //        rebaja de precio).
  @@map("treatment_plan_items")
}

// Motivo de un descuento por encima del umbral de la política (DX-204). OTHER
// exige una nota.
enum DiscountReason {
  LOYALTY
  FAMILY_OR_STAFF
  PROMOTION
  FINANCIAL_HARDSHIP
  SERVICE_RECOVERY
  OTHER
}

// ---------------------------------------------------------------------------
// Política de descuentos de la clínica (DX-204): % máximo de descuento por ítem
// según el rol de quien lo da y el % a partir del cual (estrictamente por
// encima) el motivo es obligatorio. Una fila por clínica; sin ella, la API usa
// los valores por defecto (los mismos que los DEFAULT de la tabla). Solo ADMIN
// la cambia. RLS FORCE por tenant.
// ---------------------------------------------------------------------------
model DiscountPolicy {
  tenantId                   String   @id @db.Uuid
  adminMaxPercent            Int      @default(100)
  dentistMaxPercent          Int      @default(10)
  assistantMaxPercent        Int      @default(0)
  receptionMaxPercent        Int      @default(0)
  reasonRequiredAbovePercent Int      @default(10)
  updatedById                String?  @db.Uuid
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  updatedBy User?  @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([updatedById])
  @@map("discount_policies")
}

// ---------------------------------------------------------------------------
// Aceptación firmada del presupuesto de un plan (DX-012). Foto congelada del
// contenido que se presentó (JSONB) + su SHA-256, la firma (PNG base64), quién
// firmó, cuándo (hora del servidor) y en qué sede. Una por plan; append-only:
// un trigger rechaza UPDATE y DELETE, y otros dos congelan los ítems y la
// moneda del plan aceptado (20261016213000_treatment_plan_acceptances).
// ---------------------------------------------------------------------------
model TreatmentPlanAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  planId         String   @db.Uuid
  patientId      String   @db.Uuid
  locationId     String   @db.Uuid
  signerName     String
  // PNG en base64 (sin prefijo data:). Tope: 200 KB decodificados (CHECK).
  signature      String
  // El presupuesto tal como se mostró y se firmó (plan-quote.ts).
  content        Json
  // SHA-256 (hex) del contenido presentado.
  contentHash    String
  // SHA-256 (hex) de contentHash + firmante + firma + acceptedAt.
  acceptanceHash String
  acceptedAt     DateTime
  acceptedById   String   @db.Uuid
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // FK COMPUESTAS (SEC-004): plan del MISMO tenant y del MISMO paciente; sede
  // del MISMO tenant.
  plan       TreatmentPlan @relation(fields: [tenantId, planId, patientId], references: [tenantId, id, patientId])
  location   Location      @relation(fields: [tenantId, locationId], references: [tenantId, id])
  acceptedBy User          @relation(fields: [acceptedById], references: [id])

  // Una aceptación por plan (volver a firmar: 409).
  @@unique([tenantId, planId, patientId], map: "treatment_plan_acceptances_plan_key")
  @@index([tenantId, patientId])
  @@index([tenantId, locationId])
  @@index([acceptedById])
  @@map("treatment_plan_acceptances")
}

// ---------------------------------------------------------------------------
// Resumen por paciente para la cartera por antigüedad (DX-155). Lo escribe SOLO
// la BD: triggers por sentencia en patients, treatment_plans, sus ítems y
// aceptaciones, payments, payment_plans, installments y appointments
// recalculan la fila de los pacientes afectados (`patient_ledgers_refresh`);
// un trigger de guarda rechaza las escrituras directas con contexto de tenant.
// La app solo lo lee (PrismaReceivablesRepository). Guarda ENTRADAS (sumas por
// plan, planes de cuotas, sede de la deuda), no un saldo: el saldo sale de
// `computeBalances`. Formato de `ledger` y reglas: migración
// 20261017233000_dx155_patient_ledgers.
// No declarables en Prisma (solo SQL):
//   patient_ledgers_owing_idx ("tenantId", "locationId") WHERE "owing";
//   patient_ledgers_location_fkey ("tenantId", "locationId") -> locations
//     ON DELETE SET NULL ("locationId") (Prisma no admite SET NULL de una sola
//     columna de una FK compuesta).
// ---------------------------------------------------------------------------
model PatientLedger {
  tenantId   String   @db.Uuid
  patientId  String   @db.Uuid
  locationId String?  @db.Uuid
  owing      Boolean  @default(false)
  ledger     Json     @default("{\"plans\": [], \"paymentPlans\": []}")
  updatedAt  DateTime @default(now())

  // FK COMPUESTA (SEC-004): paciente del MISMO tenant. CASCADE: el resumen es
  // del paciente y se va con él.
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade, map: "patient_ledgers_patient_fkey")

  @@id([tenantId, patientId])
  @@map("patient_ledgers")
}

// Tasas de cambio (referencia/mercado, base USD). Tabla GLOBAL, no de dominio:
// no lleva tenantId ni RLS ni deletedAt (excepción técnica documentada en la
// migración, igual que cache/colas). Snapshot inmutable por (date, currency);
// `date` es String YYYY-MM-DD (día del snapshot, sin ambigüedad de timezone).
model ExchangeRateSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  date      String
  currency  String
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@unique([date, currency])
  @@map("exchange_rate_snapshots")
}

// Catálogos de referencia GLOBALES (moneda/país/ciudad). Misma excepción que
// ExchangeRateSnapshot: sin tenantId, sin RLS, sin deletedAt. Currency es
// además la whitelist de códigos ISO 4217 aceptados en planes/abonos.
model Currency {
  code   String @id // ISO 4217, p.ej. "USD"
  name   String // "Dólar estadounidense"
  symbol String // "$"

  // FK de `currency` (DX-042, 20261016131000_currency_fks).
  treatmentPlans   TreatmentPlan[]
  payments         Payment[]
  paymentPlans     PaymentPlan[]
  // DX-150: compromisos de pago en esa moneda.
  paymentPromises  PaymentPromise[]
  // DX-027: fondos, arqueos y ajustes de caja en esa moneda.
  cashFloats       CashSessionFloat[]
  cashClosingLines CashSessionClosingLine[]
  cashAdjustments  CashSessionAdjustment[]
  // DX-105: listas de precios en esa moneda.
  priceLists       PriceList[]
  // DX-262: saldos migrados en esa moneda.
  openingBalances  OpeningBalance[]

  @@map("currencies")
}

model Country {
  code     String    @id // ISO 3166-1 alpha-2, p.ej. "CO"
  name     String // "Colombia"
  cities   City[]
  patients Patient[]

  @@map("countries")
}

model City {
  id          Int       @id @default(autoincrement())
  countryCode String
  name        String
  region      String? // estado/departamento (informativo)
  country     Country   @relation(fields: [countryCode], references: [code])
  patients    Patient[]

  @@index([countryCode, name])
  @@map("cities")
}

enum TenantDomainStatus {
  PENDING
  VERIFIED
  // SEC-009: estuvo verificado, pero la re-verificación periódica no encontró
  // su TXT en DOMAIN_RECHECK_MAX_FAILURES comprobaciones seguidas. No enruta;
  // el ADMIN puede volver a verificarlo (mismo token) o eliminarlo.
  DISABLED
}

model TenantDomain {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  // SEC-009: el host solo es único entre los VERIFIED vivos (índice PARCIAL
  // `WHERE status = 'VERIFIED' AND "deletedAt" IS NULL`, migración
  // 20261017234400_sec009_tenant_domain_verified_unique; Prisma no expresa el
  // predicado). Varias clínicas pueden tenerlo en PENDING: lo gana la primera
  // que verifica el TXT. NO uses findUnique por host: puede haber varias filas.
  host          String             @unique(map: "tenant_domains_verified_host_key")
  status        TenantDomainStatus @default(PENDING)
  verifyToken   String
  verifiedAt    DateTime?
  // SEC-009: hasta cuándo se puede verificar un PENDING (72 h desde el alta).
  // Pasado ese momento está EXPIRADO: no se verifica ni bloquea a nadie. null
  // en VERIFIED/DISABLED. El default de la BD cubre a quien inserte sin darlo.
  expiresAt     DateTime?          @default(dbgenerated("(CURRENT_TIMESTAMP + '72:00:00'::interval)"))
  // SEC-009: re-verificación periódica de los VERIFIED (tarea programada).
  // `lastCheckedAt` es el instante de la ronda que lo comprobó por última vez.
  lastCheckedAt DateTime?
  failedChecks  Int                @default(0)
  disabledAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  tenant        Tenant             @relation(fields: [tenantId], references: [id])

  // SEC-009: un host una sola vez por clínica entre los vivos (PARCIAL
  // `WHERE "deletedAt" IS NULL`, mismo patrón que tooth_records).
  @@unique([tenantId, host], map: "tenant_domains_tenant_host_key")
  @@index([tenantId])
  // SEC-009: filas vivas de un host en todas las clínicas (invalidar los
  // PENDING ajenos al verificar). PARCIAL `WHERE "deletedAt" IS NULL`.
  @@index([host], map: "tenant_domains_host_idx")
  @@map("tenant_domains")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// Abono contra un Plan de Tratamiento (reemplaza Sale/SaleLineItem — ver
// docs/plans/2026-07-24-payments-pivot.md). Saldo vive por plan: monto a
// pagar = Σ item.price con status ACCEPTED|DONE; saldo = eso − Σ abonos
// activos (cada uno convertido a `plan.currency` por su propia `paidAt` vía
// ConvertAmountUseCase). `patientId` está denormalizado del plan para poder
// listar abonos por paciente sin join. Anular abono = soft-delete (`deletedAt`).
model Payment {
  id                     String         @id @default(uuid()) @db.Uuid
  tenantId               String         @db.Uuid
  locationId             String         @db.Uuid
  // DX-262: un abono va a un plan O a un saldo migrado (CHECK
  // payments_target_check: exactamente uno de los dos).
  treatmentPlanId        String?        @db.Uuid
  openingBalanceId       String?        @db.Uuid
  patientId              String         @db.Uuid
  amount                 Decimal        @db.Decimal(14, 2)
  currency               String
  paidAt                 DateTime
  method                 PaymentMethod?
  notes                  String?
  idempotencyKey         String?
  // Huella de la petición que usó la Idempotency-Key (DX-109, BE-017):
  // SHA-256 (hex) del plan + cuerpo normalizado. Una repetición con otra
  // huella es 422. NULL en abonos anteriores a DX-109 o sin clave.
  idempotencyFingerprint String?
  createdById            String?        @db.Uuid
  // DX-226: la pone la BD en UTC (trigger `payments_server_created_at`), la
  // misma fuente de hora que el alta de un compromiso de pago.
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  // Anulación (SEC-013, migración 20261016160000_payment_void_audit): quién,
  // cuándo y por qué. Puntero suave a User como createdById (sin relación).
  voidedById             String?        @db.Uuid
  voidedAt               DateTime?
  voidReason             String?
  // DX-027: la caja (abierta) que recibió el abono: la de quien lo registra
  // en su sede. NULL sin caja abierta (o anterior a DX-027). Un trigger impide
  // asociarlo a una caja cerrada o de otra sede, y cambiarla después.
  cashSessionId          String?        @db.Uuid

  // FK COMPUESTAS (SEC-004): el plan y la sede tienen que ser del MISMO tenant,
  // y `patientId` (denormalizado) tiene que ser el paciente del plan. Por
  // transitividad el paciente también es del tenant (treatment_plans ya tiene
  // su FK compuesta a patients), sin una tercera FK.
  plan           TreatmentPlan?  @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  // DX-262: abono contra el saldo migrado del MISMO paciente y tenant.
  openingBalance OpeningBalance? @relation(fields: [tenantId, openingBalanceId, patientId], references: [tenantId, id, patientId], onDelete: Restrict, map: "payments_opening_balance_fkey")
  location       Location        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef Currency @relation(fields: [currency], references: [code])

  // Recibo de caja numerado (DX-136). Null en los abonos anteriores a la
  // numeración: conservan su referencia antigua REC-xxxxxxxx.
  receipt PaymentReceipt?

  cashSession     CashSession?            @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict, map: "payments_cash_session_fkey")
  cashAdjustments CashSessionAdjustment[]

  // Idempotency dedup for POST payments. Prisma's `@@unique` would emit a FULL
  // unique index; the migration 20260731160000_add_payment_idempotency_key
  // instead creates it PARTIAL (WHERE "idempotencyKey" IS NOT NULL) so NULL
  // keys (legacy rows + writes without the header) stay unconstrained, while a
  // non-null key is unique per tenant. Same name+columns as declared here, so
  // migrate status/deploy see no drift. Do NOT accept a migrate-dev diff that
  // recreates this as a full index.
  @@unique([tenantId, idempotencyKey], map: "payments_tenant_idempotency_key")
  // DX-262: índice PARCIAL que Prisma no expresa (no se declara):
  //   payments_tenant_opening_balance_idx ("tenantId", "openingBalanceId")
  //     WHERE "openingBalanceId" IS NOT NULL
  @@index([tenantId, treatmentPlanId])
  @@index([tenantId, patientId])
  // Ya existía en SQL (20260801150000_add_locations) sin declararse aquí; se
  // declara para que migrate diff no lo vea como drift. Indexa además el lado
  // hijo de la FK compuesta (tenantId, locationId).
  @@index([tenantId, locationId])
  // Partial (WHERE "deletedAt" IS NULL) -- Prisma has no schema-DSL support
  // for filtered indexes, so the WHERE lives only in the migration SQL
  // (see 20260726010000_payments_tenant_paidat_index). The explicit `map`
  // keeps the name+columns in sync with that hand-written index so
  // `prisma migrate status`/`migrate deploy` see no drift. Same approach as
  // Patient.@@unique(patients_tenant_doc_key) / the tenants_subdomain_key
  // and users_email_key partial unique indexes.
  @@index([tenantId, paidAt], map: "payments_tenantId_paidAt_active_idx")
  // La caja con una sede activa (GET /payments + X-Location-Id) filtra
  // tenantId + locationId + rango de paidAt + deletedAt IS NULL. Parcial igual
  // que el de arriba: el WHERE vive solo en la migración
  // 20261015120000_payments_tenant_location_paidat_index, y el `map` mantiene
  // nombre+columnas en sync para que migrate status/deploy no vean drift. Un
  // `prisma migrate dev` puede proponer "arreglarlo" a índice completo: NO
  // aceptes ese diff.
  @@index([tenantId, locationId, paidAt], map: "payments_tenantId_locationId_paidAt_active_idx")
  // Parcial (WHERE "cashSessionId" IS NOT NULL): el WHERE vive solo en la
  // migración 20261018140200_dx027_cash_sessions. NO aceptes un diff de
  // migrate dev que lo vuelva completo.
  @@index([tenantId, cashSessionId], map: "payments_tenant_cash_session_idx")
  @@map("payments")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentPeriodicity {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model PaymentPlan {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @db.Uuid
  treatmentPlanId   String                 @db.Uuid
  patientId         String                 @db.Uuid
  currency          String
  totalToFinance    Decimal                @db.Decimal(14, 2)
  downPayment       Decimal                @default(0) @db.Decimal(14, 2)
  installmentsCount Int
  periodicity       InstallmentPeriodicity
  startDate         DateTime
  status            PaymentPlanStatus      @default(ACTIVE)
  notes             String?
  // Cancelación (DX-109): cuándo, quién y por qué. Puntero suave a User como
  // createdById. NULL en planes activos o cancelados antes de DX-109.
  cancelledAt       DateTime?
  cancelledById     String?                @db.Uuid
  cancelReason      String?
  createdById       String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  // FK COMPUESTA (SEC-004): mismo criterio que Payment.plan (tenant + paciente
  // denormalizado coherentes con el plan de tratamiento).
  plan         TreatmentPlan @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  installments Installment[]

  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef Currency @relation(fields: [currency], references: [code])

  // Destino de la FK compuesta de Installment (SEC-004).
  @@unique([tenantId, id], map: "payment_plans_tenant_id_key")
  @@index([tenantId, treatmentPlanId])
  @@index([tenantId, patientId])
  // Hand-written partial unique index (WHERE status = 'ACTIVE' AND
  // deletedAt IS NULL) on (tenantId, treatmentPlanId) exists in SQL only --
  // see 20260731120000_payment_plan_active_unique. Prisma's schema DSL
  // can't express a filtered/partial unique constraint (same rationale as
  // Payment.@@index([tenantId, paidAt], map: "payments_tenantId_paidAt_active_idx")
  // above), so it is not declared here; `prisma migrate status` won't show
  // it, and that's expected -- do not "fix" this by adding a plain
  // @@unique, which would wrongly forbid multiple CANCELLED/COMPLETED
  // plans per treatment plan.
  @@map("payment_plans")
}

model Installment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  paymentPlanId String   @db.Uuid
  sequence      Int
  dueDate       DateTime
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// `Restrict`, no `Cascade`: `PaymentPlan` se anula en blando (status
  /// CANCELLED + deletedAt), nunca se borra. Un DELETE duro del plan sería un
  /// error, y con Cascade se llevaba las cuotas sin dejar rastro.
  /// FK compuesta (tenantId, paymentPlanId): el plan de pagos es del MISMO tenant (SEC-004).
  paymentPlan PaymentPlan @relation(fields: [tenantId, paymentPlanId], references: [tenantId, id], onDelete: Restrict)

  @@unique([paymentPlanId, sequence])
  @@index([tenantId, dueDate])
  @@map("installments")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  locationId  String    @db.Uuid
  name        String
  sku         String?
  unit        String
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  notes       String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  movements InventoryMovement[]
  // FK compuesta: la sede es del MISMO tenant (SEC-004).
  location  Location            @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // Nombre único POR SEDE y sin distinguir mayúsculas, solo entre vivos:
  // índice de EXPRESIÓN ("tenantId", "locationId", lower(name)) WHERE
  // "deletedAt" IS NULL, en 20261016130000_domain_checks (DX-042). Prisma no
  // expresa ni introspecciona índices de expresión, así que no se declara.

  // Destino de la FK compuesta de InventoryMovement.item (SEC-004).
  @@unique([tenantId, id], map: "inventory_items_tenant_id_key")
  // DX-043 (DB-017): sin @@index([tenantId]); era prefijo exacto de
  // inventory_items_tenant_id_key (tenantId, id) y se retiró en 20261017114000_patient_search_and_list_indexes.
  // Ya existía en SQL (20260801150000_add_locations) sin declararse aquí; se
  // declara para que migrate diff no lo vea como drift. Indexa además el lado
  // hijo de la FK compuesta (tenantId, locationId).
  @@index([tenantId, locationId])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  locationId  String                @db.Uuid
  itemId      String                @db.Uuid
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(14, 3)
  reason      String?
  occurredAt  DateTime              @default(now())
  createdById String?               @db.Uuid
  createdAt   DateTime              @default(now())

  // FK compuestas: ítem y sede son del MISMO tenant (SEC-004). Que la sede del
  // movimiento coincida con la del ítem es otra regla (SEC-014), no esta.
  item     InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, itemId])
  @@map("inventory_movements")
}

// Denylist de refresh tokens revocados por logout. Cada fila vive a lo sumo el
// TTL del refresh (JWT_REFRESH_TTL, ~30d); se limpian de forma lazy al revocar.
// Tabla global (sin RLS ni tenantId): el jti ya es único por token.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Configuración de horario de atención de una SEDE (una fila por sede).
/// Vive en su propia tabla, no como columnas de `Location`, para no tocar un
/// modelo que el trabajo multi-sede está modificando en paralelo
/// (docs/plans/2026-08-01-multi-sede.md, Fases 2-5).
model LocationSchedule {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  /// Puntero suave a `Location` (sin relación Prisma, mismo criterio que
  /// ToothRecord.sourcePlanItemId): evita añadir la back-relation al modelo
  /// Location mientras otro flujo lo edita. FK a nivel DB queda como follow-up.
  locationId String    @db.Uuid
  /// IANA (ej. "America/Bogota"). Los tramos son hora de PARED; las citas se
  /// guardan como instante, así que hace falta la zona para compararlos.
  timezone   String    @default("America/Bogota")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  ranges LocationScheduleRange[]

  @@unique([tenantId, locationId], map: "location_schedule_tenant_location_key")
  // Destino de la FK compuesta de LocationScheduleRange (SEC-004).
  @@unique([tenantId, id], map: "location_schedules_tenant_id_key")
  // DX-043 (DB-017): sin @@index([tenantId]); era prefijo exacto de
  // location_schedules_tenant_id_key (tenantId, id) y se retiró en 20261017114000_patient_search_and_list_indexes.
  @@map("location_schedules")
}

/// Un tramo de atención. Día CERRADO = sin tramos VIVOS para ese `weekday`.
/// Sede SIN configurar (sin LocationSchedule) = sin restricción.
///
/// Guardar el horario NO borra los tramos anteriores: los marca con `deletedAt`
/// y crea los nuevos. Así queda el rastro de qué horario tenía la sede en cada
/// momento — que es la pregunta que se hace al auditar una cita vieja ("¿esa
/// cita de marzo cabía en el horario que había ENTONCES?"). Toda lectura debe
/// filtrar `deletedAt: null`, incluidos los `include: { ranges: ... }`.
model LocationScheduleRange {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  scheduleId  String    @db.Uuid
  /// 0=domingo .. 6=sábado (convención de `Date.getDay()`, para no convertir).
  weekday     Int
  /// Minutos desde 00:00 (0..1440), hora de pared de la sede. endMinute > startMinute.
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  /// `Restrict`, no `Cascade`: el padre se borra en blando, así que un borrado
  /// DURO de `location_schedules` solo puede venir de un error. Con Cascade se
  /// llevaba los tramos por delante en silencio; con Restrict la DB lo rechaza.
  /// FK compuesta (tenantId, scheduleId): el horario es del MISMO tenant (SEC-004).
  schedule LocationSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, scheduleId, weekday])
  @@map("location_schedule_ranges")
}

// DX-233: horario de cada profesional por sede, con excepciones por fecha.
//
// Un profesional SIN filas vivas en `provider_schedules` no tiene restricción
// (compatibilidad, igual que una sede sin horario). Con alguna, solo trabaja
// en los tramos de sus sedes. Una excepción (`provider_schedule_overrides`)
// prevalece sobre el semanal de ESA sede ESE día; sin tramos = «no trabaja».
// Las ausencias siguen siendo bloqueos VACATION (DX-122).
//
// `providerId` es el usuario del personal, sin FK (como `appointments` y
// `schedule_blocks`: la membresía solo tiene un único PARCIAL); la API exige
// un miembro activo con rol que atiende. La sede va por FK COMPUESTA
// (SEC-004). Reglas en la BD: migración 20261020220100_dx233_provider_schedules.
model ProviderSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  providerId  String    @db.Uuid
  locationId  String    @db.Uuid
  /// Zona IANA de la sede al guardar (informativa: las reglas usan siempre la
  /// zona VIGENTE de la sede, `Location.timeZone`).
  timezone    String
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id])
  location Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  ranges   ProviderScheduleRange[]

  // Destino de la FK compuesta de los tramos (con el profesional, para que
  // el tramo no pueda mentir sobre de quién es).
  @@unique([tenantId, id, providerId], map: "provider_schedules_tenant_id_provider_key")
  // Único PARCIAL (WHERE "deletedAt" IS NULL) en la migración: un horario
  // vivo por profesional y sede. Prisma no expresa el predicado.
  @@unique([tenantId, providerId, locationId], map: "provider_schedules_live_key")
  // Lado hijo de la FK a la sede y roster por sede.
  @@index([tenantId, locationId], map: "provider_schedules_tenant_location_idx")
  @@map("provider_schedules")
}

/// Un tramo semanal (hora de pared de la sede). Se retiran en blando al
/// reemplazar el horario, como los de la sede. EXCLUDE: dos tramos vivos del
/// mismo profesional y día de la semana no se solapan, en NINGUNA sede.
model ProviderScheduleRange {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  scheduleId  String    @db.Uuid
  providerId  String    @db.Uuid
  /// 0=domingo .. 6=sábado.
  weekday     Int
  /// Minutos desde 00:00, múltiplos de 5; 0 <= start < end <= 1440.
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  schedule ProviderSchedule @relation(fields: [tenantId, scheduleId, providerId], references: [tenantId, id, providerId], onDelete: Restrict)

  @@index([tenantId, scheduleId, providerId], map: "provider_schedule_ranges_tenant_schedule_idx")
  @@index([tenantId, providerId, weekday], map: "provider_schedule_ranges_tenant_provider_weekday_idx")
  @@map("provider_schedule_ranges")
}

/// Excepción por fecha civil de la sede: prevalece sobre el semanal de esa
/// sede ese día. Sin tramos vivos = «no trabaja». Una viva por profesional,
/// sede y fecha (único parcial en la migración).
model ProviderScheduleOverride {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  providerId  String    @db.Uuid
  locationId  String    @db.Uuid
  date        DateTime  @db.Date
  /// Hasta 200 caracteres (CHECK), p. ej. «Cubre a la Dra. Ruiz».
  note        String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant                          @relation(fields: [tenantId], references: [id])
  location Location                        @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  ranges   ProviderScheduleOverrideRange[]

  @@unique([tenantId, id, providerId, date], map: "provider_schedule_overrides_tenant_id_provider_date_key")
  @@unique([tenantId, providerId, locationId, date], map: "provider_schedule_overrides_live_key")
  @@index([tenantId, providerId, date], map: "provider_schedule_overrides_tenant_provider_date_idx")
  @@index([tenantId, locationId, date], map: "provider_schedule_overrides_tenant_location_date_idx")
  @@map("provider_schedule_overrides")
}

/// Tramo de una excepción. EXCLUDE: los tramos vivos de las excepciones del
/// mismo profesional y fecha no se solapan, en NINGUNA sede.
model ProviderScheduleOverrideRange {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  overrideId  String    @db.Uuid
  providerId  String    @db.Uuid
  date        DateTime  @db.Date
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  override ProviderScheduleOverride @relation(fields: [tenantId, overrideId, providerId, date], references: [tenantId, id, providerId, date], onDelete: Restrict)

  @@index([tenantId, overrideId, providerId, date], map: "provider_schedule_override_ranges_tenant_override_idx")
  @@map("provider_schedule_override_ranges")
}

// DX-006: consentimientos informados.
//
// La PLANTILLA es de la clínica y se edita (cada cambio de título o texto sube
// `version`); el CONSENTIMIENTO firmado es una foto congelada: guarda el texto
// ya renderizado, las firmas y su hash, así que editar o desactivar la
// plantilla después no lo altera. Ver 20261016180000_patient_consents.
model ConsentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  // Texto con variables {{paciente}}, {{documento}}, {{profesional}},
  // {{clinica}}, {{fecha}} y {{tratamiento}} (ver render-consent.ts).
  body        String
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  consents PatientConsent[]

  // Destino de la FK compuesta de PatientConsent (SEC-004).
  @@unique([tenantId, id], map: "consent_templates_tenant_id_key")
  @@unique([tenantId, title], map: "consent_templates_tenant_title_key")
  @@index([tenantId, active])
  @@map("consent_templates")
}

enum ConsentSignerType {
  PATIENT
  GUARDIAN
}

// Append-only e inmutable: sin columnas de edición ni `deletedAt`. Un trigger
// de la migración rechaza cualquier UPDATE, y el DELETE dentro de un contexto
// de tenant (la app); el puerto del repositorio no tiene ni update ni delete.
model PatientConsent {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  patientId             String            @db.Uuid
  templateId            String            @db.Uuid
  templateVersion       Int
  treatmentPlanId       String?           @db.Uuid
  // Foto del documento tal como se firmó.
  title                 String
  body                  String
  signerType            ConsentSignerType
  // Quien firma: el paciente o su tutor (nombre y documento en el momento de
  // la firma).
  signerName            String
  signerDocument        String?
  professionalName      String
  // PNG en base64 (sin prefijo data:). Tope: 200 KB decodificados (CHECK).
  patientSignature      String
  professionalSignature String
  // SHA-256 (hex) de texto + firmante + firmas + signedAt (consent-hash.ts).
  contentHash           String
  // Hora del servidor, nunca del cliente.
  signedAt              DateTime
  recordedById          String            @db.Uuid
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime          @default(now())

  // FK COMPUESTAS (SEC-004): paciente, plantilla y plan del MISMO tenant; el
  // plan, además, del MISMO paciente (mismo criterio que Payment).
  patient       Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  template      ConsentTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id])
  treatmentPlan TreatmentPlan?  @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId])

  @@index([tenantId, patientId, signedAt])
  @@index([tenantId, templateId])
  @@index([tenantId, treatmentPlanId, patientId])
  @@map("patient_consents")
}

// ---------------------------------------------------------------------------
// Periodontograma (DX-007). Un examen por fecha; las medidas cuelgan de él por
// (diente FDI, sitio). Convención de recesión: `recessionMm` POSITIVO = el
// margen gingival está APICAL a la unión amelocementaria (recesión visible);
// NEGATIVO = margen coronal a la UAC (agrandamiento / pseudobolsa). Así el
// nivel de inserción clínica es NIC (CAL) = sondaje + recesión, que se CALCULA
// (no se persiste). Un examen FINAL es inmutable (app: 409; base: trigger).
// ---------------------------------------------------------------------------
enum PerioExamStatus {
  DRAFT
  FINAL
}

/// Sitios de sondaje: vestibulares MB, B, DB y linguales/palatinos ML, L, DL.
enum PerioSite {
  MB
  B
  DB
  ML
  L
  DL
}

model PerioExam {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  patientId   String          @db.Uuid
  // Usuario que realiza el examen (sale del token, nunca del cuerpo).
  providerId  String          @db.Uuid
  examDate    DateTime        @db.Date
  notes       String?
  status      PerioExamStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // Solo un DRAFT se retira (borrado blando, convención de Dentalix).
  deletedAt   DateTime?

  // FK COMPUESTA (SEC-004): el paciente es del MISMO tenant.
  patient       Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  provider      User                @relation(fields: [providerId], references: [id])
  siteMeasures  PerioSiteMeasure[]
  toothMeasures PerioToothMeasure[]

  // Destino de las FK compuestas de las medidas.
  @@unique([tenantId, id], map: "perio_exams_tenant_id_key")
  // Histórico del paciente, más reciente primero.
  @@index([tenantId, patientId, examDate(sort: Desc)])
  @@index([providerId])
  @@map("perio_exams")
}

model PerioSiteMeasure {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  examId      String    @db.Uuid
  toothFdi    Int       @db.SmallInt
  site        PerioSite
  // 0..19 mm
  probingMm   Int?      @db.SmallInt
  // -5..19 mm, positivo = recesión (ver convención arriba).
  recessionMm Int?      @db.SmallInt
  // Grado de furca 0..3.
  furcation   Int?      @db.SmallInt
  // Bitmask: BOP=1 | SUP=2 | PLAQ=4 | CALC=8.
  flags       Int       @default(0) @db.SmallInt

  exam PerioExam @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, examId, toothFdi, site], map: "perio_site_measures_exam_tooth_site_key")
  @@map("perio_site_measures")
}

model PerioToothMeasure {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  examId   String  @db.Uuid
  toothFdi Int     @db.SmallInt
  // Movilidad 0..3 (Miller).
  mobility Int?    @db.SmallInt
  // Diente omitido (ausente / no sondable): fuera de los índices.
  skipped  Boolean @default(false)

  exam PerioExam @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, examId, toothFdi], map: "perio_tooth_measures_exam_tooth_key")
  @@map("perio_tooth_measures")
}

// ---------------------------------------------------------------------------
// Recetas (DX-013). La receta EMITIDA es inmutable: guarda la foto de paciente,
// profesional, sede y medicamentos, y su SHA-256. Solo puede ANULARSE (motivo,
// autor y fecha); un trigger de la base rechaza cualquier otra modificación.
// Ver 20261016200000_prescriptions.
// ---------------------------------------------------------------------------
enum PrescriptionStatus {
  ISSUED
  VOIDED
}

// Plantilla de receta de la clínica (p. ej. «Post-exodoncia»). Editable y con
// borrado blando; la receta emitida copia los medicamentos, no la referencia.
model PrescriptionTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  notes       String?
  // Lista de medicamentos (misma forma que PrescriptionItem, sin cantidades en
  // letras): ver prescription-template.entity.ts.
  items       Json
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Único PARCIAL (solo vivas): el WHERE vive en la migración; Prisma no lo
  // expresa. NO aceptar un diff de migrate dev que lo recree sin el WHERE.
  @@unique([tenantId, name], map: "prescription_templates_tenant_name_key")
  @@index([tenantId, deletedAt])
  @@map("prescription_templates")
}

model Prescription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  locationId           String             @db.Uuid
  patientId            String             @db.Uuid
  // Quien prescribe: sale del token, nunca del cuerpo.
  professionalId       String             @db.Uuid
  country              ClinicCountry
  status               PrescriptionStatus @default(ISSUED)
  // Hora del servidor.
  issuedAt             DateTime
  // Fecha prevista de dispensación (ES) / fecha de la receta (CO).
  dispensationDate     DateTime           @db.Date
  validUntil           DateTime           @db.Date
  // Foto de los datos legales en el momento de emitir.
  patientName          String
  patientDocument      String?
  patientBirthYear     Int?
  clinicalRecordNumber String?
  professionalName     String
  professionalLicense  String
  professionalEmail    String?
  clinicName           String
  locationName         String
  locationAddress      String?
  notes                String?
  // Alerta de alergia confirmada por el profesional (y contra qué alergias).
  allergyOverride      Boolean            @default(false)
  allergyMatches       Json?
  // SHA-256 (hex) del contenido emitido (prescription-hash.ts).
  contentHash          String
  voidedAt             DateTime?
  voidedById           String?            @db.Uuid
  voidReason           String?
  createdAt            DateTime           @default(now())

  // FK COMPUESTAS (SEC-004): paciente y sede del MISMO tenant.
  patient      Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id])
  location     Location           @relation(fields: [tenantId, locationId], references: [tenantId, id])
  professional User               @relation("PrescriptionProfessional", fields: [professionalId], references: [id])
  voidedBy     User?              @relation("PrescriptionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@unique([tenantId, id], map: "prescriptions_tenant_id_key")
  // Lista del paciente, más reciente primero.
  @@index([tenantId, patientId, issuedAt(sort: Desc)])
  @@index([tenantId, locationId])
  @@index([professionalId])
  @@index([voidedById])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  prescriptionId     String  @db.Uuid
  position           Int     @db.SmallInt
  // Principio activo (DCI/DOE).
  activeIngredient   String
  brandName          String?
  concentration      String
  pharmaceuticalForm String
  route              String
  dose               String
  frequency          String
  durationDays       Int
  totalQuantity      Int
  quantityUnit       String
  // Cantidad total en letras (CO), generada por el servidor.
  quantityInWords    String
  // Nº de envases (obligatorio en ES).
  packages           Int?
  instructions       String?

  prescription Prescription @relation(fields: [tenantId, prescriptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, prescriptionId, position], map: "prescription_items_rx_position_key")
  @@map("prescription_items")
}

// DX-009: qué se hizo con un dato clínico o financiero.
enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  SIGN
  VOID
  LOGIN
  LOGIN_FAILED
  // DX-010: restablecimiento de contraseña con un enlace por email.
  PASSWORD_RESET
  EXPORT
  PRINT
  // DX-136: enviar un documento por email (el recibo de caja).
  SEND
}

// DX-009: sobre qué tipo de recurso.
enum AuditResourceType {
  SESSION
  PATIENT
  MEDICAL_HISTORY
  CLINICAL_ENTRY
  ODONTOGRAM
  PERIO_EXAM
  CONSENT
  DATA_CONSENT
  PRESCRIPTION
  TREATMENT_PLAN
  TREATMENT_PLAN_ITEM
  PAYMENT
  PAYMENT_PLAN
  ACCOUNT_STATEMENT
  CLINICAL_ENTRY_ADDENDUM
  // DX-121: mover una cita (hora y profesional antes/después).
  APPOINTMENT
  // DX-122: bloqueos de agenda y «Pendientes por agendar».
  SCHEDULE_BLOCK
  WAITLIST_ENTRY
  // DX-048: un ADMIN desbloquea el inicio de sesión de un miembro.
  STAFF_MEMBER
  // DX-136: recibo de caja de un abono (ver, reimprimir, enviar).
  PAYMENT_RECEIPT
  // DX-170: plantillas de evolución (crear, editar, desactivar).
  CLINICAL_NOTE_TEMPLATE
  // DX-191: registro de implantes (alta, anulación, tarjeta, búsqueda por lote).
  PATIENT_IMPLANT
  // SEC-009: verificar o eliminar un dominio personalizado.
  TENANT_DOMAIN
  // DX-150: gestión de cobranza (nota) y compromiso de pago (crear y su
  // cambio de estado, también el que hace el barrido diario sin usuario).
  COLLECTION_NOTE
  PAYMENT_PROMISE
  // DX-204: cambio de la política de descuentos (topes por rol y umbral).
  DISCOUNT_POLICY
  // DX-210: oferta de un hueco libre a un candidato (registrarla y su resultado).
  WAITLIST_OFFER
  // DX-027: caja por turno (abrir, cerrar, reabrir, ajustar, ver) y los
  // ajustes de caja de la clínica.
  CASH_SESSION
  // DX-212: cambios del catálogo (CUPS) y de las sedes (código REPS).
  DENTAL_CATALOG_ITEM
  LOCATION
  // DX-222: plantillas de indicaciones postoperatorias (crear, editar,
  // ejemplos) y su entrega al paciente (impresa, email o enlace de WhatsApp).
  POSTOP_TEMPLATE
  POSTOP_DELIVERY
  // DX-151: documentos del paciente (subir, ver, descargar, anular).
  PATIENT_DOCUMENT
  // DX-105: convenios y listas de precios (altas, cambios, retiros, asignaciones).
  AGREEMENT
  PRICE_LIST
  // DX-233: horario semanal de un profesional, sus excepciones por fecha y el
  // modo estricto de la clínica.
  PROVIDER_SCHEDULE
  // DX-107: lote de importación de pacientes (validar, confirmar, deshacer,
  // descargar el informe de errores).
  PATIENT_IMPORT_BATCH
}

/// Registro de auditoría (DX-009): quién vio o cambió qué dato clínico o
/// financiero, cuándo y desde dónde. APPEND-ONLY en la BD (trigger: ni UPDATE
/// ni DELETE ni TRUNCATE para el rol de la app) y con RLS forzada por tenant.
///
/// Sin FKs a propósito: es evidencia y no puede bloquear ni seguir en cascada
/// el borrado de lo que referencia (usuario, paciente, sede). Los ids se
/// resuelven bajo RLS al escribir, así que siempre son de la misma clínica.
///
/// `metadata` NUNCA lleva contenido clínico: solo ids, nombres de campos y
/// códigos (lo garantiza `sanitizeAuditMetadata`). Retención: no se borra; se
/// conserva con la historia clínica.
// DX-102: tabla PARTICIONADA por mes de `occurredAt` (migración
// 20261017130000). Las particiones (`audit_events_pYYYYMM`, `audit_events_default`)
// y los índices parciales por acción/recurso viven solo en SQL: Prisma 6 no
// modela particiones. PK compuesta porque la clave de partición tiene que
// estar en ella; el id es uuid v7 (orden temporal, inserción monótona).
model AuditEvent {
  id           String            @default(uuid(7)) @db.Uuid
  tenantId     String            @db.Uuid
  // Sede activa de la petición (X-Location-Id); NULL = vista consolidada.
  locationId   String?           @db.Uuid
  // NULL solo en LOGIN_FAILED con un email que no es de esta clínica.
  actorUserId  String?           @db.Uuid
  actorRole    ClinicRole?
  action       AuditAction
  resourceType AuditResourceType
  resourceId   String?           @db.Uuid
  patientId    String?           @db.Uuid
  // X-Request-Id de la petición (DX-023): enlaza el evento con su línea de log.
  requestId    String?
  ip           String?
  userAgent    String?
  occurredAt   DateTime          @default(now())
  metadata     Json              @default("{}")

  @@id([id, occurredAt])
  @@index([tenantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, patientId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, actorUserId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Email transaccional (DX-088)
// ---------------------------------------------------------------------------

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum EmailTemplate {
  INVITATION           @map("invitation")
  PASSWORD_RESET       @map("password-reset")
  EMAIL_VERIFY         @map("email-verify")
  REGISTRATION_NOTICE  @map("registration-notice")
  APPOINTMENT_REMINDER @map("appointment-reminder")
  PAYMENT_RECEIPT      @map("payment-receipt")
  // DX-222: enlace a las indicaciones postoperatorias.
  POST_OP_INSTRUCTIONS @map("post-op-instructions")
}

/// Registro de envíos de email (patrón outbox). NUNCA guarda el destinatario
/// ni el token en claro: `toHash` (HMAC-SHA256) y `toMasked` identifican al
/// destinatario y `payload` es el mensaje renderizado cifrado con AES-256-GCM
/// (MAIL_ENCRYPTION_KEY), que se borra al quedar SENT o FAILED. Ver la
/// migración 20261017120000_email_outbox.
model EmailOutbox {
  id            String            @id @default(uuid()) @db.Uuid
  /// NULL = email de plataforma (sin clínica); solo lo inserta y lo lee la
  /// función SECURITY DEFINER de la migración.
  tenantId      String?           @db.Uuid
  template      EmailTemplate
  toHash        String
  toMasked      String
  /// Entidad que originó el envío (p. ej. la invitación). Sin FK: el registro
  /// sobrevive a lo que referencia.
  referenceId   String?           @db.Uuid
  /// iv (12 bytes) | tag (16 bytes) | texto cifrado. NULL al terminar.
  payload       Bytes?
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  /// Tipo de error y código del proveedor; nunca su mensaje (puede llevar PII).
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sentAt        DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, referenceId, createdAt(sort: Desc)])
  @@index([tenantId, toHash, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("email_outbox")
}

/// DX-010: para qué sirve un token de un solo uso enviado por email.
enum UserTokenPurpose {
  PASSWORD_RESET
}

/// Tokens de un solo uso del USUARIO global (restablecer la contraseña; la
/// verificación de email de DX-029 añadirá su propósito). Tabla global sin
/// tenantId ni RLS, como `users` y `revoked_tokens`: el token es del usuario,
/// no de una clínica; el aislamiento por clínica lo hace el caso de uso, que
/// solo lo acepta en el host de una clínica donde el usuario tiene membresía
/// activa. NUNCA guarda el token en claro: `tokenHash` = SHA-256 (hex) de los
/// 32 bytes aleatorios. Ver la migración 20261017140000_user_tokens.
model UserToken {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  purpose       UserTokenPurpose
  tokenHash     String           @unique
  expiresAt     DateTime
  /// Se usó (un solo uso).
  usedAt        DateTime?
  /// Lo dejó sin efecto otro posterior del mismo propósito o el propio uso.
  invalidatedAt DateTime?
  createdAt     DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("user_tokens")
}

// DX-039: retención legal extendida de la historia clínica.
//   NONE      -> 15 años desde la última atención (Res. 839/2017).
//   DOUBLE    -> 30 años (casos especiales que doblan el plazo).
//   PERMANENT -> nunca se libera (p. ej. víctimas de violaciones de DD. HH./DIH).
enum RetentionExtension {
  NONE
  DOUBLE
  PERMANENT
}

enum PatientRetentionActionKind {
  EXTENSION_CHANGED
  PARTIAL_SUPPRESSION
}

/// DX-039: rastro APPEND-ONLY de los cambios de retención y de las supresiones
/// parciales de un paciente, con el MOTIVO (texto libre, por eso no va en
/// audit_events) y su autor. Trigger: ni UPDATE ni DELETE para la app;
/// `createdAt` lo fija el servidor de BD. RLS forzada por tenant.
model PatientRetentionAction {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  patientId         String                     @db.Uuid
  kind              PatientRetentionActionKind
  previousExtension RetentionExtension?
  newExtension      RetentionExtension?
  reason            String
  actorId           String                     @db.Uuid
  createdAt         DateTime                   @default(now())

  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])
  actor   User    @relation(fields: [actorId], references: [id])

  @@index([tenantId, patientId, createdAt], map: "patient_retention_actions_patient_created_idx")
  @@map("patient_retention_actions")
}

/// DX-029: alta de clínica pendiente de verificar el email. Tabla GLOBAL (aún
/// no hay clínica): sin tenantId ni RLS. Nada se crea en `tenants`/`users`
/// hasta que llega el enlace del email, así el registro no revela si el email
/// ya tenía cuenta ni permite apropiarse de uno ajeno. Nunca guarda el token
/// en claro (`tokenHash` = SHA-256 hex) ni la contraseña (`passwordHash`).
model PendingRegistration {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  clinicName   String
  subdomain    String
  fullName     String
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("pending_registrations")
}

/// DX-085: estado de un trabajo de la cola en segundo plano.
enum JobState {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// DX-085: cola de trabajos sobre Postgres (tabla de PLATAFORMA, sin RLS a
/// propósito: un worker reclama trabajos de todas las clínicas). Se reclama
/// con SQL crudo y `FOR UPDATE SKIP LOCKED` (PrismaJobRepository); se encola
/// dentro de la transacción de negocio (outbox). `payload` lleva SOLO ids.
/// Ver la migración 20261017200000_dx085_jobs.
model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `modulo.trabajo`: el handler registrado en JobRegistry.
  name           String
  /// Clínica bajo la que corre el handler (runWithTenant); NULL = plataforma.
  tenantId       String?   @db.Uuid
  payload        Json      @default("{}")
  state          JobState  @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  /// PENDING: cuándo puede empezar. RUNNING: cuándo vence el arriendo.
  runAt          DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  /// Única por (tenantId, idempotencyKey): ver el índice parcial abajo.
  idempotencyKey String?
  lockedBy       String?
  /// Tipo y código del error; nunca su mensaje.
  lastError      String?
  createdAt      DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  updatedAt      DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  finishedAt     DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([state, runAt])
  @@index([state, finishedAt])
  // PARCIALES, no declarables en Prisma:
  //   jobs_tenantId_idempotencyKey_key UNIQUE ("tenantId", "idempotencyKey")
  //     NULLS NOT DISTINCT WHERE "idempotencyKey" IS NOT NULL -> idempotencia
  //     por clínica (ON CONFLICT en PrismaJobRepository.insert).
  //   jobs_tenantId_idx ("tenantId") WHERE "tenantId" IS NOT NULL -> lado
  //     hijo de la FK a tenants.
  @@map("jobs")
}

/// DX-085: próximo tick de cada tarea programada (cron, UTC). Un solo worker
/// la bloquea por tick (SKIP LOCKED) y encola su trabajo.
model JobSchedule {
  name      String    @id
  cron      String
  nextRunAt DateTime
  lastRunAt DateTime?
  updatedAt DateTime  @default(dbgenerated("timezone('utc'::text, now())"))

  @@map("job_schedules")
}

/// DX-220 (OPS-029): latido de cada proceso worker (APP_ROLE worker|all). Lo
/// actualiza en cada vuelta del bucle; `GET /platform/jobs/stats` cuenta como
/// vivo el que latió hace menos de 60 s. Tabla de PLATAFORMA sin tenant ni
/// RLS: solo ids técnicos, versión y fechas. La purga diaria de la cola borra
/// los que llevan más de 7 días sin latir.
model JobWorker {
  /// `JobsConfig.workerId` (host:pid:aleatorio), el mismo de `jobs.lockedBy`.
  id         String   @id
  role       String
  /// APP_VERSION del proceso (p. ej. el SHA de la imagen), si se fija.
  version    String?
  startedAt  DateTime @default(dbgenerated("timezone('utc'::text, now())"))
  lastBeatAt DateTime @default(dbgenerated("timezone('utc'::text, now())"))

  @@index([lastBeatAt])
  @@map("job_workers")
}

/// DX-220: acciones de un superadmin sobre la PLATAFORMA (no sobre una
/// clínica, que van a audit_events): hoy reencolar un trabajo FAILED.
/// Append-only (trigger) y sin tenant ni RLS; nunca el payload del trabajo.
model PlatformAuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String   @db.Uuid
  /// `JOB_RETRIED` (CHECK en la migración).
  action       String
  /// `JOB` (CHECK en la migración).
  resourceType String
  resourceId   String?  @db.Uuid
  requestId    String?
  ip           String?
  userAgent    String?
  /// Solo ids y valores técnicos (nombre del trabajo, intentos, error).
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(dbgenerated("timezone('utc'::text, now())"))

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, occurredAt])
  @@index([resourceType, resourceId])
  @@map("platform_audit_events")
}

/// DX-085: canal de un mensaje saliente al paciente.
enum OutboundChannel {
  EMAIL
  WHATSAPP_LINK
  SMS
}

/// DX-085: PENDING (registrado), QUEUED (entregado al transporte, p. ej.
/// email_outbox), SENT, FAILED o CANCELLED.
enum OutboundMessageStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  CANCELLED
}

/// DX-085: registro de mensajes salientes por clínica (RLS forzada). Solo el
/// destinatario ENMASCARADO; nunca el cuerpo. Un EMAIL se entrega por
/// email_outbox con `referenceId` = este id. Ver la migración
/// 20261017200100_dx085_outbound_messages.
model OutboundMessage {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  channel         OutboundChannel
  template        String
  recipientMasked String
  /// DX-203: a quién se envió: al propio paciente o a su responsable.
  recipientKind   OutboundRecipientKind @default(PATIENT)
  status          OutboundMessageStatus @default(PENDING)
  attempts        Int                   @default(0)
  lastError       String?
  appointmentId   String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sentAt          DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK COMPUESTA (SEC-004): la cita tiene que ser del MISMO tenant.
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  reminders AppointmentReminder[]

  // Destino de la FK compuesta de appointment_reminders (DX-026).
  @@unique([tenantId, id], map: "outbound_messages_tenant_id_key")
  @@index([tenantId, appointmentId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("outbound_messages")
}

/// DX-026: ajustes de recordatorio automático por email de una sede. Sin fila
/// = desactivado. `leadHours`: hasta 3 antelaciones en horas (1..168), de
/// mayor a menor; activo exige al menos una (CHECK).
model LocationReminderSettings {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  locationId  String   @db.Uuid
  enabled     Boolean  @default(false)
  leadHours   Int[]    @default([])
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK COMPUESTA (SEC-004): la sede tiene que ser del MISMO tenant.
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, locationId], map: "location_reminder_settings_tenant_location_key")
  @@map("location_reminder_settings")
}

enum AppointmentReminderStatus {
  SENDING
  SENT
  SKIPPED
  FAILED
}

enum AppointmentReminderSkipReason {
  NO_EMAIL
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
  DELETED
  DISABLED
  TOO_LATE
  // DX-128: el paciente se dio de baja, o su canal no es el email.
  OPTED_OUT
  CHANNEL_NONE
  CHANNEL_WHATSAPP
  // DX-200: el paciente ya está en la clínica (llegó, en sillón o listo).
  IN_CLINIC
}

/// DX-026: un recordatorio de una cita por (antelación, hora de inicio). Guarda
/// el id del mensaje en outbound_messages, nunca su cuerpo. SENDING solo dura
/// mientras el handler lo entrega a email_outbox.
model AppointmentReminder {
  id                String                         @id @default(uuid()) @db.Uuid
  tenantId          String                         @db.Uuid
  appointmentId     String                         @db.Uuid
  leadHours         Int
  appointmentStart  DateTime
  status            AppointmentReminderStatus      @default(SENDING)
  skipReason        AppointmentReminderSkipReason?
  /// Solo describeJobError: tipo/código, nunca mensaje ni datos del paciente.
  failureReason     String?                        @db.VarChar(200)
  outboundMessageId String?                        @db.Uuid
  sentAt            DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // FK COMPUESTA (SEC-004): la cita tiene que ser del MISMO tenant.
  appointment     Appointment      @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  // FK COMPUESTA al mensaje del registro de salientes, del MISMO tenant.
  outboundMessage OutboundMessage? @relation(fields: [tenantId, outboundMessageId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, appointmentId, leadHours, appointmentStart], map: "appointment_reminders_tenant_appointment_lead_start_key")
  // PARCIAL (WHERE "outboundMessageId" IS NOT NULL), no declarable en Prisma:
  //   appointment_reminders_tenant_outbound_idx ("tenantId", "outboundMessageId")
  //     -> lado hijo de la FK compuesta a outbound_messages.
  @@map("appointment_reminders")
}

enum LoginThrottleScope {
  ACCOUNT
  IP
}

/// DX-048 (SEC-028): fallos de login por cuenta (hash del email normalizado)
/// y por IP (hash), compartidos entre réplicas. Solo cuenta FALLOS: un login
/// correcto borra la fila de su cuenta. Tabla de plataforma sin tenantId ni
/// RLS (como revoked_tokens): no guarda emails, IPs ni nada de la clínica.
/// Se escribe con SQL atómico en PrismaLoginThrottleRepository y la purga el
/// trabajo horario de tokens.
model LoginThrottle {
  scope           LoginThrottleScope
  /// SHA-256 en hex (CHECK en la BD), con prefijo de dominio.
  keyHash         String
  failures        Int
  windowStartedAt DateTime
  lastFailureAt   DateTime
  /// Hasta cuándo se responde 429 sin mirar la contraseña.
  blockedUntil    DateTime?

  @@id([scope, keyHash])
  @@index([lastFailureAt])
  @@map("login_throttles")
}

// ---------------------------------------------------------------------------
// Recibo de caja por abono (DX-136)
// ---------------------------------------------------------------------------

/// Último número emitido por serie de recibos. La API lo incrementa con un
/// UPSERT en la MISMA transacción que el abono: sin duplicados (bloqueo de la
/// fila) y sin huecos (un rollback deshace el incremento). Un trigger solo lo
/// deja avanzar de uno en uno y nunca borrarlo. RLS forzada por clínica.
model PaymentReceiptCounter {
  tenantId     String @db.Uuid
  seriesPrefix String
  lastNumber   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, seriesPrefix])
  @@map("payment_receipt_counters")
}

/// Recibo de caja de un abono: serie de la sede + número consecutivo y la foto
/// (`snapshot`) de lo que se imprime, congelada al emitir. Append-only en la
/// BD: un trigger solo deja marcarlo anulado una vez y nunca borrarlo; el
/// número tiene que ser el que acaba de dar el contador de su serie. Ver la
/// migración 20261017233200_dx136_payment_receipts.
model PaymentReceipt {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  locationId   String    @db.Uuid
  paymentId    String    @unique @db.Uuid
  seriesPrefix String
  number       Int
  /// La pone el servidor de BD (trigger).
  issuedAt     DateTime  @default(now())
  /// Puntero suave a User, como `Payment.createdById`.
  issuedById   String?   @db.Uuid
  /// `ReceiptSnapshot` (src/modules/payments/domain/receipt-snapshot.ts).
  snapshot     Json
  voidedAt     DateTime?
  voidedById   String?   @db.Uuid
  voidReason   String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  // Por la clave primaria del abono; que sea de la misma clínica y sede lo
  // exige el trigger de inserción (ver la migración).
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, seriesPrefix, number], map: "payment_receipts_tenant_series_number_key")
  @@index([tenantId, locationId, issuedAt(sort: Desc)])
  @@map("payment_receipts")
}

