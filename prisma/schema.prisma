generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  subdomain                String                    @unique
  primaryColor             String                    @default("#0F5E9C")
  logoUrl                  String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  memberships              ClinicMembership[]
  domains                  TenantDomain[]
  invitations              ClinicInvitation[]
  appointmentConfirmations AppointmentConfirmation[]
  privacyPolicyVersions    PrivacyPolicyVersion[]
  dataProcessingConsents   DataProcessingConsent[]
  consentTemplates         ConsentTemplate[]
  prescriptionTemplates    PrescriptionTemplate[]

  @@map("tenants")
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  fullName        String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  // Superadmin de PLATAFORMA: transversal a todos los tenants (por eso no es
  // un ClinicRole, que siempre es por-clínica vía ClinicMembership). Se otorga
  // SOLO por migración; ningún endpoint lo concede.
  isPlatformAdmin Boolean            @default(false)
  // Versión de sesión: viaja en el claim `tv` de cada token y /auth/refresh
  // exige que coincida. Incrementarla invalida TODOS los refresh tokens del
  // usuario a la vez (lo hace el cambio de contraseña). Los tokens anteriores
  // a esta columna no traen `tv` y cuentan como 0.
  tokenVersion    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  memberships     ClinicMembership[]

  privacyPoliciesPublished PrivacyPolicyVersion[]
  dataConsentsRecorded     DataProcessingConsent[]
  perioExamsPerformed      PerioExam[]
  prescriptionsIssued      Prescription[]            @relation("PrescriptionProfessional")
  prescriptionsVoided      Prescription[]            @relation("PrescriptionVoidedBy")
  planAcceptancesRecorded  TreatmentPlanAcceptance[]

  @@map("users")
}

enum ClinicRole {
  DENTIST
  ASSISTANT
  RECEPTION
  ADMIN
}

/// Sede/sucursal física de una clínica. La sede es una dimensión de filtrado
/// DENTRO del tenant, no un nivel de aislamiento: el RLS por tenant sigue
/// siendo la frontera dura. Pacientes, historia y catálogo NO llevan sede —
/// la ficha del paciente es de la clínica (ver docs/plans/2026-08-01-multi-sede.md).
/// País donde opera una sede (DX-013). Decide los campos legales obligatorios
/// de la receta: CO (Dec. 780/2016 art. 2.5.3.10.16) o ES (RD 1718/2010 art. 3).
enum ClinicCountry {
  CO
  ES
}

model Location {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  name      String
  address   String?
  // País de la sede (DX-013): la receta se emite con las reglas del país donde
  // se atiende. Por defecto CO, que es lo que eran todas las sedes hasta hoy.
  country   ClinicCountry @default(CO)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  appointments       Appointment[]
  payments           Payment[]
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  prescriptions      Prescription[]
  planAcceptances    TreatmentPlanAcceptance[]
  presentedPlans     TreatmentPlan[]

  // Destino de las FK compuestas (tenantId, locationId) de citas, pagos e
  // inventario: la sede tiene que ser del MISMO tenant (SEC-004).
  @@unique([tenantId, id], map: "locations_tenant_id_key")
  @@index([tenantId])
  @@map("locations")
}

model ClinicMembership {
  id                  String     @id @default(uuid()) @db.Uuid
  tenantId            String     @db.Uuid
  userId              String     @db.Uuid
  role                ClinicRole
  // Registro profesional (CO: RETHUS / tarjeta profesional) o nº de colegiado
  // (ES) del miembro EN ESTA CLÍNICA (DX-013). Lo exige la receta.
  professionalLicense String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?
  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  user                User       @relation(fields: [userId], references: [id])

  // PARTIAL unique (WHERE "deletedAt" IS NULL) — a soft-deleted membership must
  // NOT block re-adding the same user. The predicate lives in migration
  // 20260731163000_clinic_membership_partial_unique (Prisma can't express it);
  // the name/columns here keep migrate-status drift-free. Same pattern as
  // users_email_key. Do NOT accept a migrate-dev diff that makes this full again.
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("clinic_memberships")
}

model ClinicInvitation {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  email       String
  fullName    String
  role        ClinicRole
  tokenHash   String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Único PARCIAL (solo pendientes) — el WHERE vive en la migración
  // 20260801120000_add_clinic_invitations; Prisma no lo expresa. Declarado
  // aquí con el mismo nombre/columnas para que migrate status no vea drift.
  // NO aceptar un diff de migrate dev que lo recree sin el WHERE.
  @@unique([tenantId, email], map: "clinic_invitations_pending_key")
  @@index([tenantId])
  @@index([tokenHash])
  @@map("clinic_invitations")
}

enum DocType {
  CC
  TI
  CE
  PASSPORT
  OTHER
}

enum Sex {
  M
  F
  OTHER
  UNSPECIFIED
}

model Patient {
  id                           String    @id @default(uuid()) @db.Uuid
  tenantId                     String    @db.Uuid
  firstName                    String
  lastName                     String
  docType                      DocType   @default(CC)
  docNumber                    String?
  birthDate                    DateTime?
  sex                          Sex       @default(UNSPECIFIED)
  phone                        String?
  email                        String?
  address                      String?
  countryCode                  String?
  cityId                       Int?
  notes                        String?
  // DEPRECADO (DX-037): resumen DERIVADO de la última fila GENERAL de
  // `data_processing_consents`, que es la prueba de la autorización Ley 1581.
  // Se sigue escribiendo (en la misma transacción que la fila) solo para no
  // romper a los clientes que lo leen; nunca es la fuente de verdad.
  dataConsentAccepted          Boolean   @default(false)
  dataConsentAt                DateTime?
  dataConsentPolicyVersion     String?
  // Identificación ampliada.
  maritalStatus                String?
  occupation                   String?
  insurerEps                   String?
  physicianName                String?
  physicianPhone               String?
  // Contacto de emergencia / acudiente.
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  guardianName                 String?
  guardianDocNumber            String?
  createdById                  String?   @db.Uuid
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  medicalHistoryVersions MedicalHistoryVersion[]
  clinicalEntries        ClinicalEntry[]
  toothRecords           ToothRecord[]
  appointments           Appointment[]
  treatmentPlans         TreatmentPlan[]
  dataProcessingConsents DataProcessingConsent[]
  consents               PatientConsent[]
  perioExams             PerioExam[]
  prescriptions          Prescription[]
  country                Country?                @relation(fields: [countryCode], references: [code])
  city                   City?                   @relation(fields: [cityId], references: [id])

  @@unique([tenantId, docNumber], map: "patients_tenant_doc_key")
  // Requisito de las FK COMPUESTAS de Appointment, TreatmentPlan,
  // MedicalHistoryVersion, ClinicalEntry y ToothRecord: permite referenciar un
  // paciente exigiendo que el tenant coincida, cerrando el cross-tenant a
  // nivel DB (las FK de Postgres se chequean saltando la RLS, así que una FK
  // a `id` sola no basta). Ver 20261015130000_tenant_composite_fks (SEC-004).
  @@unique([tenantId, id], map: "patients_tenant_id_key")
  @@index([tenantId])
  @@map("patients")
}

model MedicalHistoryVersion {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  version          Int
  // Listas/objetos estructurados (snapshot inmutable por versión).
  allergies        Json?
  conditions       Json?
  medications      Json?
  habits           Json?
  dentalHistory    Json?
  surgeries        Json?
  vitalSigns       Json?
  familyHistory    String?
  notes            String?
  // Banderas denormalizadas — calculadas en el dominio (deriveSafetyFlags).
  safetyFlags      Json?
  hasCriticalAlert Boolean   @default(false)
  createdById      String?   @db.Uuid
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, patientId, version], map: "mhv_tenant_patient_version_key")
  @@index([tenantId, patientId])
  @@index([tenantId, hasCriticalAlert])
  @@map("medical_history_versions")
}

model ClinicalEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  patientId     String    @db.Uuid
  entryDate     DateTime
  reason        String?
  notes         String
  performedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@index([tenantId, patientId, entryDate])
  @@map("clinical_entries")
}

enum CatalogKind {
  DIAGNOSIS
  PROCEDURE
}

model DentalCatalogItem {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @db.Uuid
  code         String
  category     String?
  kind         CatalogKind
  labelEs      String
  labelEn      String?
  labelPt      String?
  color        String
  defaultPrice Decimal?    @db.Decimal(12, 2)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, code], map: "catalog_tenant_code_key")
  @@index([tenantId])
  @@map("dental_catalog_items")
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  VESTIBULAR
  LINGUAL
}

enum ToothRecordStatus {
  PLANNED
  COMPLETED
}

model ToothRecord {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  patientId        String            @db.Uuid
  toothNumber      String
  surfaces         ToothSurface[]
  kind             CatalogKind
  catalogItemId    String?           @db.Uuid
  status           ToothRecordStatus @default(COMPLETED)
  notes            String?
  clinicalEntryId  String?           @db.Uuid
  performedById    String?           @db.Uuid
  // Set when this record was auto-created because a TreatmentPlanItem was
  // marked DONE (Pieza B). Soft pointer (no FK/relation): used to dedupe so a
  // given plan item mirrors into the odontogram at most once. Null for records
  // created directly in the odontogram.
  sourcePlanItemId String?           @db.Uuid
  recordedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  // PARCIAL (WHERE "sourcePlanItemId" IS NOT NULL AND "deletedAt" IS NULL): un
  // ítem de plan se espeja como mucho una vez (DX-042). El WHERE vive en
  // 20261016130000_domain_checks; aquí mismo nombre y columnas.
  @@unique([tenantId, sourcePlanItemId], map: "tooth_records_source_plan_item_key")
  @@index([tenantId, patientId])
  @@index([tenantId, patientId, toothNumber])
  @@index([tenantId, sourcePlanItemId])
  @@map("tooth_records")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @db.Uuid
  locationId          String            @db.Uuid
  patientId           String            @db.Uuid
  providerId          String            @db.Uuid
  start               DateTime
  end                 DateTime
  status              AppointmentStatus @default(SCHEDULED)
  reason              String?
  notes               String?
  createdById         String?           @db.Uuid
  // DX-005: cuándo recepción generó el último enlace de confirmación vigente
  // (null = nunca, o se invalidó al reagendar/cambiar el estado a mano).
  confirmationSentAt  DateTime?
  // DX-005: el paciente pulsó "Quiero que me llamen" en el enlace. Se limpia
  // cuando recepción reagenda o cambia el estado de la cita.
  callbackRequestedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  confirmations AppointmentConfirmation[]

  // FK COMPUESTA a propósito: exige que el paciente sea del MISMO tenant.
  // Antes era `[patientId] -> [id]`, que solo garantizaba "el paciente existe
  // en algún tenant" (las FK saltan la RLS), así que se podía agendar contra
  // un paciente de otra clínica.
  patient  Patient  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // Destino de la FK compuesta (tenantId, appointmentId) de
  // appointment_confirmations (DX-005): la cita tiene que ser del MISMO tenant.
  @@unique([tenantId, id], map: "appointments_tenant_id_key")
  @@index([tenantId, providerId, start])
  @@index([tenantId, patientId])
  // Ya existía en SQL (20260801150000_add_locations) sin declararse aquí; se
  // declara para que migrate diff no lo vea como drift. Indexa además el lado
  // hijo de la FK compuesta (tenantId, locationId).
  @@index([tenantId, locationId])
  @@map("appointments")
}

// DX-005: respuesta del paciente en el enlace público de confirmación.
enum AppointmentConfirmationResponse {
  CONFIRM
  CANCEL
  CALL_ME
}

// DX-005: enlace firmado de un solo uso para que el paciente confirme, cancele
// o pida que lo llamen. Solo se guarda el HASH del token (sha256); el texto
// plano viaja únicamente en el enlace. `appointmentStart`/`appointmentStatus`
// son la foto de la cita al emitirlo: si la cita se reagenda o cambia de
// estado, el enlace deja de valer.
model AppointmentConfirmation {
  id                String                           @id @default(uuid()) @db.Uuid
  tenantId          String                           @db.Uuid
  appointmentId     String                           @db.Uuid
  tokenHash         String
  expiresAt         DateTime
  appointmentStart  DateTime
  appointmentStatus AppointmentStatus
  respondedAt       DateTime?
  response          AppointmentConfirmationResponse?
  revokedAt         DateTime?
  createdById       String?                          @db.Uuid
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  // FK COMPUESTA (SEC-004): la cita tiene que ser del MISMO tenant. CASCADE:
  // el enlace es dato derivado de la cita, que en el producto nunca se borra
  // en duro (no-hard-delete); solo afecta a la limpieza administrativa.
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([tenantId, appointmentId])
  @@map("appointment_confirmations")
}

// DX-037: autorización de tratamiento de datos (Ley 1581 / Dec. 1377).
// GENERAL = datos personales; SENSITIVE_HEALTH = datos sensibles de salud
// (exige consentimiento expreso y separado); MARKETING = finalidades
// comerciales (recordatorios comerciales, campañas), siempre opcional.
enum DataConsentScope {
  GENERAL
  SENSITIVE_HEALTH
  MARKETING
}

// IN_PERSON = registrado por el personal en la clínica con el texto vigente a
// la vista. LEGACY = sin prueba suficiente: migrado del antiguo booleano
// `Patient.dataConsentAccepted` o enviado por un cliente con ese campo
// deprecado.
enum DataConsentChannel {
  IN_PERSON
  LEGACY
}

// DX-037: versión publicada de la política de tratamiento de datos de UNA
// clínica. Inmutable una vez publicada: no hay endpoint de edición y un
// trigger de BD rechaza todo UPDATE (ver 20261016170000_data_processing_consents).
// Una versión nueva es una fila nueva con `version` + 1.
model PrivacyPolicyVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  version             Int
  // Texto completo de la política (aviso de privacidad).
  policyText          String
  // Texto de cada casilla: lo que el titular autoriza, scope a scope.
  generalText         String
  sensitiveHealthText String
  marketingText       String
  // sha256 de los cuatro textos: identifica el contenido exacto aceptado.
  contentHash         String
  publishedAt         DateTime @default(now())
  publishedById       String   @db.Uuid

  tenant      Tenant                  @relation(fields: [tenantId], references: [id])
  publishedBy User                    @relation(fields: [publishedById], references: [id])
  consents    DataProcessingConsent[]

  @@unique([tenantId, version], map: "privacy_policy_versions_tenant_version_key")
  // Destino de la FK compuesta de data_processing_consents (SEC-004).
  @@unique([tenantId, id], map: "privacy_policy_versions_tenant_id_key")
  @@map("privacy_policy_versions")
}

// DX-037: prueba de la autorización de datos. APPEND-ONLY: una revocación es
// una fila nueva con `granted = false`; el estado vigente de cada scope es su
// última fila (por `recordedAt`). `recordedAt` lo pone el servidor. Un trigger
// de BD rechaza todo UPDATE (y todo DELETE salvo de un superusuario).
model DataProcessingConsent {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  patientId           String             @db.Uuid
  // NULL solo en filas LEGACY (CHECK en la migración): el booleano antiguo
  // no guardaba el texto aceptado.
  policyVersionId     String?            @db.Uuid
  // Etiqueta de versión que traía el booleano antiguo (p. ej. "v1"). Solo LEGACY.
  legacyPolicyVersion String?
  scope               DataConsentScope
  granted             Boolean
  channel             DataConsentChannel
  // NULL solo en filas LEGACY migradas (CHECK en la migración).
  recordedById        String?            @db.Uuid
  recordedAt          DateTime           @default(now())
  ipAddress           String?
  userAgent           String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  // FK COMPUESTAS (SEC-004): paciente y versión de política del MISMO tenant.
  patient       Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id])
  policyVersion PrivacyPolicyVersion? @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  recordedBy    User?                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantId, patientId, scope, recordedAt])
  @@index([tenantId, policyVersionId])
  @@map("data_processing_consents")
}

// Máquina de estados en el dominio (DX-040, `domain/plan-status-machine.ts`):
// DRAFT → PRESENTED → ACCEPTED | REJECTED; DRAFT → ACCEPTED; ACCEPTED →
// COMPLETED; cualquiera salvo COMPLETED → CANCELLED.
enum TreatmentPlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// Por qué el paciente no aceptó un plan presentado (DX-040). El personal elige
// cualquiera salvo OTHER_OPTION_ACCEPTED, que lo pone el sistema al aceptar
// otra opción del mismo grupo. OTHER exige una nota.
enum TreatmentPlanRejectionReason {
  PRICE
  FEAR
  SECOND_OPINION
  OTHER_OPTION_ACCEPTED
  OTHER
}

enum TreatmentPlanItemStatus {
  PROPOSED
  ACCEPTED
  DONE
}

model TreatmentPlan {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  patientId   String              @db.Uuid
  status      TreatmentPlanStatus @default(DRAFT)
  // Moneda del plan: monto a pagar/saldo se calculan en esta moneda; un abono
  // en otra moneda se convierte por su fecha (ver Payment/ConvertAmountUseCase).
  currency    String              @default("USD")
  notes       String?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  // Alternativas A/B (DX-040). `optionGroupId` es el id del plan que abrió el
  // grupo (ese plan apunta a sí mismo); null = plan suelto. `optionLabel`
  // ("Opción A: implante") distingue las opciones ante el paciente.
  optionGroupId       String?                       @db.Uuid
  optionLabel         String?
  // Presentado al paciente: cuándo y en qué sede (la del request o la
  // principal). La lista de presupuestos por seguir filtra por esa sede.
  presentedAt         DateTime?
  presentedLocationId String?                       @db.Uuid
  // Rechazado: cuándo, por qué (catálogo) y la nota (obligatoria con OTHER).
  rejectedAt          DateTime?
  rejectionReason     TreatmentPlanRejectionReason?
  rejectionNote       String?

  // FK COMPUESTA (tenantId, patientId) -> patients(tenantId, id): exige que el
  // paciente sea del MISMO tenant (mismo criterio que Appointment.patient;
  // SEC-004, 20261015130000_tenant_composite_fks).
  patient            Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  // FK COMPUESTA al plan raíz del grupo (DX-040): las opciones de un grupo
  // son del MISMO tenant y del MISMO paciente. NO ACTION (no RESTRICT): un
  // DELETE que se lleva el grupo entero de una vez (limpieza de tests) pasa.
  optionGroupRoot    TreatmentPlan?           @relation("TreatmentPlanOptionGroup", fields: [tenantId, optionGroupId, patientId], references: [tenantId, id, patientId], onDelete: NoAction, onUpdate: NoAction, map: "treatment_plans_option_group_fkey")
  optionGroupMembers TreatmentPlan[]          @relation("TreatmentPlanOptionGroup")
  // Sede donde se presentó, del MISMO tenant.
  presentedLocation  Location?                @relation(fields: [tenantId, presentedLocationId], references: [tenantId, id], onDelete: Restrict, map: "treatment_plans_presented_location_fkey")
  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef        Currency                 @relation(fields: [currency], references: [code])
  items              TreatmentPlanItem[]
  payments           Payment[]
  paymentPlans       PaymentPlan[]
  consents           PatientConsent[]
  // Aceptación firmada del presupuesto (DX-012): como mucho una por plan.
  acceptance         TreatmentPlanAcceptance?

  // Destinos de FK compuestas (SEC-004): (tenantId, id) para los ítems del
  // plan; (tenantId, id, patientId) para pagos y planes de pago, que además
  // garantiza que su `patientId` denormalizado sea el del plan.
  @@unique([tenantId, id], map: "treatment_plans_tenant_id_key")
  @@unique([tenantId, id, patientId], map: "treatment_plans_tenant_id_patient_key")
  @@index([tenantId, patientId])
  // Opciones de un grupo (lado hijo de la FK al plan raíz).
  @@index([tenantId, optionGroupId, patientId])
  // Presupuestos por seguir: PRESENTED por antigüedad de la presentación.
  @@index([tenantId, status, presentedAt])
  // Lado hijo de la FK a la sede de presentación (filtro por sede).
  @@index([tenantId, presentedLocationId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @db.Uuid
  planId        String                  @db.Uuid
  toothNumber   String
  surfaces      ToothSurface[]
  catalogItemId String                  @db.Uuid
  price         Decimal                 @db.Decimal(12, 2)
  // Descuento del ítem en la moneda del plan (DX-012). CHECK 0 <= discount <= price
  // (treatment_plan_items_discount_nonneg / _subtotal_nonneg).
  discount      Decimal                 @default(0) @db.Decimal(12, 2)
  status        TreatmentPlanItemStatus @default(PROPOSED)
  notes         String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?

  plan TreatmentPlan @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, planId])
  @@map("treatment_plan_items")
}

// ---------------------------------------------------------------------------
// Aceptación firmada del presupuesto de un plan (DX-012). Foto congelada del
// contenido que se presentó (JSONB) + su SHA-256, la firma (PNG base64), quién
// firmó, cuándo (hora del servidor) y en qué sede. Una por plan; append-only:
// un trigger rechaza UPDATE y DELETE, y otros dos congelan los ítems y la
// moneda del plan aceptado (20261016213000_treatment_plan_acceptances).
// ---------------------------------------------------------------------------
model TreatmentPlanAcceptance {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  planId         String   @db.Uuid
  patientId      String   @db.Uuid
  locationId     String   @db.Uuid
  signerName     String
  // PNG en base64 (sin prefijo data:). Tope: 200 KB decodificados (CHECK).
  signature      String
  // El presupuesto tal como se mostró y se firmó (plan-quote.ts).
  content        Json
  // SHA-256 (hex) del contenido presentado.
  contentHash    String
  // SHA-256 (hex) de contentHash + firmante + firma + acceptedAt.
  acceptanceHash String
  acceptedAt     DateTime
  acceptedById   String   @db.Uuid
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  // FK COMPUESTAS (SEC-004): plan del MISMO tenant y del MISMO paciente; sede
  // del MISMO tenant.
  plan       TreatmentPlan @relation(fields: [tenantId, planId, patientId], references: [tenantId, id, patientId])
  location   Location      @relation(fields: [tenantId, locationId], references: [tenantId, id])
  acceptedBy User          @relation(fields: [acceptedById], references: [id])

  // Una aceptación por plan (volver a firmar: 409).
  @@unique([tenantId, planId, patientId], map: "treatment_plan_acceptances_plan_key")
  @@index([tenantId, patientId])
  @@index([tenantId, locationId])
  @@index([acceptedById])
  @@map("treatment_plan_acceptances")
}

// Tasas de cambio (referencia/mercado, base USD). Tabla GLOBAL, no de dominio:
// no lleva tenantId ni RLS ni deletedAt (excepción técnica documentada en la
// migración, igual que cache/colas). Snapshot inmutable por (date, currency);
// `date` es String YYYY-MM-DD (día del snapshot, sin ambigüedad de timezone).
model ExchangeRateSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  date      String
  currency  String
  rate      Decimal  @db.Decimal(18, 8)
  fetchedAt DateTime @default(now())

  @@unique([date, currency])
  @@map("exchange_rate_snapshots")
}

// Catálogos de referencia GLOBALES (moneda/país/ciudad). Misma excepción que
// ExchangeRateSnapshot: sin tenantId, sin RLS, sin deletedAt. Currency es
// además la whitelist de códigos ISO 4217 aceptados en planes/abonos.
model Currency {
  code   String @id // ISO 4217, p.ej. "USD"
  name   String // "Dólar estadounidense"
  symbol String // "$"

  // FK de `currency` (DX-042, 20261016131000_currency_fks).
  treatmentPlans TreatmentPlan[]
  payments       Payment[]
  paymentPlans   PaymentPlan[]

  @@map("currencies")
}

model Country {
  code     String    @id // ISO 3166-1 alpha-2, p.ej. "CO"
  name     String // "Colombia"
  cities   City[]
  patients Patient[]

  @@map("countries")
}

model City {
  id          Int       @id @default(autoincrement())
  countryCode String
  name        String
  region      String? // estado/departamento (informativo)
  country     Country   @relation(fields: [countryCode], references: [code])
  patients    Patient[]

  @@index([countryCode, name])
  @@map("cities")
}

enum TenantDomainStatus {
  PENDING
  VERIFIED
}

model TenantDomain {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  // PARTIAL unique (WHERE "deletedAt" IS NULL) — a soft-deleted host must be
  // re-registerable. Predicate lives in migration
  // 20260731164000_tenant_domain_partial_unique (Prisma can't express it); the
  // name (tenant_domains_host_key) keeps migrate-status drift-free.
  host        String             @unique
  status      TenantDomainStatus @default(PENDING)
  verifyToken String
  verifiedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  tenant      Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("tenant_domains")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

// Abono contra un Plan de Tratamiento (reemplaza Sale/SaleLineItem — ver
// docs/plans/2026-07-24-payments-pivot.md). Saldo vive por plan: monto a
// pagar = Σ item.price con status ACCEPTED|DONE; saldo = eso − Σ abonos
// activos (cada uno convertido a `plan.currency` por su propia `paidAt` vía
// ConvertAmountUseCase). `patientId` está denormalizado del plan para poder
// listar abonos por paciente sin join. Anular abono = soft-delete (`deletedAt`).
model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  locationId      String         @db.Uuid
  treatmentPlanId String         @db.Uuid
  patientId       String         @db.Uuid
  amount          Decimal        @db.Decimal(14, 2)
  currency        String
  paidAt          DateTime
  method          PaymentMethod?
  notes           String?
  idempotencyKey  String?
  createdById     String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  // Anulación (SEC-013, migración 20261016160000_payment_void_audit): quién,
  // cuándo y por qué. Puntero suave a User como createdById (sin relación).
  voidedById      String?        @db.Uuid
  voidedAt        DateTime?
  voidReason      String?

  // FK COMPUESTAS (SEC-004): el plan y la sede tienen que ser del MISMO tenant,
  // y `patientId` (denormalizado) tiene que ser el paciente del plan. Por
  // transitividad el paciente también es del tenant (treatment_plans ya tiene
  // su FK compuesta a patients), sin una tercera FK.
  plan     TreatmentPlan @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef Currency @relation(fields: [currency], references: [code])

  // Idempotency dedup for POST payments. Prisma's `@@unique` would emit a FULL
  // unique index; the migration 20260731160000_add_payment_idempotency_key
  // instead creates it PARTIAL (WHERE "idempotencyKey" IS NOT NULL) so NULL
  // keys (legacy rows + writes without the header) stay unconstrained, while a
  // non-null key is unique per tenant. Same name+columns as declared here, so
  // migrate status/deploy see no drift. Do NOT accept a migrate-dev diff that
  // recreates this as a full index.
  @@unique([tenantId, idempotencyKey], map: "payments_tenant_idempotency_key")
  @@index([tenantId, treatmentPlanId])
  @@index([tenantId, patientId])
  // Ya existía en SQL (20260801150000_add_locations) sin declararse aquí; se
  // declara para que migrate diff no lo vea como drift. Indexa además el lado
  // hijo de la FK compuesta (tenantId, locationId).
  @@index([tenantId, locationId])
  // Partial (WHERE "deletedAt" IS NULL) -- Prisma has no schema-DSL support
  // for filtered indexes, so the WHERE lives only in the migration SQL
  // (see 20260726010000_payments_tenant_paidat_index). The explicit `map`
  // keeps the name+columns in sync with that hand-written index so
  // `prisma migrate status`/`migrate deploy` see no drift. Same approach as
  // Patient.@@unique(patients_tenant_doc_key) / the tenants_subdomain_key
  // and users_email_key partial unique indexes.
  @@index([tenantId, paidAt], map: "payments_tenantId_paidAt_active_idx")
  // La caja con una sede activa (GET /payments + X-Location-Id) filtra
  // tenantId + locationId + rango de paidAt + deletedAt IS NULL. Parcial igual
  // que el de arriba: el WHERE vive solo en la migración
  // 20261015120000_payments_tenant_location_paidat_index, y el `map` mantiene
  // nombre+columnas en sync para que migrate status/deploy no vean drift. Un
  // `prisma migrate dev` puede proponer "arreglarlo" a índice completo: NO
  // aceptes ese diff.
  @@index([tenantId, locationId, paidAt], map: "payments_tenantId_locationId_paidAt_active_idx")
  @@map("payments")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentPeriodicity {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model PaymentPlan {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @db.Uuid
  treatmentPlanId   String                 @db.Uuid
  patientId         String                 @db.Uuid
  currency          String
  totalToFinance    Decimal                @db.Decimal(14, 2)
  downPayment       Decimal                @default(0) @db.Decimal(14, 2)
  installmentsCount Int
  periodicity       InstallmentPeriodicity
  startDate         DateTime
  status            PaymentPlanStatus      @default(ACTIVE)
  notes             String?
  createdById       String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  // FK COMPUESTA (SEC-004): mismo criterio que Payment.plan (tenant + paciente
  // denormalizado coherentes con el plan de tratamiento).
  plan         TreatmentPlan @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId], onDelete: Restrict)
  installments Installment[]

  // La moneda existe en el catálogo `currencies` (DX-042).
  currencyRef Currency @relation(fields: [currency], references: [code])

  // Destino de la FK compuesta de Installment (SEC-004).
  @@unique([tenantId, id], map: "payment_plans_tenant_id_key")
  @@index([tenantId, treatmentPlanId])
  @@index([tenantId, patientId])
  // Hand-written partial unique index (WHERE status = 'ACTIVE' AND
  // deletedAt IS NULL) on (tenantId, treatmentPlanId) exists in SQL only --
  // see 20260731120000_payment_plan_active_unique. Prisma's schema DSL
  // can't express a filtered/partial unique constraint (same rationale as
  // Payment.@@index([tenantId, paidAt], map: "payments_tenantId_paidAt_active_idx")
  // above), so it is not declared here; `prisma migrate status` won't show
  // it, and that's expected -- do not "fix" this by adding a plain
  // @@unique, which would wrongly forbid multiple CANCELLED/COMPLETED
  // plans per treatment plan.
  @@map("payment_plans")
}

model Installment {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  paymentPlanId String   @db.Uuid
  sequence      Int
  dueDate       DateTime
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// `Restrict`, no `Cascade`: `PaymentPlan` se anula en blando (status
  /// CANCELLED + deletedAt), nunca se borra. Un DELETE duro del plan sería un
  /// error, y con Cascade se llevaba las cuotas sin dejar rastro.
  /// FK compuesta (tenantId, paymentPlanId): el plan de pagos es del MISMO tenant (SEC-004).
  paymentPlan PaymentPlan @relation(fields: [tenantId, paymentPlanId], references: [tenantId, id], onDelete: Restrict)

  @@unique([paymentPlanId, sequence])
  @@index([tenantId, dueDate])
  @@map("installments")
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model InventoryItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  locationId  String    @db.Uuid
  name        String
  sku         String?
  unit        String
  minStock    Decimal   @default(0) @db.Decimal(14, 3)
  notes       String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  movements InventoryMovement[]
  // FK compuesta: la sede es del MISMO tenant (SEC-004).
  location  Location            @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  // Nombre único POR SEDE y sin distinguir mayúsculas, solo entre vivos:
  // índice de EXPRESIÓN ("tenantId", "locationId", lower(name)) WHERE
  // "deletedAt" IS NULL, en 20261016130000_domain_checks (DX-042). Prisma no
  // expresa ni introspecciona índices de expresión, así que no se declara.

  // Destino de la FK compuesta de InventoryMovement.item (SEC-004).
  @@unique([tenantId, id], map: "inventory_items_tenant_id_key")
  @@index([tenantId])
  // Ya existía en SQL (20260801150000_add_locations) sin declararse aquí; se
  // declara para que migrate diff no lo vea como drift. Indexa además el lado
  // hijo de la FK compuesta (tenantId, locationId).
  @@index([tenantId, locationId])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  locationId  String                @db.Uuid
  itemId      String                @db.Uuid
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(14, 3)
  reason      String?
  occurredAt  DateTime              @default(now())
  createdById String?               @db.Uuid
  createdAt   DateTime              @default(now())

  // FK compuestas: ítem y sede son del MISMO tenant (SEC-004). Que la sede del
  // movimiento coincida con la del ítem es otra regla (SEC-014), no esta.
  item     InventoryItem @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Restrict)
  location Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, itemId])
  @@map("inventory_movements")
}

// Denylist de refresh tokens revocados por logout. Cada fila vive a lo sumo el
// TTL del refresh (JWT_REFRESH_TTL, ~30d); se limpian de forma lazy al revocar.
// Tabla global (sin RLS ni tenantId): el jti ya es único por token.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Configuración de horario de atención de una SEDE (una fila por sede).
/// Vive en su propia tabla, no como columnas de `Location`, para no tocar un
/// modelo que el trabajo multi-sede está modificando en paralelo
/// (docs/plans/2026-08-01-multi-sede.md, Fases 2-5).
model LocationSchedule {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  /// Puntero suave a `Location` (sin relación Prisma, mismo criterio que
  /// ToothRecord.sourcePlanItemId): evita añadir la back-relation al modelo
  /// Location mientras otro flujo lo edita. FK a nivel DB queda como follow-up.
  locationId String    @db.Uuid
  /// IANA (ej. "America/Bogota"). Los tramos son hora de PARED; las citas se
  /// guardan como instante, así que hace falta la zona para compararlos.
  timezone   String    @default("America/Bogota")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  ranges LocationScheduleRange[]

  @@unique([tenantId, locationId], map: "location_schedule_tenant_location_key")
  // Destino de la FK compuesta de LocationScheduleRange (SEC-004).
  @@unique([tenantId, id], map: "location_schedules_tenant_id_key")
  @@index([tenantId])
  @@map("location_schedules")
}

/// Un tramo de atención. Día CERRADO = sin tramos VIVOS para ese `weekday`.
/// Sede SIN configurar (sin LocationSchedule) = sin restricción.
///
/// Guardar el horario NO borra los tramos anteriores: los marca con `deletedAt`
/// y crea los nuevos. Así queda el rastro de qué horario tenía la sede en cada
/// momento — que es la pregunta que se hace al auditar una cita vieja ("¿esa
/// cita de marzo cabía en el horario que había ENTONCES?"). Toda lectura debe
/// filtrar `deletedAt: null`, incluidos los `include: { ranges: ... }`.
model LocationScheduleRange {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  scheduleId  String    @db.Uuid
  /// 0=domingo .. 6=sábado (convención de `Date.getDay()`, para no convertir).
  weekday     Int
  /// Minutos desde 00:00 (0..1440), hora de pared de la sede. endMinute > startMinute.
  startMinute Int
  endMinute   Int
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  /// `Restrict`, no `Cascade`: el padre se borra en blando, así que un borrado
  /// DURO de `location_schedules` solo puede venir de un error. Con Cascade se
  /// llevaba los tramos por delante en silencio; con Restrict la DB lo rechaza.
  /// FK compuesta (tenantId, scheduleId): el horario es del MISMO tenant (SEC-004).
  schedule LocationSchedule @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, scheduleId, weekday])
  @@map("location_schedule_ranges")
}

// DX-006: consentimientos informados.
//
// La PLANTILLA es de la clínica y se edita (cada cambio de título o texto sube
// `version`); el CONSENTIMIENTO firmado es una foto congelada: guarda el texto
// ya renderizado, las firmas y su hash, así que editar o desactivar la
// plantilla después no lo altera. Ver 20261016180000_patient_consents.
model ConsentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  title       String
  // Texto con variables {{paciente}}, {{documento}}, {{profesional}},
  // {{clinica}}, {{fecha}} y {{tratamiento}} (ver render-consent.ts).
  body        String
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  consents PatientConsent[]

  // Destino de la FK compuesta de PatientConsent (SEC-004).
  @@unique([tenantId, id], map: "consent_templates_tenant_id_key")
  @@unique([tenantId, title], map: "consent_templates_tenant_title_key")
  @@index([tenantId, active])
  @@map("consent_templates")
}

enum ConsentSignerType {
  PATIENT
  GUARDIAN
}

// Append-only e inmutable: sin columnas de edición ni `deletedAt`. Un trigger
// de la migración rechaza cualquier UPDATE, y el DELETE dentro de un contexto
// de tenant (la app); el puerto del repositorio no tiene ni update ni delete.
model PatientConsent {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  patientId             String            @db.Uuid
  templateId            String            @db.Uuid
  templateVersion       Int
  treatmentPlanId       String?           @db.Uuid
  // Foto del documento tal como se firmó.
  title                 String
  body                  String
  signerType            ConsentSignerType
  // Quien firma: el paciente o su tutor (nombre y documento en el momento de
  // la firma).
  signerName            String
  signerDocument        String?
  professionalName      String
  // PNG en base64 (sin prefijo data:). Tope: 200 KB decodificados (CHECK).
  patientSignature      String
  professionalSignature String
  // SHA-256 (hex) de texto + firmante + firmas + signedAt (consent-hash.ts).
  contentHash           String
  // Hora del servidor, nunca del cliente.
  signedAt              DateTime
  recordedById          String            @db.Uuid
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime          @default(now())

  // FK COMPUESTAS (SEC-004): paciente, plantilla y plan del MISMO tenant; el
  // plan, además, del MISMO paciente (mismo criterio que Payment).
  patient       Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  template      ConsentTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id])
  treatmentPlan TreatmentPlan?  @relation(fields: [tenantId, treatmentPlanId, patientId], references: [tenantId, id, patientId])

  @@index([tenantId, patientId, signedAt])
  @@index([tenantId, templateId])
  @@index([tenantId, treatmentPlanId, patientId])
  @@map("patient_consents")
}

// ---------------------------------------------------------------------------
// Periodontograma (DX-007). Un examen por fecha; las medidas cuelgan de él por
// (diente FDI, sitio). Convención de recesión: `recessionMm` POSITIVO = el
// margen gingival está APICAL a la unión amelocementaria (recesión visible);
// NEGATIVO = margen coronal a la UAC (agrandamiento / pseudobolsa). Así el
// nivel de inserción clínica es NIC (CAL) = sondaje + recesión, que se CALCULA
// (no se persiste). Un examen FINAL es inmutable (app: 409; base: trigger).
// ---------------------------------------------------------------------------
enum PerioExamStatus {
  DRAFT
  FINAL
}

/// Sitios de sondaje: vestibulares MB, B, DB y linguales/palatinos ML, L, DL.
enum PerioSite {
  MB
  B
  DB
  ML
  L
  DL
}

model PerioExam {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  patientId   String          @db.Uuid
  // Usuario que realiza el examen (sale del token, nunca del cuerpo).
  providerId  String          @db.Uuid
  examDate    DateTime        @db.Date
  notes       String?
  status      PerioExamStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  // Solo un DRAFT se retira (borrado blando, convención de Dentalix).
  deletedAt   DateTime?

  // FK COMPUESTA (SEC-004): el paciente es del MISMO tenant.
  patient       Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  provider      User                @relation(fields: [providerId], references: [id])
  siteMeasures  PerioSiteMeasure[]
  toothMeasures PerioToothMeasure[]

  // Destino de las FK compuestas de las medidas.
  @@unique([tenantId, id], map: "perio_exams_tenant_id_key")
  // Histórico del paciente, más reciente primero.
  @@index([tenantId, patientId, examDate(sort: Desc)])
  @@index([providerId])
  @@map("perio_exams")
}

model PerioSiteMeasure {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  examId      String    @db.Uuid
  toothFdi    Int       @db.SmallInt
  site        PerioSite
  // 0..19 mm
  probingMm   Int?      @db.SmallInt
  // -5..19 mm, positivo = recesión (ver convención arriba).
  recessionMm Int?      @db.SmallInt
  // Grado de furca 0..3.
  furcation   Int?      @db.SmallInt
  // Bitmask: BOP=1 | SUP=2 | PLAQ=4 | CALC=8.
  flags       Int       @default(0) @db.SmallInt

  exam PerioExam @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, examId, toothFdi, site], map: "perio_site_measures_exam_tooth_site_key")
  @@map("perio_site_measures")
}

model PerioToothMeasure {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  examId   String  @db.Uuid
  toothFdi Int     @db.SmallInt
  // Movilidad 0..3 (Miller).
  mobility Int?    @db.SmallInt
  // Diente omitido (ausente / no sondable): fuera de los índices.
  skipped  Boolean @default(false)

  exam PerioExam @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, examId, toothFdi], map: "perio_tooth_measures_exam_tooth_key")
  @@map("perio_tooth_measures")
}

// ---------------------------------------------------------------------------
// Recetas (DX-013). La receta EMITIDA es inmutable: guarda la foto de paciente,
// profesional, sede y medicamentos, y su SHA-256. Solo puede ANULARSE (motivo,
// autor y fecha); un trigger de la base rechaza cualquier otra modificación.
// Ver 20261016200000_prescriptions.
// ---------------------------------------------------------------------------
enum PrescriptionStatus {
  ISSUED
  VOIDED
}

// Plantilla de receta de la clínica (p. ej. «Post-exodoncia»). Editable y con
// borrado blando; la receta emitida copia los medicamentos, no la referencia.
model PrescriptionTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  notes       String?
  // Lista de medicamentos (misma forma que PrescriptionItem, sin cantidades en
  // letras): ver prescription-template.entity.ts.
  items       Json
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Único PARCIAL (solo vivas): el WHERE vive en la migración; Prisma no lo
  // expresa. NO aceptar un diff de migrate dev que lo recree sin el WHERE.
  @@unique([tenantId, name], map: "prescription_templates_tenant_name_key")
  @@index([tenantId, deletedAt])
  @@map("prescription_templates")
}

model Prescription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  locationId           String             @db.Uuid
  patientId            String             @db.Uuid
  // Quien prescribe: sale del token, nunca del cuerpo.
  professionalId       String             @db.Uuid
  country              ClinicCountry
  status               PrescriptionStatus @default(ISSUED)
  // Hora del servidor.
  issuedAt             DateTime
  // Fecha prevista de dispensación (ES) / fecha de la receta (CO).
  dispensationDate     DateTime           @db.Date
  validUntil           DateTime           @db.Date
  // Foto de los datos legales en el momento de emitir.
  patientName          String
  patientDocument      String?
  patientBirthYear     Int?
  clinicalRecordNumber String?
  professionalName     String
  professionalLicense  String
  professionalEmail    String?
  clinicName           String
  locationName         String
  locationAddress      String?
  notes                String?
  // Alerta de alergia confirmada por el profesional (y contra qué alergias).
  allergyOverride      Boolean            @default(false)
  allergyMatches       Json?
  // SHA-256 (hex) del contenido emitido (prescription-hash.ts).
  contentHash          String
  voidedAt             DateTime?
  voidedById           String?            @db.Uuid
  voidReason           String?
  createdAt            DateTime           @default(now())

  // FK COMPUESTAS (SEC-004): paciente y sede del MISMO tenant.
  patient      Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id])
  location     Location           @relation(fields: [tenantId, locationId], references: [tenantId, id])
  professional User               @relation("PrescriptionProfessional", fields: [professionalId], references: [id])
  voidedBy     User?              @relation("PrescriptionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  items        PrescriptionItem[]

  @@unique([tenantId, id], map: "prescriptions_tenant_id_key")
  // Lista del paciente, más reciente primero.
  @@index([tenantId, patientId, issuedAt(sort: Desc)])
  @@index([tenantId, locationId])
  @@index([professionalId])
  @@index([voidedById])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @db.Uuid
  prescriptionId     String  @db.Uuid
  position           Int     @db.SmallInt
  // Principio activo (DCI/DOE).
  activeIngredient   String
  brandName          String?
  concentration      String
  pharmaceuticalForm String
  route              String
  dose               String
  frequency          String
  durationDays       Int
  totalQuantity      Int
  quantityUnit       String
  // Cantidad total en letras (CO), generada por el servidor.
  quantityInWords    String
  // Nº de envases (obligatorio en ES).
  packages           Int?
  instructions       String?

  prescription Prescription @relation(fields: [tenantId, prescriptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, prescriptionId, position], map: "prescription_items_rx_position_key")
  @@map("prescription_items")
}

// DX-009: qué se hizo con un dato clínico o financiero.
enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  SIGN
  VOID
  LOGIN
  LOGIN_FAILED
  EXPORT
  PRINT
}

// DX-009: sobre qué tipo de recurso.
enum AuditResourceType {
  SESSION
  PATIENT
  MEDICAL_HISTORY
  CLINICAL_ENTRY
  ODONTOGRAM
  PERIO_EXAM
  CONSENT
  DATA_CONSENT
  PRESCRIPTION
  TREATMENT_PLAN
  TREATMENT_PLAN_ITEM
  PAYMENT
  PAYMENT_PLAN
  ACCOUNT_STATEMENT
}

/// Registro de auditoría (DX-009): quién vio o cambió qué dato clínico o
/// financiero, cuándo y desde dónde. APPEND-ONLY en la BD (trigger: ni UPDATE
/// ni DELETE ni TRUNCATE para el rol de la app) y con RLS forzada por tenant.
///
/// Sin FKs a propósito: es evidencia y no puede bloquear ni seguir en cascada
/// el borrado de lo que referencia (usuario, paciente, sede). Los ids se
/// resuelven bajo RLS al escribir, así que siempre son de la misma clínica.
///
/// `metadata` NUNCA lleva contenido clínico: solo ids, nombres de campos y
/// códigos (lo garantiza `sanitizeAuditMetadata`). Retención: no se borra; se
/// conserva con la historia clínica.
model AuditEvent {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  // Sede activa de la petición (X-Location-Id); NULL = vista consolidada.
  locationId   String?           @db.Uuid
  // NULL solo en LOGIN_FAILED con un email que no es de esta clínica.
  actorUserId  String?           @db.Uuid
  actorRole    ClinicRole?
  action       AuditAction
  resourceType AuditResourceType
  resourceId   String?           @db.Uuid
  patientId    String?           @db.Uuid
  // X-Request-Id de la petición (DX-023): enlaza el evento con su línea de log.
  requestId    String?
  ip           String?
  userAgent    String?
  occurredAt   DateTime          @default(now())
  metadata     Json              @default("{}")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, patientId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
  @@map("audit_events")
}
