/// triggers `expense_payments_guard` / `expense_payments_server_created_at` y el
/// único parcial expense_payments_tenant_idempotency_key UNIQUE ("tenantId",
/// "idempotencyKey") WHERE "idempotencyKey" IS NOT NULL.
model ExpensePayment {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @db.Uuid
  expenseId              String        @db.Uuid
  /// La del gasto (FK compuesta).
  locationId             String        @db.Uuid
  amount                 Decimal       @db.Decimal(14, 2)
  /// La del gasto (FK compuesta).
  currency               String
  method                 PaymentMethod
  paidOn                 DateTime      @db.Date
  cashSessionId          String?       @db.Uuid
  /// Puntero suave a User, como `Payment.createdById`.
  createdById            String        @db.Uuid
  /// La pone el servidor de BD (trigger), en UTC.
  createdAt              DateTime      @default(now())
  voidedAt               DateTime?
  voidedById             String?       @db.Uuid
  voidReason             String?
  /// Idempotency-Key (UUID) de `POST /expenses/:id/payments` y huella. Único
