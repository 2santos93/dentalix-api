  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  location    Location         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, map: "expenses_location_fkey")
  currencyRef Currency         @relation(fields: [currency], references: [code], map: "expenses_currency_fkey")
