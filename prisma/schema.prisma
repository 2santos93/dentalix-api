/// DX-279: política de cancelación de una sede, APPEND-ONLY: editarla crea la
/// versión siguiente (trigger cancellation_policy_versions_immutable y sin
/// UPDATE/DELETE para la app). La vigente es la de mayor `version`. Horas de
/// aviso 0–168, importe sugerido ≥ 0 con su moneda (los dos o ninguno) y el
/// texto para el paciente (≤ 1000). RLS FORCE por tenant.
model CancellationPolicyVersion {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @db.Uuid
  locationId         String   @db.Uuid
  version            Int
