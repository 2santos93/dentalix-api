  idempotencyFingerprint String?

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  expense         Expense                 @relation(fields: [tenantId, expenseId, locationId, currency], references: [tenantId, id, locationId, currency], onDelete: Restrict, onUpdate: Restrict, map: "expense_payments_expense_fkey")
  cashSession     CashSession?            @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict, map: "expense_payments_cash_session_fkey")
  cashAdjustments CashSessionAdjustment[]

  /// Destino de la FK de `cash_session_adjustments.expensePaymentId`.
  @@unique([tenantId, id], map: "expense_payments_tenant_id_key")
  @@index([tenantId, expenseId], map: "expense_payments_tenant_expense_idx")
  @@map("expense_payments")
