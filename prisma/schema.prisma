generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  subdomain    String             @unique
  primaryColor String             @default("#0F5E9C")
  logoUrl      String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  memberships  ClinicMembership[]

  @@map("tenants")
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  email           String             @unique
  passwordHash    String
  fullName        String
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  memberships     ClinicMembership[]

  @@map("users")
}

enum ClinicRole {
  OWNER
  DENTIST
  ASSISTANT
  RECEPTION
  ADMIN
}

model ClinicMembership {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      ClinicRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("clinic_memberships")
}

enum DocType {
  CC
  TI
  CE
  PASSPORT
  OTHER
}

enum Sex {
  M
  F
  OTHER
  UNSPECIFIED
}

model Patient {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  firstName   String
  lastName    String
  docType     DocType   @default(CC)
  docNumber   String?
  birthDate   DateTime?
  sex         Sex       @default(UNSPECIFIED)
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  medicalHistoryVersions MedicalHistoryVersion[]
  clinicalEntries        ClinicalEntry[]
  toothRecords           ToothRecord[]
  appointments           Appointment[]

  @@unique([tenantId, docNumber], map: "patients_tenant_doc_key")
  @@index([tenantId])
  @@map("patients")
}

model MedicalHistoryVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  patientId          String    @db.Uuid
  version            Int
  allergies          String?
  chronicConditions  String?
  currentMedications String?
  habits             String?
  medicalAlerts      String?
  notes              String?
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([tenantId, patientId, version], map: "mhv_tenant_patient_version_key")
  @@index([tenantId, patientId])
  @@map("medical_history_versions")
}

model ClinicalEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  patientId     String    @db.Uuid
  entryDate     DateTime
  reason        String?
  notes         String
  performedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, entryDate])
  @@map("clinical_entries")
}

enum CatalogKind {
  DIAGNOSIS
  PROCEDURE
}

model DentalCatalogItem {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  code         String
  category     String?
  kind         CatalogKind
  labelEs      String
  labelEn      String?
  labelPt      String?
  color        String
  defaultPrice Decimal?     @db.Decimal(12, 2)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, code], map: "catalog_tenant_code_key")
  @@index([tenantId])
  @@map("dental_catalog_items")
}

enum ToothSurface {
  MESIAL
  DISTAL
  OCCLUSAL
  VESTIBULAR
  LINGUAL
}

enum ToothRecordStatus {
  PLANNED
  COMPLETED
}

model ToothRecord {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid
  patientId       String              @db.Uuid
  toothNumber     String
  surfaces        ToothSurface[]
  kind            CatalogKind
  catalogItemId   String?             @db.Uuid
  status          ToothRecordStatus   @default(COMPLETED)
  notes           String?
  clinicalEntryId String?             @db.Uuid
  performedById   String?             @db.Uuid
  recordedAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  deletedAt       DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId])
  @@index([tenantId, patientId, toothNumber])
  @@map("tooth_records")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  patientId   String            @db.Uuid
  providerId  String            @db.Uuid
  start       DateTime
  end         DateTime
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, providerId, start])
  @@index([tenantId, patientId])
  @@map("appointments")
}
