DATABASE_URL="postgresql://dentalix_app:dentalix_app@localhost:5433/dentalix_test?schema=public"
# Solo para fixtures de test (cleanup en beforeAll): rol superuser que puede
# ver/borrar filas de TODOS los tenants. La app y runWithTenant SIEMPRE usan
# DATABASE_URL (rol dentalix_app, sin BYPASSRLS) para que RLS se aplique de verdad.
DATABASE_ADMIN_URL="postgresql://dentalix:dentalix@localhost:5433/dentalix_test?schema=public"
JWT_ACCESS_SECRET="test-access"
JWT_REFRESH_SECRET="test-refresh"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"
EXCHANGE_APP_ID=""
