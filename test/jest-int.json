{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".int-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "globalSetup": "<rootDir>/test/global-setup-db-guard.ts",
  "setupFiles": [
    "<rootDir>/test/setup-calendar-clock.ts",
    "<rootDir>/test/setup-int.ts"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000
}
